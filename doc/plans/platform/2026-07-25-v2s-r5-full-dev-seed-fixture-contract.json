    "databaseUrlSource": "V2S_DEV_DATABASE_URL",
    "assetRootSource": "V2S_DEV_ASSET_ROOT",
    "remoteHostSource": "V2S_DEV_REMOTE_HOST",
    "credentialSources": [
      "V2S_SEED_PLATFORM_ROOT_PASSWORD",
      "V2S_SEED_PLATFORM_SUPPORT_PASSWORD",
