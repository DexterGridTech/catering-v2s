      "V2S_SEED_OPERATIONS_DISABLED_PASSWORD",
      "V2S_SEED_OTP_FIXED_VALUE"
    ],
    "forbiddenPersistedValues": [
      "plaintext password",
      "plaintext OTP",
      "session token",
      "invitation token",
      "reset generation key",
      "remote credential"
    ],
    "middleware": {
      "postgresql": "REQUIRED_REMOTE",
      "assetStorageRoot": "REQUIRED_REMOTE_ALLOWLISTED",
      "redis": "FORBIDDEN",
      "mq": "FORBIDDEN",
      "tdp": "FORBIDDEN"
    },
    "resetAllowlist": {
      "allowlistId": "r5-dev-remote-v1",
      "remoteHost": {
        "exactValueSource": "V2S_DEV_REMOTE_HOST",
        "immutableBindingSource": "V2S_DEV_REMOTE_HOST_SHA256",
        "rule": "sha256(exactValueSource bytes) must equal immutableBindingSource before any connection or reset"
      },
      "database": {
        "urlSource": "V2S_DEV_DATABASE_URL",
        "databaseNameDerivation": "'catering_v2s_dev_' + replace('-', '_', V2S_DEV_NAMESPACE without leading 'v2s-dev-')",
        "databaseNamePattern": "^catering_v2s_dev_[a-z0-9_]{3,32}$",
        "namespaceIsolation": "ONE_DATABASE_PER_NAMESPACE",
        "fixedOwnerSchemas": ["platform_iam", "platform_workspace", "platform_asset", "organization", "extension", "workspace_iam", "contract"],
        "flywayHistorySchema": "public",
        "resetTarget": "the exact derived database, including public Flyway history and all seven fixed owner schemas",
        "forbiddenSchemas": ["information_schema", "pg_catalog"],
        "rule": "the application database URL must equal databaseNameDerivation; reset reaches remote postgres management only through the hash-bound SSH host, may drop only that exact database, and must read back its absence before start provisions it again"
      },
      "assetStorage": {
        "rootSource": "V2S_DEV_ASSET_ROOT",
        "exactSuffixDerivation": "/catering-v2s/dev/<V2S_DEV_NAMESPACE>/",
        "namespaceKeyPrefix": "<V2S_DEV_ASSET_ROOT>/catering-v2s/dev/<V2S_DEV_NAMESPACE>/"
      },
      "negativeMatrix": [
        "remote host bytes do not match V2S_DEV_REMOTE_HOST_SHA256",
        "connected database name differs from databaseNameDerivation",
        "database name does not match ^catering_v2s_dev_[a-z0-9_]{3,32}$",
        "owner schema set differs from the seven fixed schemas after migration",
        "public Flyway history is missing after rebuild",
        "asset key is outside <V2S_DEV_ASSET_ROOT>/catering-v2s/dev/<V2S_DEV_NAMESPACE>/",
        "database URL or asset root embeds a production-like environment marker"
      ]
    }
  },
  "bootstrapBoundary": {
    "directSqlAllowedOnlyFor": "first platform identity plus credential hash and bootstrap audit receipt",
    "stableLogin": "root",
    "displayName": "Root",
    "passwordSource": "V2S_SEED_PLATFORM_ROOT_PASSWORD",
    "forbidden": [
      "operations account or assignment",
      "business fact",
      "runtime auto-seed",
      "start/restart invoking seed"
    ]
  },
  "terminalFixtureBoundary": {
    "mode": "REAL_COMMANDS_OR_TERMINAL_FIXTURE",
    "privateTo": "formal r5-full seed only",
    "allowlistedKeys": ["inv-expired"],
    "activationConditions": [
      "active seed profile is exactly r5-full",
      "runtime environment marker is explicitly non-production",
      "namespace matches profile.requiredNamespacePattern",
      "target database is the exact profile.resetAllowlist.database derivation",
      "the invitation was first created through the normal owner HTTP command"
    ],
    "inv-expired": {
      "ownerCommandUnreachableReason": "Invitation expiry is a time-driven terminal state, not a user command; the owner HTTP surface intentionally has create, cancel and reissue only.",
      "precondition": "One owner-command-created PENDING invitation with one exact role and service-node intent in the exact workspace.",
      "permittedMutations": [
        "workspace_iam.invitation.status=PENDING->EXPIRED",
        "workspace_iam.invitation.created_at_epoch_millis",
        "workspace_iam.invitation.expires_at_epoch_millis",
        "workspace_iam.invitation.version",
        "one workspace_iam.audit_event with SYSTEM actor",
        "one workspace_iam.workspace_command_receipt scoped to the same workspace"
      ],
      "forbidden": [
        "any non-allowlisted fixture key",
        "new HTTP operation", "capability", "frontend control", "default profile", "production marker", "ordinary DEV namespace", "generic direct seed write"
      ],
      "readback": "existing invitation management read API must return the exact EXPIRED state and its role/node intent"
    }
  },
