  "amendmentReason": {
    "kind": "FINDING_FAMILY_ROOT_CAUSE_EXPANSION",
    "summary": "Fresh managed run r17 exposed a typed M1 bypass family and a public brand-copy structural compatibility family; the originally declared source surface did not include every owning boundary required to repair either root cause.",
    "notAdenominatorReduction": true,
    "notAStaticPassSubstitution": true,
    "dynamicEvidenceAnchor": "backend-acceptance-1786591109131-b7edd321"
  },
  "problemFamilies": [
    {
      "familyId": "BA-FAMILY-TYPED-M1-ENTRYPOINT-BYPASS",
      "status": "CONFIRMED",
      "finiteDenominator": [
        "CI-API-006-09",
        "CI-API-009-01",
        "CI-API-022-02"
      ],
      "rootCause": "Typed catalog-inventory M1 entrypoints bypass the legacy inbound-reference guard or omit the existing env-gated failure seam because the generated typed Invocation/controller path carries no testFailurePoint and does not expose the owner fact needed for the void decision.",
      "sameRootScan": [
        "TransitionOperationsCatalogItemStatusOperation",
        "StageOperationsCatalogAssetMultipartOperation",
        "ExecuteOperationsBrandCatalogCopyOperation",
        "OperationsCatalogInventoryController typed bindings",
        "backend-performance-m1-command-execution-bindings generator",
        "CatalogOwnerApi and CatalogOwnerService owner judgments",
        "CatalogInventoryCoordinator legacy fault seams and typed brand-copy composition"
      ],
      "counterexamples": [
        "Legacy catalog coordinator transition path already rechecks inbound references.",
        "Asset and owner failure seams remain env-gated and must not become unconditional production faults."
      ],
      "minimalRepairBoundary": [
        "typed invocation/controller/generator propagation of testFailurePoint",
        "narrow CatalogOwnerApi fact for inbound item reference",
        "typed operation checks before owner command, coordinator seam reuse, and closure-edge production-tag projection",
        "transactional rollback proof"
      ]
    },
    {
      "familyId": "BA-FAMILY-BRAND-COPY-PUBLIC-STRUCTURE-COMPATIBILITY",
      "status": "CONFIRMED",
      "finiteDenominator": ["CI-API-018-14"],
      "rootCause": "The public BrandCopyPreflightRequest contract intentionally accepts only selectedItemCodes, targetDataNodeRef, and dataNodeRef; the fixture/scenario attempted to add owner-controlled referenceMappings, while production-tag compatibility facts are owned by the production-tag owner and were not projected into the catalog coordinator plan.",
      "sameRootScan": [
        "BrandCopyPreflightRequest schema and controller",
        "catalog copyReferencePlan and closureEdges",
        "production-tag owner preflight compatibility",
        "FIXTURE-REFERENCE-MAPPING-MISSING fixture construction",
        "CI-API-018 scenario/oracle"
      ],
      "counterexamples": [
        "Public contract additionalProperties=false is intentional and must remain unchanged.",
        "FIXTURE-REFERENCE-MAPPING-MISSING is owner-controlled evidence for CI-API-020 and must not be moved into the public request contract."
      ],
      "minimalRepairBoundary": [
        "derive production tag source refs from catalog closureEdges for owner preflight",
        "keep owner target mapping and incompatibility decision in production-tag owner",
        "make CI-API-018-14 send only the public fields and use real production-tag mismatch fixture"
      ]
    }
  ],
