  "problemFamilyId": "CR06-FROZEN_WRITE_OPERATION_UNREACHABLE",
  "genericProblem": "A frozen write operation can exist in the owner, edge, and generated client while users have no approved UI path that invokes it, or while the edge ignores the frozen client concurrency context.",
  "rootCauseClass": "GENERATED_WRITE_CONTRACT_NOT_CONSUMED_OR_ENFORCED",
