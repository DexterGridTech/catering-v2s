  "counterexamples": [
    {"case":"existing status/invalidate commands", "evidence":"Five organization status transitions and contract invalidation already reach generated clients; the family concerns the remaining frozen write set, not all writes."},
    {"case":"read-only surfaces", "evidence":"Store profile, overview and bootstrap routes have explicit non-edit behavior and must not receive synthetic write controls."}
  ],
  "findings": [
    {"findingId":"CR06-WRITE-01", "genericProblem":"Every approved editable capability needs a generated-client consumer, capability-gated Drawer lifecycle, owner readback refresh, focused static assertion and L2 locator."},
    {"findingId":"CR06-WRITE-02", "genericProblem":"Frozen expectedContextVersion fields must be checked at the edge before every affected owner command; server-derived or null context values do not prove stale-context protection."},
    {"findingId":"CR06-WRITE-03", "genericProblem":"A generated multipart command is unreachable if the shared generated-client bridge serializes every body as JSON; the bridge must derive encoding from the generated request shape without hard-coding a feature route."}
  ],
