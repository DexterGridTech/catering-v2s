  "implementationDispositionContract": {
    "requiredPerformanceRegressions": {
      "allowed": ["REGRESSION_ADDED"],
      "requiredEvidence": ["scenarioCaseId", "historicalMetricComparisonRef", "knownCostCalibrationReceipt", "freshBeforeFailureReceipt", "freshAfterPassReceipt", "acceptedBaselineRef", "rootCauseRef", "tripleMetricClosureReceipt", "transactionBoundaryDisposition", "queryDisposition"],
      "scope": {
        "findingIds": ["BA-HIST-PERF-001", "BA-HIST-PERF-002", "BA-HIST-PERF-003", "BA-HIST-PERF-004", "BA-HIST-PERF-005", "BA-HIST-PERF-006"],
        "dbcrPackageRemains": "TERMINATED_BY_DEXTER_SCOPE_REFRAME",
        "mustNotExpandToOtherFindings": true
      },
      "closureCriterion": {
        "mode": "PER_CALL_ALL_METRICS_AT_OR_BELOW_DBCR_PRE_BASELINE",
        "requiredMetrics": ["QUERY", "CONNECTION", "TRANSACTION"],
        "ceilingSource": "requiredPerformanceRegressions[].perCallBefore",
        "equivalentFixtureAndCallSemanticsRequired": true,
        "allRequired": true,
        "updateIsNotAClosureMetric": true,
        "connectionOnlyClosureForbidden": true
      },
      "transactionBoundaryDispositionContract": {
        "allowed": ["TRANSACTION_BOUNDARY_NOT_RESTORED", "READ_ONLY_TRANSACTION_RESTORED_FOR_CONNECTION_ECONOMY"],
        "restorationDoesNotCloseFindingByItself": true,
        "allowedRestorationReason": "CONNECTION_ECONOMY_ONLY",
        "forbiddenRestorationReasons": ["STABLE_MULTI_QUERY_SNAPSHOT_UNDER_DEFAULT_READ_COMMITTED", "READ_CONSISTENCY_UNDER_DEFAULT_READ_COMMITTED"]
      },
      "queryDispositionContract": {
        "allowedValuePattern": "^(QUERY_REDUCED_TO_[0-9]+(?:\\.[0-9]+)?|QUERY_ALREADY_MINIMAL)$",
        "QUERY_REDUCED_TO_<n>": {
          "requiredEvidence": ["freshQueriesPerCall", "mergeMethod", "owningSource"],
          "valueRule": "n must equal freshQueriesPerCall and freshQueriesPerCall must be below the row perCallBefore.QUERY ceiling"
        },
        "QUERY_ALREADY_MINIMAL": {
          "requiredEvidence": ["freshQueriesPerCall", "queryNecessityByStatement", "owningSource"],
          "valueRule": "queryNecessityByStatement must account for every fresh counted QUERY and bind each query purpose to an owning source"
        }
      },
      "fixDirectionNote": "For these six findings only, prefer reducing QUERY first; the healthy direction is one transaction, one connection and minimal QUERY per read. This is a direction, not an extra hard numeric gate: an owning-source constraint may be recorded and accepted. Restoring a read-only transaction is allowed only for connection economy and never as a stable-snapshot claim under default READ COMMITTED."
    },
    "historicalHttpFailureFamilies": {
      "allowed": ["REGRESSION_ADDED", "ALREADY_COVERED_WITH_FRESH_ROUTE_PROOF", "SEED_CLIENT_OR_FIXTURE_ONLY_WITH_ROUTE_PROOF"],
      "requiredCommonEvidence": ["operationId", "scenarioCaseId", "currentContractOracleReceipt", "businessOracleReceipt", "cleanupReceipt", "rootCauseRef"],
      "regressionAddedExtraEvidence": ["preByteHash", "postByteHash", "sameFixtureDigest", "preFailureReceipt", "postPassReceipt"],
      "seedOnlyExtraEvidence": ["seedOrFixtureOwningSource", "routeBehaviorUnaffectedProof"]
    },
