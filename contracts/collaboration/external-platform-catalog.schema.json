{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catering-v2s.local/contracts/collaboration/external-platform-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "externalSystems", "providerProfiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "externalSystems": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/externalSystem" } },
    "providerProfiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/providerProfile" } }
  },
  "$defs": {
    "capabilityClass": {
      "type": "string",
      "enum": ["MASTER_DATA_SYNC", "MEMBER_BENEFIT", "GROUP_BUY", "TAKEAWAY", "INVENTORY_SYNC", "TAKEAWAY_DELIVERY", "ORDER_SYNC"]
    },
    "nodeType": {
      "type": "string",
      "enum": ["COMMERCIAL_GROUP", "REGION", "PROJECT", "HEAD_COMPANY", "STORE"]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityClass", "displayName", "attributeValues"],
      "properties": {
        "capabilityClass": { "$ref": "#/$defs/capabilityClass" },
        "displayName": { "type": "string", "minLength": 1 },
        "attributeValues": { "$ref": "#/$defs/attributeValues" }
      }
    },
    "attributeValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupBuyMappingDirection": { "type": "string", "enum": ["EXTERNAL_TO_INTERNAL", "INTERNAL_TO_EXTERNAL"] },
        "menuCollaborationDirection": { "type": "string", "enum": ["PULL_ONLY"] }
      }
    },
    "externalSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalSystemCode", "displayName", "catalogStatus", "capabilities"],
      "properties": {
        "externalSystemCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "catalogStatus": { "type": "string", "enum": ["PLANNED", "AVAILABLE"] },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } }
      }
    },
    "providerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerCode", "displayName", "externalSystemCode", "businessScope", "bindableNodeTypes", "authenticationKind", "unbindKind", "catalogStatus"],
      "properties": {
        "providerCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "externalSystemCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "businessScope": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capabilityClass" } },
        "bindableNodeTypes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nodeType" } },
        "authenticationKind": { "type": "string", "enum": ["EXTERNAL_GRANT", "INTERNAL_MAPPING", "NO_MAPPING"] },
        "unbindKind": { "type": "string", "enum": ["LOCAL_ONLY", "REQUIRES_ADAPTER_UNBIND"] },
        "catalogStatus": { "type": "string", "enum": ["PLANNED", "AVAILABLE"] }
      }
    }
  }
}
