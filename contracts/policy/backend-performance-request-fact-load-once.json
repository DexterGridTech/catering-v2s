{
  "schemaVersion": 1,
  "kind": "backend-performance-request-fact-load-once",
  "status": "ACTIVE_STATIC_RUNTIME_ADMISSION",
  "authority": "BPF-U03 owns source caller admission and the HMAC-validated immutable request snapshot; static checks do not claim runtime at-most-once.",
  "denominator": {
    "operations": 196,
    "loaders": 10,
    "m1Operations": 68
  },
  "staticAdmission": {
    "sourceInventory": "contracts/registry/backend-performance-operation-source-inventory.json",
    "loaderCatalogue": "contracts/registry/backend-performance-fact-loader-catalog.json",
    "callerRule": "allowedCallerPaths is the exact source-scanned caller set; loader source definitions are not counted as callers",
    "operationRule": "each operation has a unique factLoaderRefs loaderId set and every digest matches the closed loader catalogue",
    "runtimeClaim": "STATIC_SOURCE_CLOSURE_ONLY"
  },
  "runtimeSnapshot": {
    "eventKind": "FACT_LOADED",
    "requiredFields": [
      "runId",
      "correlationId",
      "requestId",
      "operationId",
      "loaderId",
      "callSitePrefix",
      "seq",
      "factLoadHmac"
    ],
    "duplicateTuple": ["runId", "correlationId", "requestId", "loaderId", "callSitePrefix"],
    "hmac": {
      "algorithm": "HmacSHA256",
      "keyEnvironment": "V2S_DB_OPERATIONS_HMAC_KEY",
      "keyEncoding": "BASE64URL",
      "field": "factLoadHmac",
      "canonicalTuple": ["runId", "correlationId", "requestId", "operationId", "loaderId", "callSitePrefix", "seq"]
    },
    "expectedAttribution": "operationId.factLoaderRefs"
  },
  "redMutations": [
    "BPF-U03-RED:UNLISTED_FACT_LOADER_CALLER",
    "BPF-U03-RED:FACT_LOADER_DUPLICATE",
    "BPF-U03-RED:FACT_LOADER_UNKNOWN_ATTRIBUTION",
    "BPF-U03-RED:FACT_LOADER_MISSING_ATTRIBUTION",
    "BPF-U03-RED:FACT_LOADER_HMAC_INVALID"
  ]
}
