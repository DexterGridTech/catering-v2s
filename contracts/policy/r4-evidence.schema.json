{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R4 closure readiness evidence",
  "type": "object",
  "required": ["kind", "roadmapStep", "sourceHashes", "l1", "l2", "l3", "business", "cleanup", "redFixtures", "deferredRefs"],
  "properties": {
    "kind": {"const": "r4-closure-readiness-evidence"},
    "roadmapStep": {"const": "R4"},
    "sourceHashes": {"type": "object", "minProperties": 1},
    "l1": {"type": "object", "required": ["status", "commands"]},
    "l2": {"type": "object", "required": ["status", "commands"]},
    "l3": {"type": "object", "required": ["status", "selection"]},
    "business": {"type": "object", "required": ["status", "reason"]},
    "cleanup": {"type": "object", "required": ["status", "activeManagedResources"]},
    "redFixtures": {"type": "array", "minItems": 1},
    "deferredRefs": {"type": "array"}
  }
}
