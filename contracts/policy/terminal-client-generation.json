{
  "schemaVersion": 1,
  "kind": "terminal-client-generation-policy",
  "face": "terminal",
  "operationCatalog": "doc/plans/platform/2026-07-25-v2s-r5-edge-contract-implementation-catalog.json",
  "openApiPathsRoot": "contracts/openapi/paths",
  "canonicalSchemas": [
    "contracts/openapi-source/terminal-binding.schemas.json",
    "contracts/openapi-source/terminal-data-read.schemas.json",
    "contracts/openapi/components/organization/store.schemas.json",
    "contracts/openapi/components/organization/store-operating-rule-schemas.generated.json",
    "contracts/openapi/components/contract/contract.schemas.json",
    "contracts/openapi/components/organization/store-service-point-qr.schemas.json",
    "contracts/openapi-source/terminal-update.schemas.json",
    "contracts/openapi-source/terminal-remote-control.schemas.json"
  ],
  "targets": [
    {
      "targetPackage": "apps/terminal/kernel/base/terminal-data-client",
      "tags": ["terminal-binding"],
      "includeOperationIds": [
        "activateTerminal",
        "cancelTerminalActivation"
      ],
      "excludeOperationIds": ["downloadTerminalUpdateArtifact"],
      "stripPathPrefix": "/api/terminal/group-workspaces/{groupWorkspaceKey}",
      "output": "apps/terminal/kernel/base/terminal-data-client/src/generated/terminalApi.ts"
    },
    {
      "targetPackage": "apps/terminal/kernel/feature/store-basic",
      "tags": ["organization", "store-contract"],
      "includeOperationIds": [
        "terminalReadStoreBasic",
        "terminalReadStoreActiveContracts",
        "terminalReadContract",
        "terminalReadStoreServicePointAreas",
        "terminalReadServicePointArea",
        "terminalReadStoreServicePoints",
        "terminalReadServicePoint"
      ],
      "excludeOperationIds": [],
      "stripPathPrefix": "/api/terminal/group-workspaces/{groupWorkspaceKey}",
      "output": "apps/terminal/kernel/feature/store-basic/src/generated/terminalApi.ts"
    },
    {
      "targetPackage": "apps/terminal/kernel/feature/project-basic",
      "tags": ["organization", "TERMINAL_UPDATE_RULE"],
      "includeOperationIds": [
        "terminalReadStoreOrganizationPath",
        "terminalReadProjectUpdateRuleSnapshotPage"
      ],
      "excludeOperationIds": [],
      "stripPathPrefix": "/api/terminal/group-workspaces/{groupWorkspaceKey}",
      "output": "apps/terminal/kernel/feature/project-basic/src/generated/terminalApi.ts"
    },
    {
      "targetPackage": "apps/terminal/kernel/base/terminal-update",
      "tags": ["TERMINAL_UPDATE_RULE", "TERMINAL_UPDATE_REPORT"],
      "includeOperationIds": [
        "issueTerminalUpdateArtifactDownloadGrant",
        "submitTerminalUpdateReport"
      ],
      "excludeOperationIds": [],
      "stripPathPrefix": "/api/terminal/group-workspaces/{groupWorkspaceKey}",
      "output": "apps/terminal/kernel/base/terminal-update/src/generated/terminalApi.ts"
    },
    {
      "targetPackage": "apps/terminal/kernel/base/remote-control",
      "tags": ["remote-control", "TERMINAL_REMOTE_CONTROL"],
      "includeOperationIds": [
        "registerTerminalRemoteControl",
        "reportTerminalRemoteControl"
      ],
      "excludeOperationIds": [],
      "stripPathPrefix": "/api/terminal/group-workspaces/{groupWorkspaceKey}",
      "output": "apps/terminal/kernel/base/remote-control/src/generated/terminalApi.ts"
    }
  ]
}
