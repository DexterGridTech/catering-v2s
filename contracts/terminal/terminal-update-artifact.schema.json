{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catering-v2s.invalid/contracts/terminal/terminal-update-artifact.schema.json",
  "title": "TER terminal update artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "applicationId",
    "nativeVersion",
    "nativeBuildNumber",
    "bundleVersion",
    "runtimeVersion",
    "entry",
    "files",
    "publicationId"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "platform": {"const": "android"},
    "applicationId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"},
    "nativeVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "nativeBuildNumber": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "bundleVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "runtimeVersion": {"type": "string", "minLength": 1, "maxLength": 128},
    "entry": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "publicationId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "minimumFull": {"$ref": "#/$defs/minimumFull"},
    "apk": {"$ref": "#/$defs/apk"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sizeBytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "minimumFull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationId", "nativeBuildNumber", "runtimeVersion", "publicationId", "apkSha256"],
      "properties": {
        "applicationId": {"type": "string"},
        "nativeBuildNumber": {"type": "integer", "minimum": 1},
        "runtimeVersion": {"type": "string", "minLength": 1},
        "publicationId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "apkSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "apk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "certificateSha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "certificateSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
