          "applicationId": {"type": "string"},
          "nativeBuildNumber": {"type": "integer", "minimum": 1},
          "runtimeVersion": {"type": "string", "minLength": 1},
          "publicationId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "apkSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      },
      "TerminalUpdateApkFacts": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "certificateSha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "certificateSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      },
      "TerminalUpdateBinaryContent": {
        "type": "string",
        "format": "binary"
      },
      "TerminalUpdateReportActual": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apkVersion",
          "nativeBuildNumber",
          "applicationId",
          "runtimeVersion",
          "jsVersion",
          "publicationId",
          "apkSha256",
          "bundleSha256",
