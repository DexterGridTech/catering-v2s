{
  "components": {
    "schemas": {
      "TerminalUpdateArtifactStageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256", "usage"],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "usage": {
            "type": "string",
            "enum": ["TERMINAL_UPDATE_ARTIFACT"]
          }
        }
      },
      "TerminalUpdateStageResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stageRef", "stageBindGrant", "expiresAtEpochMillis", "fileName", "sha256", "byteSize",
          "candidateKind", "applicationId", "platform", "nativeVersion", "nativeBuildNumber", "bundleVersion",
          "runtimeVersion", "publicationId", "apkSha256", "minimumFull"],
        "properties": {
          "stageRef": {
            "type": "string",
            "format": "uuid"
          },
          "stageBindGrant": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "expiresAtEpochMillis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteSize": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "candidateKind": {"type": "string", "enum": ["FULL", "HOT"]},
          "applicationId": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "enum": ["android"]},
          "nativeVersion": {"type": "string", "minLength": 1},
          "nativeBuildNumber": {"type": "integer", "minimum": 1},
          "bundleVersion": {"type": "string", "minLength": 1},
          "runtimeVersion": {"type": "string", "minLength": 1},
          "publicationId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "apkSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "nullable": true},
          "minimumFull": {"allOf": [{"ref": "TerminalUpdateMinimumFull"}], "nullable": true}
        }
      },
      "TerminalUpdateArtifactRegisterRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stageRef", "stageBindGrant", "kind"],
        "properties": {
          "stageRef": {
            "type": "string",
            "format": "uuid"
          },
          "stageBindGrant": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "enum": ["FULL", "HOT"]
          },
          "minimumFullArtifactRef": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TerminalUpdateArtifactPageQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["FULL", "HOT"]
          },
          "appId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "runtimeVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "queryText": {
            "type": "string",
            "maxLength": 120
          },
          "minimumFullNativeBuildNumber": {
            "type": "integer",
            "minimum": 0
          },
          "minimumFullPublicationId": {
            "type": "string",
            "maxLength": 128
          },
          "minimumFullApkSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "TerminalUpdateArtifactSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactRef",
          "kind",
          "applicationId",
          "runtimeVersion",
          "nativeBuildNumber",
          "apkVersion",
          "jsVersion",
          "publicationId",
          "apkSha256",
          "zipSha256",
          "byteSize",
          "createdAtEpochMillis"
        ],
        "properties": {
          "artifactRef": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": ["FULL", "HOT"]
          },
          "applicationId": {
            "type": "string"
          },
          "runtimeVersion": {
            "type": "string"
          },
          "nativeBuildNumber": {
            "type": "integer",
            "minimum": 0
          },
          "apkVersion": {
            "type": "string"
          },
          "jsVersion": {
            "type": "string"
          },
          "publicationId": {
            "type": "string"
          },
          "apkSha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "zipSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteSize": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "createdAtEpochMillis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "TerminalUpdateArtifactPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "ref": "TerminalUpdateArtifactSummary"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "TerminalUpdateArtifactDetail": {
        "allOf": [
          {
            "ref": "TerminalUpdateArtifactSummary"
          }
        ],
        "type": "object",
        "additionalProperties": false,
        "required": ["minimumFullArtifactRef", "minimumFullFacts"],
        "properties": {
          "minimumFullArtifactRef": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "minimumFullFacts": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["applicationId", "nativeBuildNumber", "runtimeVersion", "publicationId", "apkSha256"],
            "properties": {
              "applicationId": {
                "type": "string"
              },
              "runtimeVersion": {
                "type": "string"
              },
              "nativeBuildNumber": {
                "type": "integer",
                "minimum": 0
              },
              "publicationId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "apkSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      },
      "TerminalUpdateVersionPageQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedContextVersion", "limit"],
        "properties": {
          "expectedContextVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "storeRef": {
            "type": "string",
            "format": "uuid"
          },
          "queryText": {
            "type": "string",
            "maxLength": 120
          },
          "currentApkVersion": {
            "type": "string",
            "maxLength": 128
          },
          "currentJsVersion": {
            "type": "string",
            "maxLength": 128
          },
          "runtimeVersion": {
            "type": "string",
            "maxLength": 128
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "TerminalUpdateVersionReportItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "terminalRef",
          "terminalName",
          "storeRef",
          "storeName",
          "hasReport",
          "oldBinding",
          "actual",
          "recent",
          "receivedAtEpochMillis"
        ],
        "properties": {
          "terminalRef": {
            "type": "string",
            "format": "uuid"
          },
          "terminalName": {
            "type": "string"
          },
          "storeRef": {
            "type": "string",
            "format": "uuid"
          },
          "storeName": {
            "type": "string"
          },
          "hasReport": {
            "type": "boolean"
          },
          "oldBinding": {
            "type": "boolean"
          },
          "actual": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "recent": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "receivedAtEpochMillis": {
            "type": ["integer", "null"],
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "TerminalUpdateVersionPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "ref": "TerminalUpdateVersionReportItem"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "TerminalUpdateRulePageQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedContextVersion", "limit"],
        "properties": {
          "expectedContextVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": ["ENABLED", "DISABLED"]
          },
          "applicationId": {
            "type": "string",
            "maxLength": 128
          },
          "createdFromEpochMillis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "createdToEpochMillis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "TerminalUpdateRuleSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleRef",
          "projectRef",
          "status",
          "targetMode",
          "fullArtifactRef",
          "hotArtifactRef",
          "fullArtifactIdentity",
          "hotArtifactIdentity",
          "nSeconds",
          "hotStrategy",
          "mSeconds",
          "createdAtEpochMillis",
          "revision"
        ],
        "properties": {
          "ruleRef": {
            "type": "string",
            "format": "uuid"
          },
          "projectRef": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["ENABLED", "DISABLED"]
          },
          "targetMode": {
            "type": "string",
            "enum": ["ALL", "STORE_REFS"]
          },
          "fullArtifactRef": {
            "type": "string",
            "format": "uuid"
          },
          "hotArtifactRef": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "fullArtifactIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["applicationId", "kind", "version"],
            "properties": {
              "applicationId": {"type": "string", "minLength": 1, "maxLength": 255},
              "kind": {"type": "string", "enum": ["FULL", "HOT"]},
              "version": {"type": "string", "minLength": 1, "maxLength": 64}
            }
          },
          "hotArtifactIdentity": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["applicationId", "kind", "version"],
            "properties": {
              "applicationId": {"type": "string", "minLength": 1, "maxLength": 255},
              "kind": {"type": "string", "enum": ["FULL", "HOT"]},
              "version": {"type": "string", "minLength": 1, "maxLength": 64}
            }
          },
          "nSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "hotStrategy": {
            "type": "string",
            "enum": ["IMMEDIATE", "IDLE"],
            "nullable": true
          },
          "mSeconds": {
            "type": ["integer", "null"],
            "minimum": 60,
            "maximum": 86400
          },
          "description": {
            "type": ["string", "null"],
            "maxLength": 500
          },
          "createdAtEpochMillis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "TerminalUpdateRulePage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "ref": "TerminalUpdateRuleSummary"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "TerminalUpdateRuleCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetMode", "fullArtifactRef", "status", "nSeconds"],
        "properties": {
          "targetMode": {
            "type": "string",
            "enum": ["ALL", "STORE_REFS"]
          },
          "storeRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "fullArtifactRef": {
            "type": "string",
            "format": "uuid"
          },
          "hotArtifactRef": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["ENABLED", "DISABLED"]
          },
          "nSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "hotStrategy": {
            "type": "string",
            "enum": ["IMMEDIATE", "IDLE"]
          },
          "mSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "TerminalUpdateRuleStatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "status"],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": ["ENABLED", "DISABLED"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "TerminalUpdateRuleDetail": {
        "allOf": [
          {
            "ref": "TerminalUpdateRuleSummary"
          }
        ],
        "type": "object",
        "additionalProperties": false,
        "required": ["storeRefs"],
        "properties": {
          "storeRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          }
        }
      },
      "TerminalUpdateArtifactCandidateQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedContextVersion", "projectRef", "limit"],
        "properties": {
          "expectedContextVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "projectRef": {
            "type": "string",
            "format": "uuid"
          },
          "queryText": {
            "type": "string",
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": ["FULL", "HOT"]
          },
          "applicationId": {
            "type": "string",
            "maxLength": 128
          },
          "runtimeVersion": {
            "type": "string",
            "maxLength": 128
          },
          "minimumFullArtifactRef": {
            "type": "string",
            "format": "uuid"
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "TerminalUpdateArtifactCandidatePage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "ref": "TerminalUpdateArtifactSummary"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "TerminalUpdateRuleSnapshotQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cursor", "limit", "collectionHash"],
        "properties": {
          "cursor": {
            "type": ["string", "null"]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "collectionHash": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "TerminalUpdateRuleSnapshotItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleRef",
          "targetMode",
          "storeRefs",
          "applicationId",
          "createdAtEpochMillis",
          "full",
          "hot",
          "nSeconds",
          "hotStrategy",
          "mSeconds",
          "description"
        ],
        "properties": {
          "ruleRef": {
            "type": "string",
            "format": "uuid"
          },
          "targetMode": {
            "type": "string",
            "enum": ["ALL", "STORE_REFS"]
          },
          "storeRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "applicationId": {
            "type": "string"
          },
          "createdAtEpochMillis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "full": {
            "ref": "TerminalUpdateArtifactSummary"
          },
          "hot": {
            "allOf": [{"ref": "TerminalUpdateArtifactSummary"}],
            "nullable": true
          },
          "nSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "hotStrategy": {
            "type": "string",
            "enum": ["IMMEDIATE", "IDLE"],
            "nullable": true
          },
          "mSeconds": {
            "type": ["integer", "null"],
            "minimum": 60,
            "maximum": 86400
          },
          "description": {
            "type": ["string", "null"],
            "maxLength": 500
          }
        }
      },
      "TerminalUpdateRuleSnapshotPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "collectionHash", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "ref": "TerminalUpdateRuleSnapshotItem"
            }
          },
          "collectionHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "TerminalUpdateDownloadGrantResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relativeContentPath",
          "grant",
          "expiresAtEpochMillis",
          "artifactRef",
          "zipSha256",
          "byteSize",
