      "TerminalUpdateArtifactManifest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "platform",
          "applicationId",
          "nativeVersion",
          "nativeBuildNumber",
          "bundleVersion",
          "runtimeVersion",
          "entry",
          "files",
          "publicationId",
          "minimumFull",
          "apk"
        ],
        "properties": {
          "schemaVersion": {"type": "integer", "enum": [1]},
          "platform": {"type": "string", "enum": ["android"]},
          "applicationId": {"type": "string", "minLength": 1},
          "nativeVersion": {"type": "string", "minLength": 1},
          "nativeBuildNumber": {"type": "integer", "minimum": 1},
          "bundleVersion": {"type": "string", "minLength": 1},
          "runtimeVersion": {"type": "string", "minLength": 1},
          "entry": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"$ref": "#/components/schemas/TerminalUpdateArtifactFile"}},
          "publicationId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "minimumFull": {"allOf": [{"ref": "TerminalUpdateMinimumFull"}], "nullable": true},
          "apk": {"allOf": [{"ref": "TerminalUpdateApkFacts"}], "nullable": true}
        }
      },
      "TerminalUpdateArtifactFile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sizeBytes", "sha256"],
