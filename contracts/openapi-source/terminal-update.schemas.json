        "properties": {
          "apkVersion": {
            "type": ["string", "null"]
          },
          "nativeBuildNumber": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "applicationId": {
            "type": "string"
          },
          "runtimeVersion": {
            "type": "string"
          },
          "jsVersion": {
            "type": ["string", "null"]
          },
          "publicationId": {
            "type": ["string", "null"]
          },
          "apkSha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "bundleSha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "entryKind": {
            "type": "string",
            "enum": ["INSTALLED_APK", "EMBEDDED_BUNDLE", "HOT_BUNDLE", "UNKNOWN"]
          },
          "unknownReason": {
            "type": ["string", "null"],
            "enum": ["READBACK_UNAVAILABLE", "NOT_INSTALLED", "MISMATCH", "OTHER", null]
          }
        }
      },
      "TerminalUpdateReportRecent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "reason", "changedAtEpochMillis", "ruleRef", "fullArtifactRef", "hotArtifactRef"],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "WAITING_USER",
              "DOWNLOADING",
              "VERIFYING",
              "WAITING_IDLE",
              "INSTALLING",
              "APPLYING_HOT",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "UNKNOWN"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "NONE",
              "NETWORK",
              "HTTP_REJECTED",
              "HASH_MISMATCH",
              "PREPARE_FAILED",
              "INSTALLER_CANCELLED",
              "INSTALL_FAILED",
              "HOT_APPLY_FAILED",
              "UNKNOWN"
            ]
          },
          "changedAtEpochMillis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "ruleRef": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "fullArtifactRef": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "hotArtifactRef": {
            "type": ["string", "null"],
            "format": "uuid"
          }
        }
      },
      "TerminalUpdateReportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reportId", "reportSequence", "taskId", "actual", "recent"],
        "properties": {
          "reportId": {
            "type": "string",
            "format": "uuid"
          },
          "reportSequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "taskId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "actual": {
            "ref": "TerminalUpdateReportActual"
          },
          "recent": {
            "ref": "TerminalUpdateReportRecent"
          }
        }
      },
      "TerminalUpdateReportReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reportId", "taskId", "acceptedSequence", "outcome"],
        "properties": {
          "reportId": {
            "type": "string",
            "format": "uuid"
          },
          "taskId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "acceptedSequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "outcome": {
            "type": "string",
            "enum": ["ACCEPTED", "SUPERSEDED"]
          }
        }
      },
      "TerminalUpdateReportArtifactIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicationId", "kind", "version"],
        "properties": {
          "applicationId": {"type": "string", "minLength": 1, "maxLength": 255},
          "kind": {"type": "string", "enum": ["FULL", "HOT"]},
          "version": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      },
      "TerminalUpdateReportRuleTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fullArtifactIdentity", "hotArtifactIdentity"],
        "properties": {
          "fullArtifactIdentity": {"ref": "TerminalUpdateReportArtifactIdentity"},
          "hotArtifactIdentity": {
            "allOf": [{"ref": "TerminalUpdateReportArtifactIdentity"}],
            "nullable": true
          }
        }
      },
      "TerminalUpdateReportReferences": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleTarget", "fullArtifactIdentity", "hotArtifactIdentity"],
        "properties": {
          "ruleTarget": {"allOf": [{"ref": "TerminalUpdateReportRuleTarget"}], "nullable": true},
          "fullArtifactIdentity": {
            "allOf": [{"ref": "TerminalUpdateReportArtifactIdentity"}],
            "nullable": true
          },
          "hotArtifactIdentity": {
            "allOf": [{"ref": "TerminalUpdateReportArtifactIdentity"}],
            "nullable": true
          }
        }
      },
      "TerminalUpdateVersionDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "terminalRef",
          "terminalName",
          "storeRef",
          "storeName",
          "hasReport",
          "latest",
          "latestReferences",
          "historyCursor",
          "receivedAtEpochMillis"
        ],
        "properties": {
          "terminalRef": {
            "type": "string",
            "format": "uuid"
          },
          "terminalName": {
            "type": "string"
          },
          "storeRef": {
            "type": "string",
            "format": "uuid"
          },
          "storeName": {
            "type": "string"
          },
          "hasReport": {
            "type": "boolean"
          },
          "latest": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "latestReferences": {
            "allOf": [{"ref": "TerminalUpdateReportReferences"}],
            "nullable": true
          },
          "historyCursor": {
            "type": ["string", "null"]
          },
          "receivedAtEpochMillis": {
            "type": ["integer", "null"],
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "TerminalUpdateReportHistoryQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedContextVersion", "limit"],
        "properties": {
          "expectedContextVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "TerminalUpdateReportHistoryPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reportId", "taskId", "reportSequence", "actual", "recent", "references", "receivedAtEpochMillis"],
              "properties": {
                "reportId": {
                  "type": "string",
                  "format": "uuid"
                },
                "taskId": {
                  "type": ["string", "null"],
                  "format": "uuid"
                },
                "reportSequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "actual": {
                  "ref": "TerminalUpdateReportActual"
                },
                "recent": {
                  "ref": "TerminalUpdateReportRecent"
                },
                "references": {
                  "ref": "TerminalUpdateReportReferences"
                },
                "receivedAtEpochMillis": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                }
              }
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "TerminalUpdateRuleStorePage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["storeRef", "name", "code", "status", "unknownReason"],
              "properties": {
                "storeRef": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": ["string", "null"]
                },
                "code": {
                  "type": ["string", "null"]
                },
                "status": {
                  "type": "string",
                  "enum": ["ENABLED", "DISABLED", "VOIDED", "UNKNOWN"]
                },
                "unknownReason": {
                  "type": ["string", "null"],
                  "enum": ["MISSING_OR_OUT_OF_PROJECT", null]
                }
              }
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
