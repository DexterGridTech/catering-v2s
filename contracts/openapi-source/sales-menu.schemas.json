{
  "components": {
    "schemas": {
      "SalesMenuSchedule": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "startLocalTime", "endLocalTime"],
        "properties": {
          "kind": {"type": "string", "enum": ["ALL_DAY", "DAILY_TIME_RANGE"]},
          "startLocalTime": {"type": "string", "nullable": true, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
          "endLocalTime": {"type": "string", "nullable": true, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}
        }
      },
      "SalesMenuActivation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channelRef", "status", "version"],
        "properties": {
          "channelRef": {"type": "string", "format": "uuid"},
          "status": {"type": "string", "enum": ["ENABLED", "DISABLED"]},
          "version": {"type": "integer", "format": "int64", "minimum": 0}
        }
      },
      "SalesMenuSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["salesMenuRef", "storeRef", "name", "archived", "version", "draftRevision", "latestPublishedRevision", "draftDirty", "activation", "draftSchedule"],
        "properties": {
          "salesMenuRef": {"type": "string", "format": "uuid"},
          "storeRef": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 160},
          "archived": {"type": "boolean"},
          "version": {"type": "integer", "format": "int64", "minimum": 0},
          "draftRevision": {"type": "integer", "format": "int64", "minimum": 0},
          "latestPublishedRevision": {"type": "integer", "format": "int64", "minimum": 0, "nullable": true},
          "draftDirty": {"type": "boolean"},
          "activation": {"$ref": "#/components/schemas/SalesMenuActivation", "nullable": true},
          "draftSchedule": {"$ref": "#/components/schemas/SalesMenuSchedule"}
        }
      },
      "SalesMenuPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "cursor", "nextCursor"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuSummary"}},
          "cursor": {"type": "string", "maxLength": 512, "nullable": true},
          "nextCursor": {"type": "string", "maxLength": 512, "nullable": true}
        }
      },
      "SalesMenuDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["salesMenuRef", "groupWorkspaceKey", "storeRef", "name", "archived", "version", "draftRevision", "latestPublishedRevision", "draftDirty", "activation", "draftSchedule", "latestPublishedSchedule"],
        "properties": {
          "salesMenuRef": {"type": "string", "format": "uuid"},
          "groupWorkspaceKey": {"type": "string", "minLength": 1, "maxLength": 128},
          "storeRef": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 160},
          "archived": {"type": "boolean"},
          "version": {"type": "integer", "format": "int64", "minimum": 0},
          "draftRevision": {"type": "integer", "format": "int64", "minimum": 0},
          "latestPublishedRevision": {"type": "integer", "format": "int64", "minimum": 0, "nullable": true},
          "draftDirty": {"type": "boolean"},
          "activation": {"$ref": "#/components/schemas/SalesMenuActivation", "nullable": true},
          "draftSchedule": {"$ref": "#/components/schemas/SalesMenuSchedule"},
          "latestPublishedSchedule": {"$ref": "#/components/schemas/SalesMenuSchedule", "nullable": true}
        }
      },
      "SalesMenuSectionView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["salesSectionRef", "name", "displayOrder", "itemCount", "canMoveUp", "canMoveDown"],
        "properties": {
          "salesSectionRef": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 160},
          "displayOrder": {"type": "integer", "minimum": 0},
          "itemCount": {"type": "integer", "minimum": 0},
          "canMoveUp": {"type": "boolean"},
          "canMoveDown": {"type": "boolean"}
        }
      },
      "SalesMenuSectionList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuSectionView"}}}
      },
      "SalesMenuSkuPrice": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skuRef", "skuName", "skuCode", "standardPriceCents", "listedPriceCents"],
        "properties": {
          "skuRef": {"type": "string", "format": "uuid"},
          "skuName": {"type": "string", "minLength": 1, "maxLength": 160},
          "skuCode": {"type": "string", "minLength": 1, "maxLength": 160},
          "standardPriceCents": {"type": "integer", "minimum": 0},
          "listedPriceCents": {"type": "integer", "minimum": 0}
        }
      },
      "SalesMenuSalesUnit": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitRef", "code", "name", "unitDimension", "precision"],
        "properties": {
          "unitRef": {"type": "string", "format": "uuid", "description": "Catalog sales-unit definition reference"},
          "code": {"type": "string", "minLength": 1, "maxLength": 160, "description": "Catalog unit code"},
          "name": {"type": "string", "minLength": 1, "maxLength": 160, "description": "Catalog unit name"},
          "unitDimension": {
            "type": "string",
            "enum": ["COUNT", "WEIGHT", "VOLUME", "SERVICE_DURATION", "PACKAGE"],
            "description": "Catalog unit dimension"
          },
          "precision": {"type": "integer", "minimum": 0, "description": "Catalog decimal precision; zero means whole numbers"}
        }
      },
      "SalesMenuSaleContentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "listedPriceCents", "skuPrices", "orderOptionSelections"],
        "properties": {
          "kind": {"type": "string", "enum": ["DIRECT", "SKU_SELECTION", "WEIGHTED", "COMPOSITE"]},
          "listedPriceCents": {"type": "integer", "minimum": 0, "nullable": true},
          "skuPrices": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuSkuPrice"}},
          "orderOptionSelections": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuOrderOptionSelectionInput"}}
        },
        "description": "Client-editable sale definition. The sales unit is owned by Catalog and is not writable here."
      },
      "SalesMenuSaleContent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "listedPriceCents", "skuPrices", "selectedOrderOptions", "salesUnit"],
        "properties": {
          "kind": {"type": "string", "enum": ["DIRECT", "SKU_SELECTION", "WEIGHTED", "COMPOSITE"]},
          "listedPriceCents": {"type": "integer", "minimum": 0, "nullable": true},
          "skuPrices": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuSkuPrice"}},
          "selectedOrderOptions": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuOrderOption"}},
          "salesUnit": {"$ref": "#/components/schemas/SalesMenuSalesUnit", "nullable": true}
        }
      },
      "SalesMenuOrderingConstraints": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minItemQuantity", "quantityStep"],
        "properties": {
          "minItemQuantity": {"type": "integer", "minimum": 1, "nullable": true},
          "quantityStep": {"type": "integer", "minimum": 1, "nullable": true}
        }
      },
      "SalesMenuDisplayMedia": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "assetRefs", "primaryAssetRef"],
        "properties": {
          "mode": {"type": "string", "enum": ["INHERIT_CATALOG", "CUSTOM"]},
          "assetRefs": {"type": "array", "maxItems": 6, "items": {"type": "string", "format": "uuid"}},
          "primaryAssetRef": {"type": "string", "format": "uuid", "nullable": true}
        }
      },
      "SalesMenuOrderOptionValue": {
        "type": "object",
        "additionalProperties": false,
        "required": ["definitionValueRef", "name", "displayOrder", "defaultValue", "extraPrice"],
        "properties": {
          "definitionValueRef": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 160},
          "displayOrder": {"type": "integer", "minimum": 0},
          "defaultValue": {"type": "boolean"},
          "extraPrice": {"type": "integer", "minimum": 0, "nullable": true}
        }
      },
      "SalesMenuOrderOption": {
        "type": "object",
        "additionalProperties": false,
        "required": ["definitionRef", "name", "selectionMode", "displayOrder", "required", "minSelectionCount", "maxSelectionCount", "values"],
        "properties": {
          "definitionRef": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 160},
          "selectionMode": {"type": "string", "enum": ["SINGLE", "MULTIPLE"]},
          "displayOrder": {"type": "integer", "minimum": 0},
          "required": {"type": "boolean"},
          "minSelectionCount": {"type": "integer", "minimum": 0, "nullable": true},
          "maxSelectionCount": {"type": "integer", "minimum": 0, "nullable": true},
          "values": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuOrderOptionValue"}}
        }
      },
      "SalesMenuOrderOptionSelectionInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["definitionRef", "selectedValueRefs"],
        "properties": {
          "definitionRef": {"type": "string", "format": "uuid"},
          "selectedValueRefs": {"type": "array", "items": {"type": "string", "format": "uuid"}}
        }
      },
      "SalesMenuSkuCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skuRef", "skuName", "skuCode", "standardPriceCents"],
        "properties": {
          "skuRef": {"type": "string", "format": "uuid"},
          "skuName": {"type": "string", "minLength": 1, "maxLength": 160},
          "skuCode": {"type": "string", "minLength": 1, "maxLength": 160},
          "standardPriceCents": {"type": "integer", "minimum": 0}
        }
      },
      "SalesMenuDraftItemView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["salesItemRef", "catalogItemRef", "itemCode", "displayName", "productShape", "catalogOrderOptions", "skuCandidates", "staleSelectedSkuRefs", "defaultPriceCents", "catalogPrimaryImageAssetRef", "saleContent", "orderingConstraints", "displayMedia", "displayOrder", "canMoveUp", "canMoveDown", "version"],
        "properties": {
          "salesItemRef": {"type": "string", "format": "uuid"},
          "catalogItemRef": {"type": "string", "format": "uuid"},
          "itemCode": {"type": "string", "minLength": 1, "maxLength": 160},
          "displayName": {"type": "string", "minLength": 1, "maxLength": 160},
          "productShape": {"type": "string", "enum": ["ORDINARY", "SKU", "WEIGHTED", "COMPOSITE", "SERVICE"]},
          "catalogOrderOptions": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuOrderOption"}},
          "skuCandidates": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuSkuCandidate"}},
          "staleSelectedSkuRefs": {"type": "array", "items": {"type": "string", "format": "uuid"}},
          "defaultPriceCents": {"type": "integer", "minimum": 0, "nullable": true, "description": "Current Catalog default price for read-only comparison; null for SKU selection, whose defaults are per SKU."},
          "catalogPrimaryImageAssetRef": {"type": "string", "format": "uuid", "nullable": true, "description": "Current Catalog primary display asset for INHERIT_CATALOG; null when no active Catalog image."},
          "saleContent": {"$ref": "#/components/schemas/SalesMenuSaleContent"},
          "orderingConstraints": {"$ref": "#/components/schemas/SalesMenuOrderingConstraints"},
          "displayMedia": {"$ref": "#/components/schemas/SalesMenuDisplayMedia"},
          "displayOrder": {"type": "integer", "minimum": 0},
          "canMoveUp": {"type": "boolean"},
          "canMoveDown": {"type": "boolean"},
          "version": {"type": "integer", "format": "int64", "minimum": 0}
        }
      },
      "SalesMenuItemPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "cursor", "nextCursor"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuDraftItemView"}},
          "cursor": {"type": "string", "maxLength": 512, "nullable": true},
          "nextCursor": {"type": "string", "maxLength": 512, "nullable": true}
        }
      },
      "InventoryAvailabilityFact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicability", "state", "reason"],
        "properties": {
          "applicability": {"type": "string", "enum": ["NOT_APPLICABLE", "APPLICABLE"]},
          "state": {"type": "string", "enum": ["AVAILABLE", "AUTO_UNAVAILABLE", "UNKNOWN"]},
          "reason": {"type": "string", "enum": ["OUT_OF_STOCK", "NEGATIVE_NOT_ALLOWED", "READ_UNAVAILABLE"], "nullable": true}
        }
      },
      "ManualSaleStatusFact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "reason", "changedAt", "changedByDisplayName"],
        "properties": {
          "state": {"type": "string", "enum": ["NORMAL", "MANUAL_SOLD_OUT"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 240, "nullable": true},
          "changedAt": {"type": "integer", "format": "int64", "minimum": 0, "nullable": true},
          "changedByDisplayName": {"type": "string", "minLength": 1, "maxLength": 160, "nullable": true}
        }
      },
      "SalesMenuManualSaleTargetKind": {
        "type": "string",
        "enum": ["ITEM", "SKU", "ORDER_OPTION_VALUE"]
      },
      "SalesMenuManualSaleTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetKind", "targetRef"],
        "properties": {
          "targetKind": {"$ref": "#/components/schemas/SalesMenuManualSaleTargetKind"},
          "targetRef": {"type": "string", "format": "uuid"}
        }
      },
      "SalesMenuManualSaleTargetStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetKind", "targetRef", "resolvedTargetDisplayName", "state", "reason", "changedAt", "changedByDisplayName"],
        "properties": {
          "targetKind": {"$ref": "#/components/schemas/SalesMenuManualSaleTargetKind"},
          "targetRef": {"type": "string", "format": "uuid"},
          "resolvedTargetDisplayName": {"type": "string", "minLength": 1, "maxLength": 160},
          "state": {"type": "string", "enum": ["NORMAL", "MANUAL_SOLD_OUT"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 240, "nullable": true},
          "changedAt": {"type": "integer", "format": "int64", "minimum": 0, "nullable": true},
          "changedByDisplayName": {"type": "string", "minLength": 1, "maxLength": 160, "nullable": true}
        }
      },
      "SalesMenuPublishedItemView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["salesItemRef", "catalogItemRef", "itemCode", "displayName", "productShape", "saleContent", "orderingConstraints", "displayMedia", "displayOrder", "inventoryAvailability", "manualSaleStatus", "manualSaleTargetStatuses", "version"],
        "properties": {
          "salesItemRef": {"type": "string", "format": "uuid"},
          "catalogItemRef": {"type": "string", "format": "uuid"},
          "itemCode": {"type": "string", "minLength": 1, "maxLength": 160},
          "displayName": {"type": "string", "minLength": 1, "maxLength": 160},
          "productShape": {"type": "string", "enum": ["ORDINARY", "SKU", "WEIGHTED", "COMPOSITE", "SERVICE"]},
          "saleContent": {"$ref": "#/components/schemas/SalesMenuSaleContent"},
          "orderingConstraints": {"$ref": "#/components/schemas/SalesMenuOrderingConstraints"},
          "displayMedia": {"$ref": "#/components/schemas/SalesMenuDisplayMedia"},
          "displayOrder": {"type": "integer", "minimum": 0},
          "inventoryAvailability": {"$ref": "#/components/schemas/InventoryAvailabilityFact"},
          "manualSaleStatus": {"$ref": "#/components/schemas/ManualSaleStatusFact"},
          "manualSaleTargetStatuses": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuManualSaleTargetStatus"}},
          "version": {"type": "integer", "format": "int64", "minimum": 0}
        }
      },
      "SalesMenuPublishedSectionList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuSectionView"}}}
      },
      "SalesMenuPublishedItemPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "cursor", "nextCursor"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuPublishedItemView"}},
          "cursor": {"type": "string", "maxLength": 512, "nullable": true},
          "nextCursor": {"type": "string", "maxLength": 512, "nullable": true}
        }
      },
      "SalesMenuItemCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateRef", "catalogItemRef", "itemCode", "displayName", "productShape", "categoryRefs", "categoryNames", "defaultPriceCents", "alreadyAddedCount"],
        "properties": {
          "candidateRef": {"type": "string", "format": "uuid"},
          "catalogItemRef": {"type": "string", "format": "uuid"},
          "itemCode": {"type": "string", "minLength": 1, "maxLength": 160},
          "displayName": {"type": "string", "minLength": 1, "maxLength": 160},
          "productShape": {"type": "string", "enum": ["ORDINARY", "SKU", "WEIGHTED", "COMPOSITE", "SERVICE"]},
          "categoryRefs": {"type": "array", "items": {"type": "string", "format": "uuid"}},
          "categoryNames": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 160}},
          "defaultPriceCents": {"type": "integer", "minimum": 0, "nullable": true},
          "alreadyAddedCount": {"type": "integer", "minimum": 0}
        }
      },
      "SalesMenuCandidatePage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "cursor", "nextCursor"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuItemCandidate"}},
          "cursor": {"type": "string", "maxLength": 512, "nullable": true},
          "nextCursor": {"type": "string", "maxLength": 512, "nullable": true}
        }
      },
      "SalesMenuPublicationBlocker": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "salesItemRef", "messageKey"],
        "properties": {
          "kind": {"type": "string", "enum": ["STORE_DISABLED", "CHANNEL_DISABLED", "CHANNEL_INELIGIBLE", "CATALOG_ITEM_INVALID", "SKU_SELECTION_EMPTY", "SKU_INVALID", "ORDER_OPTION_SELECTION_INVALID", "LISTED_PRICE_MISSING", "ORDERING_CONSTRAINT_INVALID", "DISPLAY_ASSET_PENDING_OR_INVALID", "SCHEDULE_INVALID"]},
          "salesItemRef": {"type": "string", "format": "uuid", "nullable": true},
          "messageKey": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      },
      "SalesMenuPublicationPreview": {
        "type": "object",
        "additionalProperties": false,
        "required": ["salesMenuRef", "draftRevision", "hasChanges", "violations"],
        "properties": {
          "salesMenuRef": {"type": "string", "format": "uuid"},
          "draftRevision": {"type": "integer", "format": "int64", "minimum": 0},
          "hasChanges": {"type": "boolean"},
          "violations": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuPublicationBlocker"}}
        }
      },
      "SalesMenuOperationRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationRecordRef", "occurredAt", "operationKind", "salesMenuRef", "targetRef", "targetKind", "targetDisplaySnapshot", "result", "failureCode", "actorDisplayName"],
        "properties": {
          "operationRecordRef": {"type": "string", "format": "uuid"},
          "occurredAt": {"type": "integer", "format": "int64", "minimum": 0},
          "operationKind": {"type": "string", "minLength": 1, "maxLength": 120},
          "salesMenuRef": {"type": "string", "format": "uuid"},
          "targetRef": {"type": "string", "format": "uuid", "nullable": true},
          "targetKind": {"$ref": "#/components/schemas/SalesMenuManualSaleTargetKind", "nullable": true},
          "targetDisplaySnapshot": {"type": "string", "minLength": 1, "maxLength": 160, "nullable": true},
          "result": {"type": "string", "enum": ["SUCCESS", "FAILED"]},
          "failureCode": {"type": "string", "minLength": 1, "maxLength": 120, "nullable": true},
          "actorDisplayName": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      },
      "SalesMenuOperationRecordPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "cursor", "nextCursor"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/SalesMenuOperationRecord"}},
          "cursor": {"type": "string", "maxLength": 512, "nullable": true},
          "nextCursor": {"type": "string", "maxLength": 512, "nullable": true}
        }
      },
      "SalesMenuAssetTargetReadback": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groupWorkspaceKey", "storeRef", "salesMenuRef", "salesItemRef", "usage", "expectedDraftVersion"],
        "properties": {
          "groupWorkspaceKey": {"type": "string", "minLength": 1, "maxLength": 128},
          "storeRef": {"type": "string", "format": "uuid"},
          "salesMenuRef": {"type": "string", "format": "uuid"},
          "salesItemRef": {"type": "string", "format": "uuid"},
          "usage": {"type": "string", "enum": ["SALES_MENU_ITEM_IMAGE"]},
          "expectedDraftVersion": {"type": "integer", "format": "int64", "minimum": 0}
        }
      },
      "SalesMenuAssetStageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedDraftVersion", "fileName", "mediaType", "contentDigest", "content"],
        "properties": {
          "expectedDraftVersion": {"type": "integer", "format": "int64", "minimum": 0},
          "fileName": {"type": "string", "minLength": 1, "maxLength": 240},
          "mediaType": {"type": "string", "minLength": 1, "maxLength": 120},
          "contentDigest": {"type": "string", "minLength": 1, "maxLength": 128},
          "content": {"type": "string", "format": "binary", "description": "real asset bytes; multipart/form-data only"}
        }
      },
      "SalesMenuAssetStageReadback": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetRef", "bindGrant", "status", "version", "target"],
        "properties": {
          "assetRef": {"type": "string", "format": "uuid"},
          "bindGrant": {"type": "string", "minLength": 1, "maxLength": 512, "readOnly": true},
          "status": {"type": "string", "enum": ["STAGED"]},
          "version": {"type": "integer", "format": "int64", "minimum": 0},
          "target": {"$ref": "#/components/schemas/SalesMenuAssetTargetReadback"}
        }
      },
      "SalesMenuAssetReleaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedAssetVersion"],
        "properties": {"expectedAssetVersion": {"type": "integer", "format": "int64", "minimum": 0}}
      },
      "SalesMenuAssetReleaseReadback": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetRef", "status", "version", "target"],
        "properties": {
          "assetRef": {"type": "string", "format": "uuid"},
          "status": {"type": "string", "enum": ["RELEASED"]},
          "version": {"type": "integer", "format": "int64", "minimum": 0},
          "target": {"$ref": "#/components/schemas/SalesMenuAssetTargetReadback"}
        }
      },
      "SalesMenuCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channelRef", "name"],
        "properties": {
          "channelRef": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      },
      "SalesMenuCopyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedVersion"],
        "properties": {"expectedVersion": {"type": "integer", "format": "int64", "minimum": 0}}
      },
      "SalesMenuArchiveRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedVersion"],
        "properties": {"expectedVersion": {"type": "integer", "format": "int64", "minimum": 0}}
      },
      "SalesMenuRenameRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expectedVersion"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 160},
          "expectedVersion": {"type": "integer", "format": "int64", "minimum": 0}
        }
      },
      "SalesMenuActivationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "expectedVersion"],
        "properties": {
          "status": {"type": "string", "enum": ["ENABLED", "DISABLED"]},
          "expectedVersion": {"type": "integer", "format": "int64", "minimum": 0}
        }
      },
      "SalesMenuScheduleUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schedule", "expectedVersion"],
