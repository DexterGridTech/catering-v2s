{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catering-v2s.local/contracts/catalog/store-operating-rule-switches.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "revision", "valueTypes", "definitions"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "store-operating-rule-switch-catalog"},
    "revision": {"type": "string", "minLength": 1},
    "valueTypes": {
      "type": "array",
      "const": ["BOOLEAN", "NUMBER", "STRING"]
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type", "defaultValue", "parentKey", "displayOrder"],
        "properties": {
          "key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,119}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 120},
          "type": {"enum": ["BOOLEAN", "NUMBER", "STRING"]},
          "defaultValue": {"type": ["boolean", "number", "string"]},
          "parentKey": {"type": ["string", "null"]},
          "displayOrder": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
