{
  "paths": {
    "/api/terminal/group-workspaces/{groupWorkspaceKey}/update-artifacts/{artifactRef}/content": {
      "get": {
        "operationId": "downloadTerminalUpdateArtifact",
        "tags": [
          "TERMINAL_UPDATE_PACKAGE"
        ],
        "x-consumer-faces": [
          "terminal"
        ],
        "x-owner-module": "TERMINAL_UPDATE_PACKAGE",
        "x-scenario-ids": [
          "N-content"
        ],
        "x-page-key": "PG-PROJECT-TERMINAL-VERSION-RULES",
        "x-idempotency-policy": "FORBIDDEN",
        "x-request-schema": "NoBody",
        "x-error-codes": [
          "PLATFORM_COMMON_ACCESS_DENIED",
          "PLATFORM_COMMON_GROUP_WORKSPACE_DISABLED",
          "PLATFORM_COMMON_RESOURCE_NOT_FOUND",
          "PLATFORM_COMMON_VALIDATION_FAILED",
          "PLATFORM_DEPENDENCY_UNAVAILABLE",
          "TERMINAL_UPDATE_ARTIFACT_NOT_AUTHORIZED",
          "TERMINAL_UPDATE_GRANT_EXPIRED"
        ],
        "security": [
          {
            "terminalUpdateDownloadGrant": []
          }
        ],
        "parameters": [
          {
            "name": "groupWorkspaceKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            }
          },
          {
            "name": "artifactRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "format": "uuid"
            }
          },
          {
            "name": "X-Terminal-Update-Grant",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner readback",
            "content": {
              "application/zip": {
                "schema": {
                  "$ref": "../../../../components/terminal-update/terminal-update.schemas.json#/components/schemas/TerminalUpdateBinaryContent"
                }
              }
            }
          },
          "400": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "401": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "403": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "404": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "409": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "422": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "429": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "500": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "503": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          }
        }
      }
    }
  }
}
