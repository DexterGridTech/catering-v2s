          },
          "401": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "403": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "404": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "409": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "422": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "429": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "500": {
            "$ref": "../../../../edge.openapi.json#/components/responses/ProblemResponse"
          },
          "503": {
