{
  "paths": {
    "/api/operations/group-workspaces/{groupWorkspaceKey}/terminal-update-artifact-candidates": {
      "get": {
        "operationId": "getOperationsTerminalUpdateArtifactCandidatePage",
        "tags": [
          "TERMINAL_UPDATE_PACKAGE"
        ],
        "x-consumer-faces": [
          "operations-admin"
        ],
        "x-owner-module": "TERMINAL_UPDATE_PACKAGE",
        "x-scenario-ids": [
          "N-candidate"
        ],
        "x-page-key": "PG-PROJECT-TERMINAL-VERSION-RULES",
        "x-idempotency-policy": "FORBIDDEN",
        "x-request-schema": "NoBody",
        "x-error-codes": [
