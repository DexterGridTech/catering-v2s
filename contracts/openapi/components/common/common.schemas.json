{
  "components": {
    "schemas": {
      "AuditHistoryPage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditHistoryItem"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "AuditHistoryItem": {
        "type": "object",
        "required": [
          "id",
          "occurredAt",
          "actorDisplayName",
          "actionSummary",
          "action",
          "target",
          "changes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "$ref": "time.schemas.json#/components/schemas/EpochMillis"
          },
          "actorDisplayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "actionSummary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "target": {
            "$ref": "#/components/schemas/AuditTarget"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditChange"
            }
          }
        },
        "additionalProperties": false
      },
      "AuditTarget": {
        "type": "object",
        "required": [
          "entityType",
          "entityId"
        ],
        "properties": {
          "entityType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "entityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": false
      },
      "AuditValueState": {
        "type": "string",
        "enum": [
          "MISSING",
          "NULL",
          "CLEARED",
          "VALUE"
        ]
      },
      "AuditChange": {
        "type": "object",
        "required": [
          "fieldKey"
        ],
        "properties": {
          "fieldKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "fieldLabelSnapshot": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          },
          "beforeState": {
            "$ref": "#/components/schemas/AuditValueState",
            "description": "Present on new audit events; omitted on legacy events without state metadata."
          },
          "beforeValue": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "afterState": {
            "$ref": "#/components/schemas/AuditValueState",
            "description": "Present on new audit events; omitted on legacy events without state metadata."
          },
          "afterValue": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      },
      "OrganizationPathNode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "code",
          "name",
          "nodeType"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "nodeType": {
            "$ref": "enum.schemas.json#/components/schemas/ServiceNodeType"
          }
        }
      }
    }
  }
}
