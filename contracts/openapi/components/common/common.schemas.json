{
  "components": {
    "schemas": {
      "AuditHistoryPage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditHistoryItem"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "AuditHistoryItem": {
        "type": "object",
        "required": [
          "id",
          "occurredAt",
          "actorDisplayName",
          "actionSummary",
          "action",
          "target",
          "changes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "$ref": "time.schemas.json#/components/schemas/EpochMillis"
          },
          "actorDisplayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "actionSummary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "target": {
            "$ref": "#/components/schemas/AuditTarget"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditChange"
            }
          }
        },
        "additionalProperties": false
      },
      "AuditTarget": {
        "type": "object",
        "required": [
          "entityType",
          "entityId"
        ],
        "properties": {
          "entityType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "entityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": false
      },
      "AuditChange": {
        "type": "object",
        "required": [
          "fieldKey",
          "beforeValue",
          "afterValue"
        ],
        "properties": {
          "fieldKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "beforeValue": {
            "type": "string",
            "maxLength": 2000
          },
          "afterValue": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      }
    }
  }
}
