            "maxLength": 120
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content": {
            "type": "string",
            "format": "binary",
            "description": "real asset bytes; multipart/form-data only"
          }
