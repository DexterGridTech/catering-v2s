{
  "components": {
    "schemas": {
      "ExternalCapability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityClass",
          "displayName",
          "attributeValues"
        ],
        "properties": {
          "capabilityClass": {
            "type": "string",
            "enum": [
              "MASTER_DATA_SYNC",
              "MEMBER_BENEFIT",
              "GROUP_BUY",
              "TAKEAWAY",
              "INVENTORY_SYNC",
              "TAKEAWAY_DELIVERY",
              "ORDER_SYNC"
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "attributeValues": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "groupBuyMappingDirection": {
                "type": "string",
                "enum": [
                  "EXTERNAL_TO_INTERNAL",
                  "INTERNAL_TO_EXTERNAL"
                ]
              },
              "menuCollaborationDirection": {
                "type": "string",
                "enum": [
                  "PULL_ONLY"
                ]
              }
            }
          }
        }
      },
      "ExternalSystemView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalSystemCode",
          "displayName",
          "catalogStatus",
          "capabilities",
          "enablementStatus",
          "version"
        ],
        "properties": {
          "externalSystemCode": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "catalogStatus": {
            "type": "string",
            "enum": [
              "PLANNED",
              "AVAILABLE"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalCapability"
            }
          },
          "enablementStatus": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ProviderProfileView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerCode",
          "displayName",
          "externalSystemCode",
          "externalSystemDisplayName",
          "businessScope",
          "bindableNodeTypes",
          "authenticationKind",
          "unbindKind",
          "catalogStatus",
          "enablementStatus",
          "version"
        ],
        "properties": {
          "providerCode": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "externalSystemCode": {
            "type": "string"
          },
          "externalSystemDisplayName": {
            "type": "string",
            "minLength": 1
          },
          "businessScope": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "TAKEAWAY",
                "GROUP_BUY",
                "ORDER_SYNC",
                "MEMBER_BENEFIT"
              ]
            }
          },
          "bindableNodeTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "COMMERCIAL_GROUP",
                "REGION",
                "PROJECT",
                "HEAD_COMPANY",
                "STORE"
              ]
            }
          },
          "authenticationKind": {
            "type": "string",
            "enum": [
              "EXTERNAL_GRANT",
              "INTERNAL_MAPPING",
              "NO_MAPPING"
            ]
          },
          "unbindKind": {
            "type": "string",
            "enum": [
              "LOCAL_ONLY",
              "REQUIRES_ADAPTER_UNBIND"
            ]
          },
          "catalogStatus": {
            "type": "string",
            "enum": [
              "PLANNED",
              "AVAILABLE"
            ]
          },
          "enablementStatus": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ExternalCollaborationTree": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalSystems",
          "providerProfiles"
        ],
        "properties": {
          "externalSystems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalSystemView"
            }
          },
          "providerProfiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderProfileView"
            }
          }
        }
      },
      "ExternalSystemStatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "expectedVersion"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ]
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ProviderProfileStatusRequest": {
        "$ref": "#/components/schemas/ExternalSystemStatusRequest"
      },
      "OwnerBindingCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerCode",
          "nodeType",
          "nodeRef"
        ],
        "properties": {
          "providerCode": {
            "type": "string"
          },
          "capabilityClass": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "MASTER_DATA_SYNC",
              "MEMBER_BENEFIT",
              "GROUP_BUY",
              "TAKEAWAY",
              "INVENTORY_SYNC",
              "TAKEAWAY_DELIVERY",
              "ORDER_SYNC",
              null
            ]
          },
          "nodeType": {
            "type": "string"
          },
          "nodeRef": {
            "type": "string",
            "format": "uuid"
          },
          "bindingDisplayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalOwnerId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OwnerBindingUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bindingDisplayName",
          "expectedVersion"
        ],
        "properties": {
          "bindingDisplayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalOwnerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "OwnerBindingView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bindingRef",
          "providerCode",
          "providerDisplayName",
          "nodeType",
          "nodeRef",
          "nodePath",
          "businessScope",
          "boundAt",
          "statusChangedAt",
          "status",
          "version"
        ],
        "properties": {
          "bindingRef": {
            "type": "string",
            "format": "uuid"
          },
          "providerCode": {
            "type": "string"
          },
          "providerDisplayName": {
            "type": "string",
            "minLength": 1
          },
          "capabilityClass": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "MASTER_DATA_SYNC",
              "MEMBER_BENEFIT",
              "GROUP_BUY",
              "TAKEAWAY",
              "INVENTORY_SYNC",
              "TAKEAWAY_DELIVERY",
              "ORDER_SYNC",
              null
            ]
          },
          "businessScope": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "TAKEAWAY",
                "GROUP_BUY",
                "ORDER_SYNC",
                "MEMBER_BENEFIT"
              ]
            }
          },
          "nodeType": {
            "type": "string",
            "enum": [
              "COMMERCIAL_GROUP",
              "REGION",
              "PROJECT",
              "HEAD_COMPANY",
              "STORE"
            ]
          },
          "nodeRef": {
            "type": "string",
            "format": "uuid"
          },
          "nodePath": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "../common/common.schemas.json#/components/schemas/OrganizationPathNode"
            }
          },
          "bindingDisplayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalOwnerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "boundAt": {
            "type": "integer",
            "format": "int64"
          },
          "statusChangedAt": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING_AUTHORIZATION",
              "EFFECTIVE",
              "INVALID",
              "DELETED"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "OwnerBindingPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metadata",
          "items"
        ],
        "properties": {
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bindingName",
              "nodeQueryText",
              "sortKey",
              "sortDirection",
              "page",
              "pageSize",
              "total"
            ],
            "properties": {
              "bindingName": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 120
              },
              "nodeQueryText": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 120
              },
              "sortKey": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "BINDING_NAME",
                  "NODE",
                  "BUSINESS",
                  "EXTERNAL_OWNER_ID",
                  "STATUS",
                  null
                ]
              },
              "sortDirection": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "ASC",
                  "DESC",
                  null
                ]
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "pageSize": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "total": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OwnerBindingView"
            }
          }
        }
      },
      "CapabilityDictionary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalSystems",
          "providerProfiles"
        ],
        "properties": {
          "externalSystems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalSystemView"
            }
          },
          "providerProfiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderProfileView"
            }
          }
        }
      }
    }
  }
}
