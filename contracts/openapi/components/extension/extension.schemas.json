{
  "components": {
    "schemas": {
      "ExtensionDefinition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "groupWorkspaceKey",
          "entityType",
          "definitions",
          "revision",
          "updatedAt",
          "workspaceStatus",
          "blockers"
        ],
        "properties": {
          "groupWorkspaceKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "entityType": {
            "$ref": "#/components/schemas/ExtensionEntityType"
          },
          "definitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "label",
                "type",
                "required",
                "options",
                "status"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-z][a-zA-Z0-9_]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "TEXT",
                    "NUMBER",
                    "DATE",
                    "BOOLEAN",
                    "SELECT"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ENABLED",
                    "DISABLED"
                  ]
                },
                "displayOrder": {
                  "type": "integer",
                  "minimum": 0
                },
                "displaySuffix": {
                  "type": "string",
                  "nullable": true,
                  "minLength": 1,
                  "maxLength": 20
                }
              }
            }
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "updatedAt": {
            "$ref": "../common/time.schemas.json#/components/schemas/EpochMillis"
          },
          "workspaceStatus": {
            "$ref": "../platform-workspace/group-workspace.schemas.json#/components/schemas/GroupWorkspaceStatus"
          },
          "blockers": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/ExtensionDefinitionBlocker"
            }
          }
        }
      },
      "ExtensionDefinitionUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definitions",
          "expectedVersion"
        ],
        "properties": {
          "definitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "type",
                "required",
                "options",
                "status"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-z][a-zA-Z0-9_]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "TEXT",
                    "NUMBER",
                    "DATE",
                    "BOOLEAN",
                    "SELECT"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ENABLED",
                    "DISABLED"
                  ]
                },
                "displayOrder": {
                  "type": "integer",
                  "minimum": 0
                },
                "displaySuffix": {
                  "type": "string",
                  "nullable": true,
                  "minLength": 1,
                  "maxLength": 20
                }
              }
            }
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ExtensionEntityCatalogPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entityType",
                "displayName",
                "configuredFieldCount",
                "updatedAt"
              ],
              "properties": {
                "entityType": {
                  "$ref": "#/components/schemas/ExtensionEntityType"
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "configuredFieldCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "updatedAt": {
                  "$ref": "../common/time.schemas.json#/components/schemas/EpochMillis"
                }
              }
            }
          }
        }
      },
      "ExtensionEntityType": {
        "type": "string",
        "enum": [
          "BRAND",
          "TENANT",
          "HEAD_COMPANY",
          "STORE",
          "CONTRACT",
          "COMMERCIAL_GROUP",
          "REGION",
          "PROJECT"
        ]
      },
      "ExtensionDefinitionBlocker": {
        "required": [
          "type",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "WORKSPACE"
            ]
          },
          "status": {
            "$ref": "../platform-workspace/group-workspace.schemas.json#/components/schemas/GroupWorkspaceStatus"
          }
        },
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
