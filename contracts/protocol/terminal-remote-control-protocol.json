{
  "protocolVersion": 1,
  "topic": "ter.remote-control.v1",
  "maxMessageBytes": 4096,
  "envelope": {
    "additionalFields": "ignore",
    "fields": {
      "v": { "type": "integer", "const": 1 },
      "sessionId": { "type": "uuid" },
      "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
    }
  },
  "messages": [
    {
      "type": "SCREEN_READY",
      "direction": "endpoint_to_controller_and_master",
      "additionalFields": "ignore",
      "body": {
        "additionalFields": "ignore",
        "fields": {
          "endpointId": { "type": "uuid" },
          "screen": { "type": "string", "enum": ["main", "secondary"] },
          "streamId": { "type": "uuid" },
          "trackSid": { "type": "string", "minLength": 1, "maxLength": 128 },
          "widthPx": { "type": "integer", "minimum": 1 },
          "heightPx": { "type": "integer", "minimum": 1 }
        }
      }
    },
    {
      "type": "POINTER",
      "direction": "controller_to_endpoint",
      "additionalFields": "ignore",
      "body": {
        "additionalFields": "ignore",
        "fields": {
          "endpointId": { "type": "uuid" },
          "screen": { "type": "string", "enum": ["main", "secondary"] },
          "streamId": { "type": "uuid" },
          "gestureId": { "type": "uuid" },
          "phase": { "type": "string", "enum": ["down", "move", "up", "cancel"] },
          "u": { "type": "number", "minimum": 0, "maximum": 1, "optional": true },
          "v": { "type": "number", "minimum": 0, "maximum": 1, "optional": true }
        }
      }
    },
    {
      "type": "INPUT_RESULT",
      "direction": "endpoint_to_controller",
      "additionalFields": "ignore",
      "body": {
        "additionalFields": "ignore",
        "fields": {
          "forSeq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "gestureId": { "type": "uuid" },
          "status": { "type": "string", "enum": ["DISPATCHED", "REJECTED", "CANCELLED"] },
          "reason": {
            "type": "string",
            "enum": [
              "NOT_READY", "SESSION_ENDED", "STALE_STREAM", "WRONG_TARGET", "INVALID_MESSAGE",
              "OUT_OF_BOUNDS", "INVALID_GESTURE", "DUPLICATE", "INPUT_CONFLICT", "GESTURE_EXPIRED",
              "UNSUPPORTED_SURFACE"
            ],
            "nullable": true
          }
        }
      }
    },
    {
      "type": "KEEPALIVE",
      "direction": "controller_to_endpoints",
      "additionalFields": "ignore",
      "body": {
        "additionalFields": "ignore",
        "fields": { "probeId": { "type": "uuid" } }
      }
    },
    {
      "type": "KEEPALIVE_ACK",
      "direction": "endpoint_to_controller",
      "additionalFields": "ignore",
      "body": {
        "additionalFields": "ignore",
        "fields": { "probeId": { "type": "uuid" } }
      }
    },
    {
      "type": "SESSION_END",
      "direction": "session_member_to_members",
      "additionalFields": "ignore",
      "body": {
        "additionalFields": "ignore",
        "fields": {
          "reason": {
            "type": "string",
            "enum": [
              "ADMIN_ENDED", "WORKSPACE_CLOSED", "START_TIMEOUT", "START_FAILED", "CONTROLLER_DISCONNECTED",
              "SCREEN_DISCONNECTED", "PAIR_DISCONNECTED", "TDP_DISCONNECTED", "ACTIVATION_INVALID",
              "AUTHORIZATION_INVALID", "CONFIG_CHANGED", "APP_RESTARTED", "LEASE_EXPIRED", "CAPTURE_FAILED",
              "INPUT_RESULT_UNKNOWN", "INPUT_UNAVAILABLE", "UNSUPPORTED_PROTOCOL"
            ]
          }
        }
      }
    }
  ]
}
