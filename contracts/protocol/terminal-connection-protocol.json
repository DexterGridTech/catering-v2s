{
  "protocolVersion": 1,
  "endpoint": {
    "method": "GET",
    "path": "/tdp/{groupWorkspaceKey}/ws"
  },
  "encoding": "UTF-8 JSON text messages",
  "messages": [
    {
      "type": "AUTHENTICATE",
      "direction": "device_to_tds",
      "firstMessage": true,
      "maxUtf8Bytes": 65536,
      "fields": {
        "terminalRef": {"type": "string", "grammar": "R-4.1 terminal route identity"},
        "terminalCredential": {"type": "string", "format": "canonical-positive-generation.canonical-unpadded-base64url-32-byte-secret"},
        "deviceId": {"type": "string", "minUtf8Bytes": 1, "maxUtf8Bytes": 128},
        "appVersion": {"type": "string", "minUtf8Bytes": 1, "maxUtf8Bytes": 64}
      },
      "maxSerializedUtf8Bytes": 65536,
      "additionalFields": "ignore"
    },
    {
      "type": "SESSION_READY",
      "direction": "tds_to_device",
      "fields": {
        "sessionId": {"type": "string", "minUtf8Bytes": 1, "maxUtf8Bytes": 128},
        "nodeId": {"type": "string", "minUtf8Bytes": 1, "maxUtf8Bytes": 128},
        "serverTime": {"type": "string", "format": "RFC3339-UTC"},
        "heartbeatIntervalMs": {"type": "integer", "minimum": 1000},
        "heartbeatTimeoutMs": {"type": "integer", "minimumFormula": "2 * heartbeatIntervalMs"}
      },
      "additionalFields": "ignore"
    },
    {
      "type": "PING",
      "direction": "device_to_tds",
      "fields": {
        "seq": {"type": "integer", "minimum": 1, "maximum": 9007199254740991, "perSession": "strictly increasing"},
        "clientTs": {"type": "string", "format": "RFC3339-UTC"},
        "lastRttMs": {"type": "number", "minimum": 0, "initialValue": 0}
      },
      "additionalFields": "ignore"
    },
    {
      "type": "PONG",
      "direction": "tds_to_device",
      "fields": {
        "seq": {"type": "integer", "sameAs": "accepted PING.seq"},
        "serverTs": {"type": "string", "format": "RFC3339-UTC"}
      },
      "additionalFields": "ignore"
    }
  ],
  "close": {
    "application": {
      "code": 4000,
      "reasons": [
        "ACTIVATION_CANCELLED",
        "CREDENTIAL_INVALID",
        "GROUP_WORKSPACE_DISABLED",
        "TERMINAL_DISABLED",
        "SESSION_REPLACED",
        "REDIRECT_TO_NEXT_NODE",
        "NODE_BUSY",
        "AUTHENTICATION_TIMEOUT",
        "HEARTBEAT_TIMEOUT",
        "SERVER_ERROR",
        "NETWORK_ERROR",
        "UNKNOWN"
      ]
    },
    "standardExceptions": [
      {
        "code": 1002,
        "handling": "protocol violations are handled by the WebSocket implementation; this contract does not prescribe the close reason"
      },
      {
        "code": 1009,
        "when": [
          "frame payload exceeds 65536 bytes",
          "permessage-deflate output exceeds 65536 bytes during decompression",
          "complete decompressed message, including fragments, exceeds 65536 bytes"
        ]
      }
    ],
    "unknownApplicationMessage": "4000/UNKNOWN"
  },
  "compression": {
    "extension": "permessage-deflate",
    "rfc": 7692,
    "enabledOnlyWhenClientOffers": true,
    "limits": {
      "maxFramePayloadBytes": 65536,
      "maxDecompressedMessageBytes": 65536,
      "maxCompleteDecompressedMessageBytes": 65536,
      "overflowCloseCode": 1009
    }
  }
}
