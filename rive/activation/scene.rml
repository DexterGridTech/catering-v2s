                    <DashPath offset="0" id="0:54">
                        <Dash length="40"/>
                        <Dash length="10"/>
                    </DashPath>
                </Stroke>
            </Shape>

            <!-- 段4 -->
            <Shape name="Segment4" id="0:61">
                <PointsPath>
                    <StraightVertex x="-50" y="0"/>
                    <StraightVertex x="0" y="0"/>
                </PointsPath>
                <Stroke name="Stroke4" thickness="3" cap="butt" join="miter" id="0:62">
                    <SolidColor colorValue="FF000000" id="0:63"/>
                    <DashPath offset="0" id="0:64">
                        <Dash length="40"/>
                        <Dash length="10"/>
                    </DashPath>
                </Stroke>
            </Shape>

            <!-- 段5 -->
            <Shape name="Segment5" id="0:71">
                <PointsPath>
                    <StraightVertex x="0" y="0"/>
                    <StraightVertex x="50" y="0"/>
