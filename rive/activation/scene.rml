<Rive version="1" kind="fragment">
    <!-- View Model: 控制激活码状态 -->
    <ViewModel name="ActivationViewModel" id="0:100">
        <ViewModelPropertyNumber name="activationCount" id="0:105"/>
        <ViewModelInstanceNumber viewModelPropertyId="0:105" propertyValue="0" id="0:101"/>
    </ViewModel>

    <Artboard defaultStateMachineId="0:7" viewModelId="0:100" width="600" height="150" name="Activation" id="0:2">
        <!-- 透明背景：不添加 Fill -->

        <!-- 左侧：终端图标（蓝色矩形框，中心在 80, 75） -->
        <Rectangle name="TerminalScreen" x="80" y="75" width="60" height="45" cornerRadiusTL="2" cornerRadiusTR="2" id="0:10">
            <Stroke thickness="2.5" cap="round" join="round">
                <SolidColor colorValue="FF2196F3"/>
            </Stroke>
        </Rectangle>

        <!-- 右侧：云服务图标（绿色椭圆，中心在 520, 75） -->
        <Ellipse name="CloudIcon" x="520" y="75" width="60" height="30" id="0:20">
            <Fill>
                <SolidColor colorValue="FF4CAF50"/>
            </Fill>
        </Ellipse>

        <!-- 中间：箭头路径和虚线 - 8个独立段 -->
        <Node name="Arrow" x="300" y="75" id="0:30">
            <!-- 8个独立虚线段，每段可独立控制粗细 -->
            <!-- 段1 -->
            <Shape name="Segment1" id="0:31">
                <PointsPath>
                    <StraightVertex x="-200" y="0"/>
                    <StraightVertex x="-150" y="0"/>
                </PointsPath>
                <Stroke name="Stroke1" thickness="3" cap="butt" join="miter" id="0:32">
                    <SolidColor colorValue="FF000000" name="Color1" id="0:33"/>
                    <DashPath offset="0" id="0:34">
                        <Dash length="40"/>
                        <Dash length="10"/>
                    </DashPath>
                </Stroke>
            </Shape>

            <!-- 段2 -->
            <Shape name="Segment2" id="0:41">
                <PointsPath>
                    <StraightVertex x="-150" y="0"/>
                    <StraightVertex x="-100" y="0"/>
                </PointsPath>
                <Stroke name="Stroke2" thickness="3" cap="butt" join="miter" id="0:42">
                    <SolidColor colorValue="FF000000" id="0:43"/>
                    <DashPath offset="0" id="0:44">
                        <Dash length="40"/>
                        <Dash length="10"/>
                    </DashPath>
                </Stroke>
            </Shape>

            <!-- 段3 -->
            <Shape name="Segment3" id="0:51">
                <PointsPath>
                    <StraightVertex x="-100" y="0"/>
                    <StraightVertex x="-50" y="0"/>
                </PointsPath>
                <Stroke name="Stroke3" thickness="3" cap="butt" join="miter" id="0:52">
