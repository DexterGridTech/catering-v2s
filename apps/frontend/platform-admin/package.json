{
  "name": "@catering-v2s/platform-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test src/tests/architecture/*.test.mjs && vitest run src --exclude \"**/*.mjs\" --exclude \"**/*.spec.ts\"",
    "lint:architecture": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:style": "stylelint \"src/**/*.css\" --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "yarn lint:architecture && yarn lint:style && ../../../scripts/check/frontend-architecture && yarn typecheck && vite build"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/pro-components": "3.1.12-0",
    "@catering-v2s/admin-ui-foundation": "workspace:*",
    "@reduxjs/toolkit": "2.12.0",
    "antd": "6.5.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-redux": "9.3.0",
    "react-router": "7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.5",
    "stylelint": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.0.0",
    "vitest": "4.1.10"
  }
}
