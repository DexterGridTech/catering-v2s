    "@catering-v2s/kernel-base-topology": "workspace:*",
    "@catering-v2s/kernel-base-transport": "workspace:*",
    "@catering-v2s/kernel-base-ui-state": "workspace:*",
    "@catering-v2s/kernel-feature-sample-staff-session": "workspace:*",
    "@catering-v2s/kernel-feature-sample-wallpaper": "workspace:*",
    "@catering-v2s/ui-base-admin-shell": "workspace:*",
    "@catering-v2s/ui-base-input": "workspace:*",
    "@catering-v2s/ui-base-integration-assembly": "workspace:*",
