{
  "name": "@catering-v2s/ui-integration-sample-wallpaper-console",
  "private": true,
  "type": "module",
  "main": "index.js",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme/global.css": "./theme/global.css"
  },
  "terminalSurfaces": {
    "orientations": {
      "landscape": {
        "PRIMARY": {
          "width": 1280,
          "height": 720
        },
        "SECONDARY": {
          "width": 1280,
          "height": 720
        }
      },
      "portrait": {
        "PRIMARY": {
          "width": 360,
          "height": 640
        }
      }
    }
  },
  "showAdminPassword": true,
  "serverSpaces": {
    "selectedSpace": "development",
    "spaces": [
      {
        "name": "development",
        "servers": [
          {
            "serverName": "business",
            "addresses": [
              {
                "addressName": "primary",
                "baseUrl": "http://127.0.0.1:28080/api/terminal/group-workspaces/aurora",
                "timeoutMs": 10000
              }
            ]
          },
          {
            "serverName": "terminal-data-server",
            "addresses": [
              {
                "addressName": "haproxy-entry-one",
                "baseUrl": "ws://127.0.0.1:28180",
                "timeoutMs": 10000
              },
              {
                "addressName": "haproxy-entry-two",
                "baseUrl": "ws://127.0.0.1:28181",
                "timeoutMs": 10000
              }
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "lint": "node ../../../../../tools/terminal-shared/run-owned-lint.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node ../../../../../tools/terminal-shared/run-owned-tests.mjs",
    "web": "expo start --web"
  },
  "dependencies": {
    "@catering-v2s/kernel-base-contracts": "workspace:*",
