{
  "name": "@catering-v2s/application-android-sample-terminal",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "terminalSurfaces": {
    "orientations": {
      "landscape": {
        "PRIMARY": {
          "width": 1280,
          "height": 720
        },
        "SECONDARY": {
          "width": 1280,
          "height": 720
        }
      },
      "portrait": {
        "PRIMARY": {
          "width": 360,
          "height": 640
        }
      }
    }
  },
  "showAdminPassword": true,
  "dependencies": {
    "@catering-v2s/application-base-android": "workspace:*",
    "@catering-v2s/ui-base-input": "workspace:*",
    "@catering-v2s/ui-base-primitives": "workspace:*",
    "@catering-v2s/ui-base-render": "workspace:*",
    "@catering-v2s/ui-integration-sample-console": "workspace:*",
    "expo": "~57.0.18",
    "expo-modules-core": "~57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "nativewind": "4.2.6",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "lint": "node ../../../../../tools/terminal-shared/run-owned-lint.mjs",
    "start": "expo start",
    "android": "expo run:android --variant debug",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  }
}
