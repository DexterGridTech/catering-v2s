{
  "name": "@catering-v2s/application-android-sample-terminal",
  "version": "1.0.0",
  "terminalRelease": {
    "nativeBuildNumber": 1,
    "bundleVersion": "1.0.0",
    "runtimeVersion": "ter-main-v1"
  },
  "main": "index.ts",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "terminalSurfaces": {
    "orientations": {
      "landscape": {
        "PRIMARY": {
          "width": 1280,
          "height": 720
        },
        "SECONDARY": {
          "width": 1280,
          "height": 720
        }
      },
      "portrait": {
        "PRIMARY": {
          "width": 360,
          "height": 640
        }
      }
    }
  },
  "showAdminPassword": true,
  "terminalAutomation": {
    "enabled": false,
    "url": "ws://127.0.0.1:19090/automation",
    "sessionToken": ""
  },
  "serverSpaces": {
  "selectedSpace": "development",
  "spaces": [
    {
      "name": "development",
      "servers": [
        {
          "serverName": "business",
          "addresses": [
            {
              "addressName": "primary",
              "baseUrl": "http://127.0.0.1:28080/api/terminal/group-workspaces/aurora",
              "timeoutMs": 10000
            }
          ]
        },
        {
          "serverName": "livekit",
          "addresses": [
            {
              "addressName": "primary",
              "baseUrl": "ws://47.106.121.27:7880",
              "timeoutMs": 10000
            }
          ]
        },
        {
          "serverName": "terminal-data-server",
          "addresses": [
            {
              "addressName": "haproxy-entry-one",
              "baseUrl": "ws://127.0.0.1:28180",
              "timeoutMs": 10000
            },
            {
              "addressName": "haproxy-entry-two",
              "baseUrl": "ws://127.0.0.1:28181",
              "timeoutMs": 10000
            }
          ]
        }
      ]
    },
    {
      "name": "uat",
      "servers": [
        {
          "serverName": "business",
          "addresses": [
            {
              "addressName": "primary",
              "baseUrl": "http://47.106.121.27:19182/api/terminal/group-workspaces/aurora",
              "timeoutMs": 10000
            }
          ]
        },
        {
          "serverName": "livekit",
          "addresses": [
            {
              "addressName": "primary",
              "baseUrl": "ws://47.106.121.27:19184",
              "timeoutMs": 10000
            }
          ]
        },
        {
          "serverName": "terminal-data-server",
          "addresses": [
            {
              "addressName": "haproxy-entry-one",
              "baseUrl": "ws://47.106.121.27:19190",
              "timeoutMs": 10000
            },
            {
              "addressName": "haproxy-entry-two",
              "baseUrl": "ws://47.106.121.27:19191",
              "timeoutMs": 10000
            }
          ]
        }
      ]
    }
  ]
},
  "scripts": {
    "lint": "node ../../../../../tools/terminal-shared/run-owned-lint.mjs",
    "package:install": "node ../../../../../scripts/build/terminal-update-artifact.mjs --app sample-terminal --kind install",
    "package:full": "node ../../../../../scripts/build/terminal-update-artifact.mjs --app sample-terminal --kind full",
    "package:hot": "node ../../../../../scripts/build/terminal-update-artifact.mjs --app sample-terminal --kind hot",
    "start": "expo start",
    "android": "expo run:android --variant debug",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  }
}
