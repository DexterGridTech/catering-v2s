#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

[[ "${1:-}" == "--operation" && -n "${2:-}" ]] || {
  printf '%s\n' 'BACKEND_ACCEPTANCE_OPERATION_REQUIRED' >&2
  exit 2
}

operation="$2"
shift 2
calibration=false
production_mutation=''
extension_scale_proof=false
topology_preflight=false
v12_diagnostic=false
v8_diagnostic=false
d46_focused=false
tds_contract_scenario=''
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --calibration)
      [[ "$operation" == "all" && "$calibration" == false ]] || {
        printf '%s\n' 'BACKEND_ACCEPTANCE_CALIBRATION_ARGUMENT_INVALID' >&2
        exit 2
      }
      calibration=true
      shift
      ;;
    --production-mutation)
      [[ -z "$production_mutation" && -n "${2:-}" ]] || {
        printf '%s\n' 'BACKEND_ACCEPTANCE_PRODUCTION_MUTATION_ARGUMENT_INVALID' >&2
        exit 2
      }
      production_mutation="$2"
      shift 2
      ;;
    --extension-scale-proof)
      [[ "$operation" == 'typed-filter-validation-and-recovery' && "$extension_scale_proof" == false ]] || {
        printf '%s\n' 'BACKEND_ACCEPTANCE_EXTENSION_SCALE_PROOF_ARGUMENT_INVALID' >&2
        exit 2
      }
      extension_scale_proof=true
      shift
      ;;
    --topology-preflight)
      [[ "$operation" != "all" && "$topology_preflight" == false ]] || {
        printf '%s\n' 'BACKEND_ACCEPTANCE_TOPOLOGY_PREFLIGHT_ARGUMENT_INVALID' >&2
        exit 2
      }
      topology_preflight=true
      shift
      ;;
    --v-s12-diagnostic)
      [[ "$v12_diagnostic" == false ]] || {
        printf '%s\n' 'BACKEND_ACCEPTANCE_VS12_DIAGNOSTIC_ARGUMENT_INVALID' >&2
        exit 2
      }
      v12_diagnostic=true
      shift
      ;;
    --v-s8-diagnostic)
      [[ "$v8_diagnostic" == false ]] || {
        printf '%s\n' 'BACKEND_ACCEPTANCE_VS8_DIAGNOSTIC_ARGUMENT_INVALID' >&2
        exit 2
      }
      v8_diagnostic=true
      shift
      ;;
    --d46-focused)
      [[ "$d46_focused" == false ]] || {
        printf '%s\n' 'BACKEND_ACCEPTANCE_D46_SELECTION_ARGUMENT_INVALID' >&2
        exit 2
      }
      d46_focused=true
      shift
      ;;
    --tds-contract-scenario)
      [[ -z "$tds_contract_scenario" && -n "${2:-}" ]] || {
        printf '%s\n' 'BACKEND_ACCEPTANCE_TDS_CONTRACT_SCENARIO_ARGUMENT_INVALID' >&2
        exit 2
      }
      tds_contract_scenario="$2"
      shift 2
      ;;
    *)
      printf '%s\n' 'BACKEND_ACCEPTANCE_ARGUMENT_INVALID' >&2
      exit 2
      ;;
  esac
done

if [[ -n "$tds_contract_scenario" ]]; then
  case "$tds_contract_scenario" in
    terminal.connection.vs11.secret-search)
      expected_topology_preflight=false
      ;;
    terminal.connection.vs15.readiness-withdrawal-and-drain)
      expected_topology_preflight=true
      ;;
    terminal.connection.history-records)
      expected_topology_preflight=true
      ;;
    terminal.connection.history-outage-bounded)
      expected_topology_preflight=false
      ;;
    terminal.connection.vs13.cross-node-recovery)
      expected_topology_preflight=true
      ;;
    terminal.connection.topic.active-store-subscription)
      expected_topology_preflight=true
      ;;
    terminal.connection.topic.terminal-update-rules)
      expected_topology_preflight=true
      ;;
    terminal.connection.remote-command)
      expected_topology_preflight=true
      ;;
    *)
      printf '%s\n' 'BACKEND_ACCEPTANCE_TDS_CONTRACT_SCENARIO_SCOPE_INVALID' >&2
      exit 2
      ;;
  esac
  [[ "$operation" == 'storeTerminalActivationBusinessPrecedence' && \
     "$topology_preflight" == "$expected_topology_preflight" && \
     "$calibration" == false && -z "$production_mutation" && \
     "$extension_scale_proof" == false && "$v12_diagnostic" == false && \
     "$v8_diagnostic" == false && "$d46_focused" == false ]] || {
    printf '%s\n' 'BACKEND_ACCEPTANCE_TDS_CONTRACT_SCENARIO_SCOPE_INVALID' >&2
    exit 2
  }
fi

if [[ "$topology_preflight" == true && ( "$calibration" == true || "$extension_scale_proof" == true ) ]]; then
  printf '%s\n' 'BACKEND_ACCEPTANCE_TOPOLOGY_PREFLIGHT_ARGUMENT_INVALID' >&2
  exit 2
fi

if [[ -n "$production_mutation" ]]; then
  [[ "$production_mutation" == 'extension-definition-second-field-status' || \
     "$production_mutation" == 'tds-registration-pending-generation-check' ]] || {
    printf '%s\n' 'BACKEND_ACCEPTANCE_PRODUCTION_MUTATION_UNKNOWN' >&2
    exit 2
  }
  [[ "$calibration" == false ]] || {
    printf '%s\n' 'BACKEND_ACCEPTANCE_PRODUCTION_MUTATION_CALIBRATION_INVALID' >&2
    exit 2
  }
  if [[ "$production_mutation" == 'extension-definition-second-field-status' ]]; then
    [[ "$operation" == 'pagination.extension-definition-aggregate-closure' || "$operation" == 'extensionDefinitionAggregateClosure' ]] || {
      printf '%s\n' 'BACKEND_ACCEPTANCE_PRODUCTION_MUTATION_OPERATION_INVALID' >&2
      exit 2
    }
    [[ "$topology_preflight" == false ]] || {
      printf '%s\n' 'BACKEND_ACCEPTANCE_TOPOLOGY_PREFLIGHT_ARGUMENT_INVALID' >&2
      exit 2
    }
  else
    [[ "$operation" == 'storeTerminalActivationBusinessPrecedence' && "$topology_preflight" == true ]] || {
      printf '%s\n' 'BACKEND_ACCEPTANCE_PRODUCTION_MUTATION_OPERATION_INVALID' >&2
      exit 2
    }
  fi
fi

if [[ "$extension_scale_proof" == true && "$calibration" == true ]]; then
  printf '%s\n' 'BACKEND_ACCEPTANCE_EXTENSION_SCALE_PROOF_CALIBRATION_INVALID' >&2
  exit 2
fi

if [[ "$v12_diagnostic" == true && ( "$operation" != 'storeTerminalActivationBusinessPrecedence' || "$calibration" == true || "$production_mutation" != '' || "$extension_scale_proof" == true || "$topology_preflight" == true ) ]]; then
  printf '%s\n' 'BACKEND_ACCEPTANCE_VS12_DIAGNOSTIC_ARGUMENT_INVALID' >&2
  exit 2
fi

if [[ "$v8_diagnostic" == true && ( "$operation" != 'storeTerminalActivationBusinessPrecedence' || "$calibration" == true || "$production_mutation" != '' || "$extension_scale_proof" == true || "$topology_preflight" == true || "$v12_diagnostic" == true ) ]]; then
  printf '%s\n' 'BACKEND_ACCEPTANCE_VS8_DIAGNOSTIC_ARGUMENT_INVALID' >&2
  exit 2
fi

if [[ "$d46_focused" == true && ( "$calibration" == true || "$production_mutation" != '' || "$extension_scale_proof" == true || "$topology_preflight" == true || "$v12_diagnostic" == true || "$v8_diagnostic" == true ) ]]; then
  printf '%s\n' 'BACKEND_ACCEPTANCE_D46_SELECTION_ARGUMENT_INVALID' >&2
  exit 2
fi

if [[ "$calibration" == true ]]; then
  case "${V2S_BACKEND_ACCEPTANCE_BATCH_CARDINALITY:-}" in
    1|20|100) ;;
    *)
      printf '%s\n' 'BACKEND_ACCEPTANCE_CALIBRATION_BATCH_CARDINALITY_REQUIRED' >&2
      exit 2
      ;;
  esac
fi

export V2S_BACKEND_ACCEPTANCE_OPERATION="$operation"
export V2S_BACKEND_ACCEPTANCE_TOPOLOGY_PREFLIGHT="$topology_preflight"
if [[ -n "$tds_contract_scenario" ]]; then
  export V2S_BACKEND_ACCEPTANCE_TDS_CONTRACT_SCENARIO="$tds_contract_scenario"
else
  unset V2S_BACKEND_ACCEPTANCE_TDS_CONTRACT_SCENARIO
fi
if [[ "$v12_diagnostic" == true ]]; then
  export V2S_BACKEND_ACCEPTANCE_VS12_DIAGNOSTIC=true
  export V2S_BACKEND_ACCEPTANCE_VERIFICATION_MODE=ACCEPTANCE
  export V2S_R5_TRACE_SYSTEM_SIGNALS=true
  unset V2S_R5_TRACE_CHILD_SIGNALS
else
  unset V2S_BACKEND_ACCEPTANCE_VS12_DIAGNOSTIC
fi
if [[ "$v8_diagnostic" == true ]]; then
  export V2S_BACKEND_ACCEPTANCE_VS8_DIAGNOSTIC=true
  export V2S_BACKEND_ACCEPTANCE_VERIFICATION_MODE=ACCEPTANCE
else
  unset V2S_BACKEND_ACCEPTANCE_VS8_DIAGNOSTIC
fi
if [[ "$calibration" == true ]]; then
  export V2S_BACKEND_ACCEPTANCE_VERIFICATION_MODE=CALIBRATION
fi

runner_arguments=(:apps:backend:catering-business-server:test)
if [[ "$d46_focused" == true ]]; then
  if [[ "$operation" != 'all' ]]; then
    runner_arguments+=(--tests com.catering.v2s.app.acceptance.BackendAcceptanceTest)
  fi
  runner_arguments+=(--tests com.catering.v2s.app.acceptance.BackendAcceptanceTest.terminalConnectionCompressionContracts)
  runner_arguments+=(--tests com.catering.v2s.app.edge.generated.wire.TerminalActivationSecretToStringTest)
  export V2S_BACKEND_ACCEPTANCE_D46_FOCUSED=true
  if [[ "$operation" == 'all' ]]; then
    export V2S_BACKEND_ACCEPTANCE_OPERATION=all
    export V2S_BACKEND_ACCEPTANCE_TDS_CONTRACT_ONLY=true
  else
    unset V2S_BACKEND_ACCEPTANCE_TDS_CONTRACT_ONLY
  fi
  export V2S_BACKEND_ACCEPTANCE_VERIFICATION_MODE=ACCEPTANCE
  printf '%s\n' 'BACKEND_ACCEPTANCE_D46_SELECTION=V-S14_AND_WIRE_SECRET_UNIT'
else
  unset V2S_BACKEND_ACCEPTANCE_TDS_CONTRACT_ONLY
  unset V2S_BACKEND_ACCEPTANCE_D46_FOCUSED
  runner_arguments+=(--tests com.catering.v2s.app.acceptance.BackendAcceptanceTest)
fi
if [[ -n "$production_mutation" ]]; then
  runner_arguments+=(--production-mutation "$production_mutation")
fi
if [[ "$extension_scale_proof" == true ]]; then
  runner_arguments+=(--extension-scale-proof)
fi
V2S_BACKEND_ACCEPTANCE_EXECUTION=true exec node "$REPO_ROOT/scripts/test/r5-remote-testcontainers.mjs" "${runner_arguments[@]}"
