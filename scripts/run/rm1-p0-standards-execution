#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "$0")/../.." && pwd)"
run_id="rm1-p0-standards-$(date -u +%Y%m%dT%H%M%SZ)-$$"
run_dir="$root_dir/.runtime/managed-runs/$run_id"
manifest_path="$run_dir/manifest.json"
log_path="$run_dir/standards-execution.log"
execution_results_path="$run_dir/execution-results.jsonl"
business_status="NOT_APPLICABLE"
standards_execution_status="PENDING"
cleanup_status="PENDING"
execution_failed=0
execution_results=()

mkdir -p "$run_dir"
: > "$execution_results_path"

run_checked() {
  local kind="$1"
  local ref="$2"
  shift 2
  set +e
  "$@" 2>&1 | tee -a "$log_path"
  local statuses=("${PIPESTATUS[@]}")
  set -e
  local exit_code="${statuses[0]}"
  if [[ "$exit_code" -eq 0 && "${statuses[1]}" -ne 0 ]]; then exit_code="${statuses[1]}"; fi
  execution_results+=("$kind|$ref|$exit_code")
  printf '%s|%s|%s\n' "$kind" "$ref" "$exit_code" >> "$execution_results_path"
  if [[ "$exit_code" -ne 0 ]]; then execution_failed=1; fi
  return 0
}

if [[ "${1:-}" == "--self-test" ]]; then
  run_checked "FIXTURE" "first-failure" false
  run_checked "FIXTURE" "last-success" true
  if [[ "$execution_failed" -ne 1 || "${execution_results[0]}" != "FIXTURE|first-failure|1" || "${execution_results[1]}" != "FIXTURE|last-success|0" ]]; then
    printf 'RM1_P0_RUNNER_SELF_TEST=FAIL\n' >&2
    rm -rf "$run_dir"
    exit 1
  fi
  rm -rf "$run_dir"
  printf 'RM1_P0_RUNNER_FIRST_FAILURE_RED=PASS\nRM1_P0_RUNNER_LAST_FAILURE_CONTROL=PASS\nRM1_P0_RUNNER_SELF_TEST=PASS\n'
  exit 0
fi

execution_sets="$(node - "$root_dir" <<'NODE'
const fs = require('fs');
const path = require('path');
const root = process.argv[2];
const active = JSON.parse(fs.readFileSync(path.join(root, '.runtime/compliance-control/active-package.json'), 'utf8'));
if (active.packageId !== 'RM1-U01' || typeof active.executionBindingPath !== 'string') throw new Error('RM1_P0_EXECUTION_BINDING_INVALID');
const binding = JSON.parse(fs.readFileSync(path.join(root, active.executionBindingPath), 'utf8'));
const valid = (refs) => Array.isArray(refs) && refs.length > 0 && new Set(refs).size === refs.length && refs.every((ref) => typeof ref === 'string' && ref.startsWith('scripts/check/'));
if (!valid(binding.requiredStandardsRefs) || !valid(binding.requiredControlRefs)) throw new Error('RM1_P0_EXECUTION_REF_SET_INVALID');
process.stdout.write(`${binding.requiredStandardsRefs.join(',')}\n${binding.requiredControlRefs.join(',')}\n`);
NODE
)"
standards_refs="${execution_sets%%$'\n'*}"
control_refs="${execution_sets#*$'\n'}"
control_refs="${control_refs%%$'\n'*}"
if [[ -z "$standards_refs" || -z "$control_refs" ]]; then
  printf 'RM1_P0_STANDARDS_PREREQUISITE=EXECUTION_REF_SET_INVALID; RUN_ID=%s; RUN_DIR=%s\n' "$run_id" "$run_dir" >&2
  exit 2
fi

docker_ids() {
  docker ps -aq --filter label=org.testcontainers | sort
}

before_ids=""
write_manifest() {
  node - "$manifest_path" "$run_id" "$business_status" "$standards_execution_status" "$cleanup_status" "$before_ids" "$(docker_ids)" "$standards_refs" "$control_refs" "$execution_results_path" <<'NODE'
const fs = require('fs');
const [manifestPath, runId, business, standardsExecution, cleanup, before, after, standardsRefs, controlRefs, resultsPath] = process.argv.slice(2);
const split = (value) => value ? value.split('\n').filter(Boolean) : [];
const rows = fs.readFileSync(resultsPath, 'utf8').split('\n').filter(Boolean).map((row) => {
  const [kind, ref, rawExitCode] = row.split('|');
  return { kind, ref, exitCode: Number(rawExitCode) };
});
const controlRefStatus = rows.filter((row) => row.kind === 'STANDARDS_REF' || row.kind === 'CONTROL_REF');
fs.writeFileSync(manifestPath, `${JSON.stringify({
  schemaVersion: 2,
  kind: 'rm1-p0-standards-execution',
  runId,
  status: 'STOPPED',
  command: 'P0 exact standards/control production execution with independent per-reference exit capture',
  requiredStandardsRefs: standardsRefs.split(','),
  requiredControlRefs: controlRefs.split(','),
  business: { status: business },
  standardsExecution: { status: standardsExecution },
  controlRefStatus,
  executionSteps: rows,
  cleanup: { status: cleanup, testcontainersBefore: split(before), testcontainersAfter: split(after) }
}, null, 2)}\n`);
NODE
}

if ! docker info >/dev/null 2>&1; then
  standards_execution_status="NOT_RUN"
  cleanup_status="NOT_APPLICABLE"
  write_manifest
  printf 'RM1_P0_STANDARDS_PREREQUISITE=DOCKER_ENGINE_UNAVAILABLE; RUN_ID=%s; RUN_DIR=%s\n' "$run_id" "$run_dir" >&2
  exit 2
fi

before_ids="$(docker_ids)"
cleanup() {
  set +e
  local after_ids
  after_ids="$(docker_ids)"
  if [[ "$before_ids" == "$after_ids" ]]; then cleanup_status="PASS"; else cleanup_status="FAIL"; fi
  write_manifest
  printf 'RM1_P0_CLEANUP=%s; RUN_ID=%s; RUN_DIR=%s\n' "$cleanup_status" "$run_id" "$run_dir"
}
trap cleanup EXIT

IFS=',' read -r -a standards_ref_items <<< "$standards_refs"
IFS=',' read -r -a control_ref_items <<< "$control_refs"
printf 'RM1_P0_STANDARDS_EXECUTION=START; RUN_ID=%s\n' "$run_id"
run_checked "STRUCTURE" "R5" "$root_dir/scripts/check/standards-coverage" --phase R5
run_checked "SELF_TEST" "scripts/check/standards-coverage" "$root_dir/scripts/check/standards-coverage" --self-test
for standards_ref in "${standards_ref_items[@]}"; do
  run_checked "STANDARDS_REF" "$standards_ref" "$root_dir/scripts/check/standards-coverage" --phase R5 --execute-active --refs "$standards_ref"
done
for control_ref in "${control_ref_items[@]}"; do
  run_checked "CONTROL_REF" "$control_ref" "$root_dir/$control_ref"
  run_checked "SELF_TEST" "$control_ref" "$root_dir/$control_ref" --self-test
done
for standards_ref in "${standards_ref_items[@]}"; do
  run_checked "SELF_TEST" "$standards_ref" "$root_dir/$standards_ref" --self-test
done

if [[ "$execution_failed" -eq 0 ]]; then
  standards_execution_status="PASS"
  printf 'RM1_P0_STANDARDS_EXECUTION=PASS; RUN_ID=%s\n' "$run_id"
else
  standards_execution_status="FAIL"
  printf 'RM1_P0_STANDARDS_EXECUTION=FAIL; RUN_ID=%s\n' "$run_id" >&2
  exit 1
fi
