#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "$0")/../.." && pwd)"
if [[ "${1:-}" != "--profile" || -z "${2:-}" ]]; then
  echo "SEED=REFUSED; REASON=EXPLICIT_PROFILE_REQUIRED" >&2
  exit 2
fi
profile="$2"
if [[ "$profile" == "catalog-inventory" ]]; then
  echo "SEED=REFUSED; REASON=PARTIAL_PROFILE_IS_INTERNAL; USE_PROFILE=r5-full" >&2
  exit 2
fi
if [[ "$profile" != "r5-full" ]]; then
  echo "SEED=REFUSED; REASON=UNKNOWN_PROFILE" >&2
  exit 2
fi
if [[ "${3:-}" == "--dry-run" ]]; then
  exec node "$root_dir/scripts/dev/r5-complete-seed-executor.mjs" --dry-run
fi
if [[ "${R5_SEED_CONFIRMATION:-}" != "EXPLICIT_R5_SEED" ]]; then
  echo "R5_SEED=REFUSED; REASON=EXPLICIT_R5_SEED_CONFIRMATION_REQUIRED" >&2
  exit 2
fi
exec node "$root_dir/scripts/dev/r5-complete-seed-executor.mjs"
