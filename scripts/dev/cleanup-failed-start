#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "$0")/../.." && pwd)"
runtime_dir="${V2S_RUNTIME_DIR:-$root_dir/.runtime/r5}"

if [[ "$#" -ne 1 || ! "$1" =~ ^r5-dev-[0-9]+-[0-9]+-[a-f0-9-]{36}$ ]]; then
  echo "R5_DEV_FAILED_START_CLEANUP=REFUSED; REASON=RUN_ID_INVALID" >&2
  exit 2
fi

export V2S_RUNTIME_DIR="$runtime_dir"
exec node "$root_dir/scripts/dev/r5-dev-runner.mjs" cleanup-failed-start "$1"
