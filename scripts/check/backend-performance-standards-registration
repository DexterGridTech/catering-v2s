#!/usr/bin/env node

import crypto from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import {fileURLToPath} from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
const sourcePath = "project-memory/decisions/http-crud-efficiency-design-redlines.md";
const registrationPath = "contracts/policy/backend-performance-standards-registration.json";
const declarations = [
  ["ONE_REQUEST_ONE_TRANSACTION_ORIGIN", "BPF-U01-RED:TRANSACTION_ORIGIN", "one request has one transaction origin"],
  ["REQUEST_LOCAL_FACT_LOADED_ONCE", "BPF-U03-RED:FACT_LOADER_DUPLICATE", "one request-local fact loader declaration"],
  ["OPERATION_DATABASE_SHAPE_DECLARED", "BPF-U04-RED:SHAPE_FOLD_OR_BUDGET", "one source-anchored operation shape declaration"],
];

function hash(value) { return crypto.createHash("sha256").update(value).digest("hex"); }
function read(relative) { return fs.readFileSync(path.join(root, relative), "utf8"); }
function pretty(value) { return JSON.stringify(value, null, 2); }
function fail(code, detail = "") {
  const diagnostics = " WHY=the permanent BPF redline registration is missing or not bound to its source and gate; BACKGROUND=Heritage standards coverage is immutable and these current implementation controls need a separate exact source registration; PATTERN=remove/substitute one redline or mutation and the registration must red";
  throw new Error(code + (detail ? ":" + detail : "") + diagnostics);
}
function writeJson(relative, value) {
  const absolute = path.join(root, relative);
  fs.mkdirSync(path.dirname(absolute), {recursive: true});
  fs.writeFileSync(absolute, pretty(value) + "\n");
}
function exactSet(actual, expected, code) {
  const a = actual.slice().sort();
  const e = expected.slice().sort();
  if (a.length !== e.length || new Set(a).size !== a.length || a.some((value, index) => value !== e[index])) fail(code);
}
function build() {
  const source = read(sourcePath);
  const lines = source.split("\n");
  const rows = declarations.map(([controlId, redMutation, purpose]) => {
    const exactRuleText = lines.find((line) => line.startsWith("- `" + controlId + "`:"));
    if (!exactRuleText) fail("BPF_STANDARDS_REDLINE_MISSING", controlId);
    return {
      controlId,
      exactRuleText,
      textSha256: hash(exactRuleText),
      enforcement: {
        kind: "GATE",
        ref: controlId === "REQUEST_LOCAL_FACT_LOADED_ONCE" ? "scripts/check/backend-performance-request-fact-load-once" : "scripts/check/backend-performance-operation-database-shape",
        status: "ACTIVE",
        enforcementPhase: "R5",
      },
      realRedMutation: {id: redMutation, purpose, evidence: "checker --self-test"},
    };
  });
  return {
    schemaVersion: 1,
    kind: "backend-performance-standards-registration",
    status: "ACTIVE_STATIC",
    source: {path: sourcePath, sha256: hash(source), parser: "EXACT_REDLINE_LINES_V1"},
    controls: rows,
    heritageStandardsCoverage: {path: "contracts/policy/standards-coverage-matrix.json", status: "UNCHANGED_FROZEN_SOURCE_DENOMINATOR", note: "This supplemental registration does not mutate the Heritage structural standards denominator."},
  };
}
function validateStructure(actual, expected) {
  if (!actual || actual.schemaVersion !== 1 || actual.kind !== "backend-performance-standards-registration" || actual.status !== "ACTIVE_STATIC") fail("BPF_STANDARDS_REGISTRATION_HEADER_INVALID");
  if (!actual.source || actual.source.path !== sourcePath || actual.source.sha256 !== expected.source.sha256 || actual.source.parser !== "EXACT_REDLINE_LINES_V1") fail("BPF_STANDARDS_SOURCE_BINDING_DRIFT");
  if (!Array.isArray(actual.controls) || actual.controls.length !== declarations.length) fail("BPF_STANDARDS_CONTROL_DENOMINATOR_DRIFT");
  exactSet(actual.controls.map((row) => row?.controlId), declarations.map((row) => row[0]), "BPF_STANDARDS_CONTROL_SET_DRIFT");
  for (const row of actual.controls) {
    const expectedRow = expected.controls.find((entry) => entry.controlId === row.controlId);
    if (!expectedRow || row.exactRuleText !== expectedRow.exactRuleText || row.textSha256 !== expectedRow.textSha256) fail("BPF_STANDARDS_REDLINE_SOURCE_DRIFT", row?.controlId || "UNSET");
    const expectedEnforcementRef = row.controlId === "REQUEST_LOCAL_FACT_LOADED_ONCE" ? "scripts/check/backend-performance-request-fact-load-once" : "scripts/check/backend-performance-operation-database-shape";
    if (row.enforcement?.kind !== "GATE" || row.enforcement.ref !== expectedEnforcementRef || row.enforcement.status !== "ACTIVE" || row.enforcement.enforcementPhase !== "R5") fail("BPF_STANDARDS_ENFORCEMENT_DRIFT", row.controlId);
    if (!row.realRedMutation || typeof row.realRedMutation.id !== "string" || typeof row.realRedMutation.purpose !== "string" || row.realRedMutation.evidence !== "checker --self-test") fail("BPF_STANDARDS_RED_MUTATION_EVIDENCE_MISSING", row.controlId);
  }
}
function validateExact(actual, expected) {
  validateStructure(actual, expected);
  if (pretty(actual) !== pretty(expected)) fail("BPF_STANDARDS_REGISTRATION_ARTIFACT_DRIFT");
}
function selfTest() {
  const expected = build();
  validateExact(expected, expected);
  const missing = structuredClone(expected);
  missing.controls.pop();
  try { validateStructure(missing, expected); fail("BPF_STANDARDS_RED_NOT_DETECTED", "missing-control"); }
  catch (error) { if (!String(error.message).startsWith("BPF_STANDARDS_CONTROL_DENOMINATOR_DRIFT")) throw error; }
  const substituted = structuredClone(expected);
  substituted.controls[0].exactRuleText = substituted.controls[1].exactRuleText;
  try { validateStructure(substituted, expected); fail("BPF_STANDARDS_RED_NOT_DETECTED", "substituted-source"); }
  catch (error) { if (!String(error.message).startsWith("BPF_STANDARDS_REDLINE_SOURCE_DRIFT")) throw error; }
  const mutation = structuredClone(expected);
  delete mutation.controls[2].realRedMutation;
  try { validateStructure(mutation, expected); fail("BPF_STANDARDS_RED_NOT_DETECTED", "missing-red-mutation"); }
  catch (error) { if (!String(error.message).startsWith("BPF_STANDARDS_RED_MUTATION_EVIDENCE_MISSING")) throw error; }
  process.stdout.write("BPF_STANDARDS_REGISTRATION_SELF_TEST=PASS\nRED_MISSING_CONTROL=PASS\nRED_SOURCE_SUBSTITUTION=PASS\nRED_MUTATION_EVIDENCE=PASS\nCLEANUP=PASS\n");
}
function main() {
  const argument = process.argv[2];
  const expected = build();
  if (argument === "--write") { writeJson(registrationPath, expected); process.stdout.write("BPF_STANDARDS_REGISTRATION_WRITE=PASS\nCONTROLS=3\n"); }
  else if (argument === "--check") { validateExact(JSON.parse(read(registrationPath)), expected); process.stdout.write("BPF_STANDARDS_REGISTRATION_CHECK=PASS\nCONTROLS=3\nREDLINES=3\n"); }
  else if (argument === "--self-test") selfTest();
  else fail("BPF_STANDARDS_REGISTRATION_ARGUMENT_INVALID");
}
try { main(); } catch (error) { process.stderr.write(String(error && error.message ? error.message : error) + "\n"); process.exitCode = 1; }
