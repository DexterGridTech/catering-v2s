function fail(code, detail = "") {
  const [why, background, pattern] = diagnostics[code] ?? [
    "an M1 F06 authorization-topology invariant failed",
    "each operations command must preserve a typed authorization path without generic dispatch or cross-owner scope leakage",
    "repair the declared matrix/source relationship and rerun this mandatory gate; do not bypass it",
  ];
  throw new Error(`${code}: WHY=${why}; BACKGROUND=${background}; PATTERN=${pattern}${detail ? `; DETAIL=${detail}` : ""}`);
}

function sameKeys(value, expected) {
  return value && JSON.stringify(Object.keys(value).sort()) === JSON.stringify(expected);
}

function nonEmptySourceFact(value) {
  return typeof value === "string" && value.length > 0 && !value.includes("UNRESOLVED_REQUIRES_SOURCE");
}

function validateResolverSource() {
  const source = fs.readFileSync(resolverPath, "utf8");
  if (!/WorkspaceExecutionContext<CatalogAuthorizationScope>\s+resolveCatalog\s*\(/.test(source)
      || !/WorkspaceCommandAuthorizationFacts\s+resolveOperations\s*\(/.test(source)
      || !/WorkspaceCommandAuthorizationFacts\s+resolveOperationsAtContextVersion\s*\(/.test(source)) {
    fail("BP_U07_M1_F06_RESOLVER_SOURCE_INVALID", path.relative(root, resolverPath));
  }
}

function validateF06(matrix) {
  if (matrix?.schemaVersion !== 1 || matrix.kind !== "backend-performance-m1-command-execution-matrix" || !Array.isArray(matrix.rows) || matrix.rows.length !== 68) {
    fail("BP_U07_M1_F06_INPUT_INVALID");
  }
  validateResolverSource();
  const catalogRows = matrix.rows.filter((row) => row?.routeRegistry === "catalog-inventory");
  const operationsRows = matrix.rows.filter((row) => row?.routeRegistry === "edge-face");
  if (catalogRows.length !== 26 || operationsRows.length !== 42 || catalogRows.length + operationsRows.length !== matrix.rows.length) {
    fail("BP_U07_M1_F06_PARTITION_INVALID", `catalog=${catalogRows.length};operations=${operationsRows.length}`);
  }
  for (const row of catalogRows) {
    const context = row.context;
    if (!sameKeys(context, catalogContextKeys)) fail("BP_U07_M1_CATALOG_CONTEXT_VOCABULARY_INVALID", row.operationId);
    if (context.resolverFqcn !== resolverFqcn || context.resolverVariant !== "DECLARED_TYPED_COMMAND_RESOLUTION"
        || context.sourceAnchor !== `${resolverSourceAnchor}#resolveCatalog`) {
      fail("BP_U07_M1_CATALOG_RESOLVER_INVALID", row.operationId);
    }
  }
  let direct = 0;
  let versioned = 0;
  for (const row of operationsRows) {
    const context = row.context;
    if (!sameKeys(context, operationsContextKeys)) fail("BP_U07_M1_NON_CATALOG_CONTEXT_VOCABULARY_INVALID", row.operationId);
    if (context.resolverFqcn !== resolverFqcn || context.resolverVariant !== "WORKSPACE_COMMAND_AUTHORIZATION_FACTS"
        || context.contextFactsFqcn !== factsFqcn || context.negativeCatalogScope !== true) {
      fail("BP_U07_M1_NON_CATALOG_FACTS_INVALID", row.operationId);
    }
    if (context.contextResolverMethod === "resolveCatalog" || context.sourceAnchor.includes("resolveCatalog")
        || Object.entries(context).some(([key, value]) => key !== "negativeCatalogScope"
          && /CatalogAuthorizationScope|CatalogScopeLookup|CatalogInventoryWorkspaceCommandTokens|CatalogBrand|copyRole|copySource/.test(`${key}:${value}`))) {
      fail("BP_U07_M1_NON_CATALOG_CATALOG_RESOLVER_FORBIDDEN", row.operationId);
    }
    const isDirect = context.contextResolverMethod === "resolveOperations"
      && context.contextVersionPolicy === "NO_EXPLICIT_CONTEXT_VERSION_CHECK";
    const isVersioned = context.contextResolverMethod === "resolveOperationsAtContextVersion"
      && context.contextVersionPolicy === "BODY_REQUIRED_EXACT_MATCH";
    if (!isDirect && !isVersioned || context.sourceAnchor !== `${resolverSourceAnchor}#${context.contextResolverMethod}`) {
      fail("BP_U07_M1_NON_CATALOG_RESOLVER_CONTEXT_PAIRING_INVALID", row.operationId);
    }
    direct += Number(isDirect);
    versioned += Number(isVersioned);
    for (const field of ["sessionCredentialSource", "groupWorkspaceKeySource", "requirementId", "targetSelectionKind", "targetSelectionSourceAnchor", "targetResourceType", "targetResourceValueSource", "idempotencyPolicy", "readbackProducer", "readbackMapper"]) {
      if (!nonEmptySourceFact(context[field])) fail("BP_U07_M1_NON_CATALOG_REQUIRED_FACT_INVALID", `${row.operationId}:${field}`);
    }
  }
  if (direct !== 32 || versioned !== 10) fail("BP_U07_M1_NON_CATALOG_RESOLVER_CONTEXT_PAIRING_INVALID", `resolveOperations=${direct};resolveOperationsAtContextVersion=${versioned}`);
  return {catalog: catalogRows.length, operations: operationsRows.length, direct, versioned};
}

function revokeSourceIsRecheckedBeforeReceipt() {
  const source = fs.readFileSync(path.join(root, revokeOwnerSourcePath), "utf8");
  const start = source.indexOf("revokeAssignmentForOperations(");
  const end = source.indexOf("\n    private void audit", start);
  const body = start >= 0 && end > start ? source.slice(start, end) : "";
  const target = body.indexOf("AssignmentTarget target =");
  const recheck = body.indexOf("commandAuthorization.requireUserManagementAction(");
  const receipt = body.indexOf("receipts.execute(");
  return target >= 0 && target < recheck && recheck < receipt;
}

function validateReceiptPolicies(matrix) {
  let normal = 0;
  let bodyBound = 0;
  for (const row of matrix.rows) {
    const isCatalog = row.routeRegistry === "catalog-inventory";
    const policy = isCatalog ? row.ownerInvocation?.idempotencyPolicy : row.context?.idempotencyPolicy;
    const policyOnWrongField = isCatalog ? "idempotencyPolicy" in (row.context ?? {}) : "idempotencyPolicy" in (row.ownerInvocation ?? {});
    if (!policy || policy === "HEADER_IDEMPOTENCY_KEY_REQUIRED") fail("BP_U07_M1_RECEIPT_POLICY_MISSING_OR_WEAK", row.operationId);
    if (policyOnWrongField) fail("BP_U07_M1_RECEIPT_POLICY_PARTITION_INVALID", row.operationId);
    const invitation = invitationOperationIds.has(row.operationId);
    if (policy !== (invitation ? ownerReceiptBodyPolicy : ownerReceiptPolicy)) fail("BP_U07_M1_RECEIPT_POLICY_PARTITION_INVALID", row.operationId);
    normal += Number(policy === ownerReceiptPolicy);
    bodyBound += Number(policy === ownerReceiptBodyPolicy);
    if (revokeOperationIds.has(row.operationId)) {
      const invocation = row.ownerInvocation;
      const expectedParameterKeys = ["workspaceUuid", "groupWorkspaceKey", "actorAssignmentId", "expectedTargetType", "assignmentId", "expectedVersion", "idempotencyKey", "actor"];
      if (policy !== ownerReceiptPolicy || invocation?.kind !== "TYPED_OWNER_API" || invocation.sourceAnchor !== revokeTypedOwnerSourceAnchor
          || invocation.receiptSourceAnchor !== revokeOwnerSourceAnchor || invocation.receiptReplayOrder !== "OWNER_RECHECK_BEFORE_RECEIPT_REPLAY"
          || JSON.stringify(Object.keys(invocation.parameterMapping ?? {}).sort()) !== JSON.stringify(expectedParameterKeys.sort())) {
        fail("BP_U07_M1_REVOKE_RECEIPT_RECHECK_INVALID", row.operationId);
      }
    }
  }
  if (normal !== 53 || bodyBound !== 15 || !revokeSourceIsRecheckedBeforeReceipt()) {
    fail("BP_U07_M1_REVOKE_RECEIPT_RECHECK_INVALID", `normal=${normal};headerAndBody=${bodyBound}`);
  }
  return {normal, bodyBound};
}

const f07TypedOwnerBoundaryOperationIds = new Set([
