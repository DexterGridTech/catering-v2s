#!/usr/bin/env node

import {createHash} from "node:crypto";
import {readFileSync} from "node:fs";
import path from "node:path";
import {fileURLToPath} from "node:url";
import {createFinalWorkloadRecipes} from "../test/backend-performance-workload.mjs";
import {loadFinalFixtureCatalog, validateFinalFixtureCatalog, validateFixtureCatalogAgainstRecipes} from "../test/backend-performance-final-fixtures.mjs";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
const paths = {
  bindings: "contracts/registry/operation-handler-bindings.json",
  inventory: "contracts/registry/backend-performance-operation-source-inventory.json",
  shape: "contracts/registry/backend-performance-operation-database-shape-matrix.json",
  loaders: "contracts/registry/backend-performance-fact-loader-catalog.json",
  fixture: "contracts/policy/backend-performance-final-fixture-catalog.json",
  plan: "contracts/policy/backend-performance-testcontainers-plan.json",
  standards: "contracts/policy/backend-performance-standards-registration.json",
  redlines: "project-memory/decisions/http-crud-efficiency-design-redlines.md",
};
const diagnostics = " WHY=the 196-row static backend performance denominator is not reconciled across source, shape, loader, fixture, plan or permanent redline evidence; BACKGROUND=dynamic Testcontainers, local L2, reset and seed are forbidden until this exact closure passes; PATTERN=missing/substituted operation, source digest, loader, acceptance, red discriminator, scenario membership or redline must red";
const fail = (code, detail = "") => { throw new Error(`${code}${detail ? `:${detail}` : ""}${diagnostics}`); };
const read = (relative) => { try { return readFileSync(path.join(root, relative), "utf8"); } catch { fail("BP_U07_RECONCILIATION_INPUT_MISSING", relative); } };
const json = (relative) => { try { return JSON.parse(read(relative)); } catch { fail("BP_U07_RECONCILIATION_INPUT_INVALID", relative); } };
const hash = (value) => createHash("sha256").update(value).digest("hex");
const exactSet = (actual, expected, code) => { const a = [...actual].sort(); const e = [...expected].sort(); if (a.length !== e.length || new Set(a).size !== a.length || a.some((value, index) => value !== e[index])) fail(code); };
const digest = (value) => hash(JSON.stringify(value));
const prettyDigest = (value) => hash(JSON.stringify(value, null, 2));

function validatePlan(plan, fixtureRows) {
  if (plan?.schemaVersion !== 1 || plan.kind !== "backend-performance-testcontainers-plan" || plan.status !== "STATIC_PLAN_DECLARED_NOT_EXECUTED" || plan.reportKind !== "REMOTE_TESTCONTAINERS") fail("BP_U07_RECONCILIATION_PLAN_CONTRACT_DRIFT");
  if (plan.denominator?.operations !== 196 || plan.denominator?.scenarios !== 14 || plan.denominator?.sourceRows !== 196 || plan.denominator?.shapeRows !== 196 || plan.denominator?.loaders !== 10) fail("BP_U07_RECONCILIATION_PLAN_DENOMINATOR_DRIFT");
  if (plan.scenarioGrouping?.kind !== "FIXTURE_PLAN_FAMILY" || plan.scenarioGrouping?.sourceField !== "rows[].fixturePlan.familyId" || plan.scenarioGrouping?.groupingDoesNotRelaxCoverage !== true) fail("BP_U07_RECONCILIATION_PLAN_GROUPING_DRIFT");
  const requiredFields = plan.reportContract?.requiredFields ?? [];
  const operationFields = plan.reportContract?.operationRowFields ?? [];
  for (const field of ["reportKind", "testPlanId", "fixtureCatalogSha256", "sourceInventorySha256", "shapeMatrixSha256", "measurement", "operationIds", "apiEndpoints", "kindCounts", "business", "cleanup"]) if (!requiredFields.includes(field)) fail("BP_U07_RECONCILIATION_PLAN_REPORT_CONTRACT_DRIFT", field);
  for (const field of ["operationId", "requestId", "correlationId", "databaseOperationCount", "kindCounts", "UPDATE"]) if (!operationFields.includes(field)) fail("BP_U07_RECONCILIATION_PLAN_OPERATION_CONTRACT_DRIFT", field);
  const families = new Set(fixtureRows.map((row) => row.fixturePlan?.familyId));
  if (families.has(undefined) || families.size !== 14) fail("BP_U07_RECONCILIATION_PLAN_SCENARIO_DENOMINATOR_DRIFT");
  return {scenarioCount: families.size};
}

function validateRedlines(standards) {
  if (standards?.schemaVersion !== 1 || standards.kind !== "backend-performance-standards-registration" || !Array.isArray(standards.controls) || standards.controls.length !== 3) fail("BP_U07_RECONCILIATION_STANDARDS_DENOMINATOR_DRIFT");
  const source = read(paths.redlines);
  const expected = [
    ["ONE_REQUEST_ONE_TRANSACTION_ORIGIN", "7db0caedf3bdb4e446d7f6aea400fa4ad6d81322b370183829757016b309e313"],
    ["REQUEST_LOCAL_FACT_LOADED_ONCE", "57877adae19dcb9c683070d03ec66052b9018e9c9dac7ac060d5960d3095be99"],
    ["OPERATION_DATABASE_SHAPE_DECLARED", "28827301508ec3e331d7cd92d436d32a86770a5f6e2ca97888c6e02310f82941"],
  ];
  for (const [id, textHash] of expected) {
    const control = standards.controls.find((row) => row.controlId === id);
    if (!control || !source.includes(control.exactRuleText) || !/^[a-f0-9]{64}$/.test(control.textSha256) || hash(control.exactRuleText) !== control.textSha256) fail("BP_U07_RECONCILIATION_REDLINE_DRIFT", id);
    if (id === "OPERATION_DATABASE_SHAPE_DECLARED" && control.textSha256 !== "28827301508ec3e331d7cd92d436d32a86770a5f6e2ca97888c6e02310f82941") fail("BP_U07_RECONCILIATION_REDLINE_DRIFT", id);
    if (id !== "OPERATION_DATABASE_SHAPE_DECLARED" && control.textSha256 !== textHash) fail("BP_U07_RECONCILIATION_REDLINE_DRIFT", id);
  }
}

export function reconcileStatic196({bindings = json(paths.bindings), inventory = json(paths.inventory), shape = json(paths.shape), loaders = json(paths.loaders), fixture = loadFinalFixtureCatalog(), plan = json(paths.plan), standards = json(paths.standards)} = {}) {
  if (!Array.isArray(bindings.operations) || bindings.operations.length !== 196) fail("BP_U07_RECONCILIATION_BINDING_DENOMINATOR_DRIFT");
  if (!Array.isArray(inventory.rows) || inventory.rows.length !== 196) fail("BP_U07_RECONCILIATION_SOURCE_DENOMINATOR_DRIFT");
  if (!Array.isArray(shape.rows) || shape.rows.length !== 196) fail("BP_U07_RECONCILIATION_SHAPE_DENOMINATOR_DRIFT");
  if (!Array.isArray(loaders.rows) || loaders.rows.length !== 10) fail("BP_U07_RECONCILIATION_LOADER_DENOMINATOR_DRIFT");
  if (!Array.isArray(fixture?.rows) || fixture.rows.length !== 396) fail("BP_U07_RECONCILIATION_FIXTURE_DENOMINATOR_DRIFT");
  validateFinalFixtureCatalog(fixture);
  validateFixtureCatalogAgainstRecipes(fixture, createFinalWorkloadRecipes());
  const fixtureRows = fixture.rows.filter((row) => row.area === "U07_ROUTE");
  if (fixtureRows.length !== 196) fail("BP_U07_RECONCILIATION_FIXTURE_DENOMINATOR_DRIFT");
  const bindingIds = bindings.operations.map((row) => row.operationId);
  const inventoryIds = inventory.rows.map((row) => row.operationId);
  const shapeIds = shape.rows.map((row) => row.operationId);
  const fixtureIds = fixtureRows.map((row) => row.operationId);
  exactSet(bindingIds, inventoryIds, "BP_U07_RECONCILIATION_BINDING_SOURCE_SET_DRIFT");
  exactSet(bindingIds, shapeIds, "BP_U07_RECONCILIATION_BINDING_SHAPE_SET_DRIFT");
  exactSet(bindingIds, fixtureIds, "BP_U07_RECONCILIATION_BINDING_FIXTURE_SET_DRIFT");
  const bindingById = new Map(bindings.operations.map((row) => [row.operationId, row]));
  const inventoryById = new Map(inventory.rows.map((row) => [row.operationId, row]));
  const shapeById = new Map(shape.rows.map((row) => [row.operationId, row]));
  const fixtureById = new Map(fixtureRows.map((row) => [row.operationId, row]));
  const loaderById = new Map(loaders.rows.map((row) => [row.loaderId, row]));
  for (const operationId of bindingIds) {
    const binding = bindingById.get(operationId);
    const source = inventoryById.get(operationId);
    const matrix = shapeById.get(operationId);
    const route = fixtureById.get(operationId);
    if (!source || !matrix || !route) fail("BP_U07_RECONCILIATION_ROW_MISSING", operationId);
    if (source.route?.method !== binding.method && binding.method !== undefined) fail("BP_U07_RECONCILIATION_ROUTE_METHOD_DRIFT", operationId);
    if (source.route?.routeOwner !== binding.owner || source.consumerFace !== binding.face) fail("BP_U07_RECONCILIATION_OWNER_FACE_DRIFT", operationId);
    const routePathMatches = route.routeTemplate === source.route.path || route.routeTemplate.replace(/^\/api/, "") === source.route.path;
    if (route.method !== source.route.method || !routePathMatches || route.fixturePlan?.expected?.ownerHttpOperationId !== `OWNER_HTTP_${operationId.replace(/([a-z0-9])([A-Z])/g, "$1_$2").toUpperCase()}`) fail("BP_U07_RECONCILIATION_ACCEPTANCE_DRIFT", operationId);
    if (matrix.sourceInventoryRef?.inventoryRowId !== source.rowId || matrix.sourceInventoryRef.inventoryDigest !== digest(source)) fail("BP_U07_RECONCILIATION_SHAPE_SOURCE_DIGEST_DRIFT", operationId);
    if (matrix.factLoaderRefs.length !== source.factLoaderRefs.length || JSON.stringify(matrix.factLoaderRefs) !== JSON.stringify(source.factLoaderRefs)) fail("BP_U07_RECONCILIATION_SHAPE_LOADER_SET_DRIFT", operationId);
    for (const ref of source.factLoaderRefs) if (!loaderById.has(ref.loaderId) || ref.loaderDigest !== prettyDigest(loaderById.get(ref.loaderId))) fail("BP_U07_RECONCILIATION_LOADER_DIGEST_DRIFT", `${operationId}:${ref.loaderId}`);
    if (!matrix.ownerLocalFoldProof || matrix.ownerLocalFoldProof.status !== "NO_GENERIC_FOLD_APPROVED" || !matrix.redDiscriminator || !route.fixturePlan?.expected?.assertionKey || !route.fixturePlan?.expected?.selector) fail("BP_U07_RECONCILIATION_ACCEPTANCE_OR_RED_DISCRIMINATOR_MISSING", operationId);
  }
  const planResult = validatePlan(plan, fixtureRows);
  validateRedlines(standards);
  return {operations: bindingIds.length, scenarios: planResult.scenarioCount, loaders: loaders.rows.length};
}

function selfTest() {
  const baseline = reconcileStatic196();
  const expectRed = (mutate, code, label) => {
    const inventory = json(paths.inventory); const shape = json(paths.shape); const loaders = json(paths.loaders); const fixture = loadFinalFixtureCatalog(); const plan = json(paths.plan); const standards = json(paths.standards); const bindings = json(paths.bindings);
    mutate({bindings, inventory, shape, loaders, fixture, plan, standards});
    try { reconcileStatic196({bindings, inventory, shape, loaders, fixture, plan, standards}); fail("BP_U07_RECONCILIATION_SELF_TEST_RED_NOT_DETECTED", label); }
    catch (error) { if (!String(error.message).startsWith(code)) throw error; }
  };
  expectRed(({inventory}) => inventory.rows.pop(), "BP_U07_RECONCILIATION_SOURCE_DENOMINATOR_DRIFT", "source");
  expectRed(({shape}) => { shape.rows[0].sourceInventoryRef.inventoryDigest = "0".repeat(64); }, "BP_U07_RECONCILIATION_SHAPE_SOURCE_DIGEST_DRIFT", "shape");
  expectRed(({loaders}) => loaders.rows.pop(), "BP_U07_RECONCILIATION_LOADER_DENOMINATOR_DRIFT", "loader");
  expectRed(({fixture}) => fixture.rows.splice(fixture.rows.findIndex((row) => row.area === "U07_ROUTE"), 1), "BP_U07_RECONCILIATION_FIXTURE_DENOMINATOR_DRIFT", "fixture");
  expectRed(({plan}) => { plan.reportContract.requiredFields = plan.reportContract.requiredFields.filter((field) => field !== "kindCounts"); }, "BP_U07_RECONCILIATION_PLAN_REPORT_CONTRACT_DRIFT", "plan");
  expectRed(({standards}) => standards.controls.pop(), "BP_U07_RECONCILIATION_STANDARDS_DENOMINATOR_DRIFT", "redline");
  process.stdout.write(`BP_U07_STATIC_196_RECONCILIATION_SELF_TEST=PASS\nOPERATIONS=${baseline.operations}\nSCENARIOS=${baseline.scenarios}\nLOADERS=${baseline.loaders}\nRED_SOURCE=PASS\nRED_SHAPE_DIGEST=PASS\nRED_LOADER=PASS\nRED_FIXTURE=PASS\nRED_PLAN=PASS\nRED_REDLINE=PASS\nCLEANUP=PASS\n`);
}

const argument = process.argv[2];
try {
  if (argument === "--self-test") selfTest();
  else if (argument === "--check") {
    const result = reconcileStatic196();
    process.stdout.write(`BP_U07_STATIC_196_RECONCILIATION=PASS\nOPERATIONS=${result.operations}\nSCENARIOS=${result.scenarios}\nLOADERS=${result.loaders}\nDYNAMIC_ADMISSION=NOT_YET_AUTHORIZED\n`);
  } else throw new Error("BP_U07_STATIC_196_RECONCILIATION_ARGUMENT_INVALID");
} catch (error) { process.stderr.write(`${error.message}\n`); process.exitCode = 1; }
