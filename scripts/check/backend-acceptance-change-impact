#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

case "${1:-}" in
  --self-test|--package-exit)
    [[ "$#" -eq 1 ]] || { printf '%s\n' 'BACKEND_ACCEPTANCE_CHANGE_IMPACT_ARGUMENT_INVALID' >&2; exit 2; }
    if [[ "$1" == "--self-test" ]]; then
      exec node "$REPO_ROOT/tools/backend-acceptance/impact.mjs" "$1"
    fi
    exec node "$REPO_ROOT/tools/compliance-control/cli.mjs" backend-acceptance-package-exit
    ;;
  *)
    printf '%s\n' 'BACKEND_ACCEPTANCE_CHANGE_IMPACT_ARGUMENT_INVALID' >&2
    exit 2
    ;;
esac
