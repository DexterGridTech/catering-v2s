  try { checkFinalFixtureCatalog({catalog: prerequisite, recipes}); fail("BP_FINAL_FIXTURE_SELF_TEST_PREREQUISITE_NOT_REJECTED"); } catch (error) { if (!String(error.message).includes("BP_FINAL_FIXTURE_BINDING_INVALID")) throw error; }
  const query = structuredClone(catalog); const queryRow = query.rows.find((row) => row.fixturePlan.queryBindings.length); queryRow.fixturePlan.queryBindings = [];
  try { checkFinalFixtureCatalog({catalog: query, recipes}); fail("BP_FINAL_FIXTURE_SELF_TEST_QUERY_NOT_REJECTED"); } catch (error) { if (!String(error.message).includes("BP_FINAL_FIXTURE_PLAN_QUERY_BINDING_DRIFT")) throw error; }
  const noBody = structuredClone(catalog); noBody.rows.find((row) => row.fixtureId === "BP-U04-PARITY:acceptPublicInvitation").fixturePlan.request.builderId = "BUILDER_ACCEPT_PUBLIC_INVITATION";
  try { checkFinalFixtureCatalog({catalog: noBody, recipes}); fail("BP_FINAL_FIXTURE_SELF_TEST_NO_BODY_NOT_REJECTED"); } catch (error) { if (!String(error.message).includes("BP_FINAL_FIXTURE_PLAN_NO_BODY_DRIFT")) throw error; }
  const family = structuredClone(catalog); const command = family.rows.find((row) => row.method !== "GET"); command.fixturePlan.familyId = "CONTRACT"; command.fixturePlan.preparationProcedureId = "PREP_CONTRACT"; command.fixturePlan.predecessorPlanId = "PREDECESSOR_CONTRACT"; command.fixturePlan.predecessorDeclarationId = "PREDECESSOR_CONTRACT";
