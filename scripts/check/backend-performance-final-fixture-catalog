const argument = process.argv[2];
try {
  if (argument === "--check") {
    const result = checkFinalFixtureCatalog();
    process.stdout.write(`BP_FINAL_FIXTURE_CATALOG=PASS\nROWS=${result.rows}\nU05=78+5\nU04=79+38\nU07=196\n`);
  } else if (argument === "--self-test") {
    selfTest();
    process.stdout.write("BP_FINAL_FIXTURE_CATALOG_SELF_TEST=PASS\n");
  } else fail("BP_FINAL_FIXTURE_CATALOG_ARGUMENT_INVALID");
} catch (error) {
  process.stderr.write(`${error.message}\n`);
  process.exitCode = 1;
}
