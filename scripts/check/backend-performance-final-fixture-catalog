export function checkFinalFixtureCatalog({catalog = loadFinalFixtureCatalog(), recipes = createFinalWorkloadRecipes()} = {}) {
  validateFinalFixtureCatalog(catalog);
  validateFixtureCatalogAgainstRecipes(catalog, recipes);
  validateFixturePlans(catalog);
  const counts = Object.fromEntries(Object.entries(catalog.denominators).filter(([key]) => key !== "total"));
  if (catalog.denominators.total !== 396 || JSON.stringify(counts) !== JSON.stringify({U05_TASK_READ: 78, U05_PROTOCOL: 5, U04_NUMERIC: 79, U04_CONTEXT_PARITY: 38, U07_ROUTE: 196})) fail("BP_FINAL_FIXTURE_CATALOG_DENOMINATOR_DRIFT");
  return {rows: catalog.rows.length, counts};
}

function selfTest() {
  const catalog = structuredClone(loadFinalFixtureCatalog());
  const recipes = createFinalWorkloadRecipes();
  checkFinalFixtureCatalog({catalog, recipes});
  const duplicate = structuredClone(catalog); duplicate.rows[1] = structuredClone(duplicate.rows[0]);
  try { checkFinalFixtureCatalog({catalog: duplicate, recipes}); fail("BP_FINAL_FIXTURE_SELF_TEST_DUPLICATE_NOT_REJECTED"); } catch (error) { if (!String(error.message).includes("BP_FINAL_FIXTURE_DUPLICATE")) throw error; }
