function readOpenApiOperations(entryRelative) {
  const entry = path.join(root, entryRelative);
  const document = YAML.parse(readFileSync(entry, "utf8"));
  const pointer = (value, fragment) => fragment.split("/").slice(1).reduce((current, token) => current?.[token.replaceAll("~1", "/").replaceAll("~0", "~")], value);
  const operations = [];
  for (const [routeTemplate, routeValue] of Object.entries(document.paths ?? {})) {
    let pathItem = routeValue, source = entry;
    if (pathItem.$ref) {
      const [relative, fragment = ""] = pathItem.$ref.split("#");
      source = path.resolve(path.dirname(entry), relative);
      pathItem = pointer(YAML.parse(readFileSync(source, "utf8")), fragment);
    }
    for (const [method, operation] of Object.entries(pathItem ?? {})) {
      if (!/^(get|post|put|patch|delete)$/.test(method) || !operation?.operationId) continue;
      const parameters = [...(pathItem.parameters ?? []), ...(operation.parameters ?? [])];
      const success = Object.keys(operation.responses ?? {}).find((status) => /^2/.test(status));
      operations.push({
        operationId: operation.operationId,
        method: method.toUpperCase(),
        routeTemplate,
        transport: operation.requestBody?.content?.["multipart/form-data"] ? "MULTIPART_FORM" : operation.requestBody ? "JSON" : "NONE",
        successStatus: Number(success),
        requiredQueryNames: parameters.filter((parameter) => parameter.in === "query" && parameter.required).map((parameter) => parameter.name),
        sourceAnchor: {path: path.relative(root, source), sha256: createHash("sha256").update(readFileSync(source)).digest("hex"), selector: operation.operationId},
      });
    }
  }
  return operations;
}

function openApiOperationContract() {
  return new Map([
    ...readOpenApiOperations("contracts/openapi/edge.openapi.yaml"),
    ...readOpenApiOperations("contracts/openapi/catalog-inventory.openapi.yaml"),
  ].map((operation) => [operation.operationId, operation]));
}

function validateFixturePlans(catalog) {
  const declarations = catalog.fixturePlanDeclarations;
  if (catalog.fixturePlanSchemaVersion !== 1 || !declarations || typeof declarations !== "object") fail("BP_FINAL_FIXTURE_PLAN_IDENTITY_INVALID");
  const identifierPattern = (identifier) => new RegExp(`(^|[^A-Za-z0-9_$])${String(identifier).replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}(?=$|[^A-Za-z0-9_$])`);
