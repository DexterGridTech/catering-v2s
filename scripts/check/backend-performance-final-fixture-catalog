  const validateAnchor = (anchor) => hashMatches(anchor) && selectorResolves(anchor) && exportedProcedureResolves(anchor);
  if (catalog.rows.some((row) => !selectorResolves(row.sourceAnchor))) fail("BP_FINAL_FIXTURE_PLAN_SOURCE_SELECTOR_UNRESOLVED");
  if (catalog.rows.some((row) => !exportedProcedureResolves(row.sourceAnchor))) fail("BP_FINAL_FIXTURE_PLAN_EXPORTED_PROCEDURE_UNRESOLVED");
