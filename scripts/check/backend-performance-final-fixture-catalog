  const declaredAnchors = [
    ...[...families.values(), ...procedures.values(), ...(declarations.sessionPlans ?? [])].map((value) => value.sourceAnchor),
    ...Object.values(declarations.queryBindingConstraints ?? {}).map((value) => value.sourceAnchor),
    ...[...algorithms.values(), ...builders.values()].flatMap((value) => value.sourceAnchors ?? []),
    ...[...readbacks.values()].map((value) => value.sourceAnchor),
    ...(declarations.ownerHttpOperationDeclarations ?? []).map((value) => value.sourceAnchor),
  ];
  if (declaredAnchors.some((anchor) => !selectorResolves(anchor))) fail("BP_FINAL_FIXTURE_PLAN_SOURCE_SELECTOR_UNRESOLVED");
  if (declaredAnchors.some((anchor) => !exportedProcedureResolves(anchor))) fail("BP_FINAL_FIXTURE_PLAN_EXPORTED_PROCEDURE_UNRESOLVED");
  const openApi = openApiOperationContract();
  const ownerOperations = new Map((declarations.ownerHttpOperationDeclarations ?? []).map((value) => [value.id, value]));
