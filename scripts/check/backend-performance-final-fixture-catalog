  const algorithm = structuredClone(catalog); algorithm.fixturePlanDeclarations.sourceAlgorithms[0].sourceAnchors[0].sha256 = "0".repeat(64);
  try { checkFinalFixtureCatalog({catalog: algorithm, recipes}); fail("BP_FINAL_FIXTURE_SELF_TEST_SOURCE_HASH_NOT_REJECTED"); } catch (error) { if (!String(error.message).includes("BP_FINAL_FIXTURE_PLAN_SOURCE_HASH_DRIFT")) throw error; }
  const unknownSelector = structuredClone(catalog); unknownSelector.fixturePlanDeclarations.sourceAlgorithms[0].sourceAnchors[0].selector = "e";
  try { checkFinalFixtureCatalog({catalog: unknownSelector, recipes}); fail("BP_FINAL_FIXTURE_SELF_TEST_SELECTOR_RESOLUTION_NOT_REJECTED"); } catch (error) { if (!String(error.message).includes("BP_FINAL_FIXTURE_PLAN_SOURCE_SELECTOR_UNRESOLVED")) throw error; }
  const exportedProcedure = structuredClone(catalog); exportedProcedure.fixturePlanDeclarations.readbackDeclarations[0].sourceAnchor.exportedProcedure = "missingAuthoritativeExport";
  try { checkFinalFixtureCatalog({catalog: exportedProcedure, recipes}); fail("BP_FINAL_FIXTURE_SELF_TEST_EXPORTED_PROCEDURE_NOT_REJECTED"); } catch (error) { if (!String(error.message).includes("BP_FINAL_FIXTURE_PLAN_EXPORTED_PROCEDURE_UNRESOLVED")) throw error; }
