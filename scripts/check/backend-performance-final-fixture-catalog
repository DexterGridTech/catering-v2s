    if (plan.pathBindings.length !== row.pathParameters.length || !exact(plan.pathBindings.map((value) => value.name), row.pathParameters.map((value) => value.name)) || plan.pathBindings.some((value) => typeof value.stateKey !== "string" || typeof value.producerReadbackKey !== "string" || !value.producerReadbackKey.startsWith("readback."))) fail("BP_FINAL_FIXTURE_PLAN_PATH_BINDING_DRIFT");
    const requiredQuery = constraints[row.operationId]?.requiredNames ?? [];
    if (!exact(plan.queryBindings.map((value) => value.name), requiredQuery) || plan.queryBindings.some((value) => typeof value.stateKey !== "string" || typeof value.producerReadbackKey !== "string")) fail("BP_FINAL_FIXTURE_PLAN_QUERY_BINDING_DRIFT");
