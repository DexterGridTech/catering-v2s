  try { checkFinalFixtureCatalog({catalog: generic, recipes}); fail("BP_FINAL_FIXTURE_SELF_TEST_GENERIC_NOT_REJECTED"); } catch (error) { if (!String(error.message).includes("BP_FINAL_FIXTURE_BINDING_INVALID")) throw error; }
