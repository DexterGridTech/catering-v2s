#!/usr/bin/env node
import crypto from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import {fileURLToPath} from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
const ledgerPath = "doc/evidence/platform/2026-08-09-v2s-backend-performance-phase1-gate-dispositions.json";
const baselineGateCount = 44;
const phaseOneAdditions = new Set([
  "backend-performance-evidence-snapshot",
  "backend-performance-gate-dispositions",
  "backend-performance-observability",
  "operation-handler-bindings",
]);
// These gates were introduced by the explicitly declared BP-U04/U05/U07
// implementation packages after the immutable Phase-1 ledger was captured.
// They remain a closed set: an unlisted executable still fails the denominator
// check instead of silently becoming a final-performance gate.
const laterPerformanceAdditions = new Set([
  "backend-performance-command-baselines",
  "backend-performance-command-binding-reachability",
  "backend-performance-final-fixture-catalog",
  "backend-performance-operation-source-inventory",
  "backend-performance-operation-database-shape",
  "backend-performance-request-fact-load-once",
  "backend-performance-standards-registration",
  "backend-performance-read-budget",
  "backend-performance-sql-merge-coverage",
  "backend-performance-static-196-reconciliation",
]);
const statusVocabulary = new Set(["PASS", "FAIL", "USAGE_REQUIRED"]);
const dispositionVocabulary = new Set([
  "EXISTING_VERIFY",
  "STANDALONE_CURRENT",
  "RETIRED_REPLACED_IN_FUTURE_UNIT",
  "DEFERRED_TO_BP_U06",
  "DEFERRED_TO_BP_U05",
  "DEFERRED_TO_BP_U02",
  "REQUIRES_MANAGED_RUN",
]);

function readJson(relative, reason) {
  try { return JSON.parse(fs.readFileSync(path.join(root, relative), "utf8")); }
  catch { throw new Error(reason); }
}

function executableChecks() {
  return fs.readdirSync(path.join(root, "scripts/check"), {withFileTypes: true})
    .filter((entry) => entry.isFile())
    .filter((entry) => (fs.statSync(path.join(root, "scripts/check", entry.name)).mode & 0o100) !== 0)
    .map((entry) => entry.name)
    .sort();
}

function verifyCheckGateSet(source = fs.readFileSync(path.join(root, "tools/verify-gates/verify.mjs"), "utf8")) {
  return [...source.matchAll(/['"]scripts\/check\/([^'"]+)['"]/g)]
    .map((match) => match[1])
    .filter((gate) => !gate.includes("${"))
    .sort();
}

function exactSet(actual, expected, reason) {
  if (actual.length !== expected.length || new Set(actual).size !== actual.length
    || actual.some((entry) => !expected.includes(entry))) throw new Error(reason);
}

function validate(ledger) {
  if (ledger?.schemaVersion !== 1 || ledger.kind !== "backend-performance-phase1-gate-dispositions"
    || ledger.baselineGateCount !== baselineGateCount || !Array.isArray(ledger.gates)
    || !Array.isArray(ledger.phaseOneAdditions) || !Array.isArray(ledger.laterPerformanceAdditions)) throw new Error("BP_U01_GATE_DISPOSITION_INVALID");
  if (ledger.gates.length !== baselineGateCount) throw new Error("BP_U01_GATE_DISPOSITION_BASELINE_COUNT_DRIFT");
  const ids = ledger.gates.map((entry) => entry?.gate);
  if (new Set(ids).size !== ids.length || ids.some((entry) => typeof entry !== "string" || entry.length === 0)) {
    throw new Error("BP_U01_GATE_DISPOSITION_DUPLICATE_OR_INVALID");
  }
  for (const entry of ledger.gates) {
    if (entry.command !== `scripts/check/${entry.gate}`
      || !statusVocabulary.has(entry.currentStatus)
      || !dispositionVocabulary.has(entry.verifyDisposition)
      || typeof entry.standardsMapping !== "string" || entry.standardsMapping.length === 0
      || typeof entry.currentEvidence !== "string" || entry.currentEvidence.length === 0
      || typeof entry.futureUnit !== "string" || entry.futureUnit.length === 0) {
      throw new Error(`BP_U01_GATE_DISPOSITION_ROW_INVALID:${entry?.gate || "UNSET"}`);
    }
  }
  const declaredVerifyGates = ledger.gates
    .filter((entry) => entry.verifyDisposition === "EXISTING_VERIFY")
    .map((entry) => entry.gate)
    .sort();
  exactSet(declaredVerifyGates, verifyCheckGateSet(), "BP_U01_GATE_VERIFY_WIRING_DRIFT");
  exactSet(ledger.phaseOneAdditions.map((entry) => entry?.gate), [...phaseOneAdditions].sort(), "BP_U01_GATE_ADDITION_SET_DRIFT");
  for (const entry of ledger.phaseOneAdditions) {
    if (entry.command !== `scripts/check/${entry.gate}` || !dispositionVocabulary.has(entry.verifyDisposition)
      || typeof entry.standardsMapping !== "string" || entry.standardsMapping.length === 0) {
      throw new Error("BP_U01_GATE_ADDITION_ROW_INVALID:" + (entry?.gate || "UNSET"));
    }
  }
  exactSet(ledger.laterPerformanceAdditions.map((entry) => entry?.gate), [...laterPerformanceAdditions].sort(), "BP_U01_GATE_LATER_ADDITION_SET_DRIFT");
  for (const entry of ledger.laterPerformanceAdditions) {
    if (!entry || entry.command !== "scripts/check/" + entry.gate
      || !statusVocabulary.has(entry.currentStatus)
      || !dispositionVocabulary.has(entry.verifyDisposition)
      || typeof entry.standardsMapping !== "string" || entry.standardsMapping.length === 0
      || typeof entry.futureUnit !== "string" || entry.futureUnit.length === 0
      || typeof entry.currentEvidence !== "string" || entry.currentEvidence.length === 0
      || !entry.diagnostics || typeof entry.diagnostics.WHY !== "string"
      || typeof entry.diagnostics.BACKGROUND !== "string" || typeof entry.diagnostics.PATTERN !== "string") {
      throw new Error("BP_U01_GATE_LATER_ADDITION_ROW_INVALID:" + (entry?.gate || "UNSET"));
    }
  }
  const actual = executableChecks();
  exactSet(actual, [...ids, ...phaseOneAdditions, ...laterPerformanceAdditions].sort(), "BP_U01_GATE_RUNTIME_DENOMINATOR_DRIFT");
  if (ledger.gates.some((entry) => phaseOneAdditions.has(entry.gate))) throw new Error("BP_U01_GATE_BASELINE_CONTAINS_PHASE_ONE_ADDITION");
  return {baseline: ids.length, current: actual.length, phaseOne: phaseOneAdditions.size, laterPerformance: laterPerformanceAdditions.size};
}

function selfTest() {
  const ledger = readJson(ledgerPath, "BP_U01_GATE_DISPOSITION_MISSING");
  validate(ledger);
  const expect = (reason, mutate) => {
    const copy = structuredClone(ledger);
    mutate(copy);
    try { validate(copy); throw new Error(`BP_U01_GATE_DISPOSITION_RED_NOT_DETECTED:${reason}`); }
    catch (error) {
      if (!(error instanceof Error) || error.message !== reason) throw error;
    }
  };
  expect("BP_U01_GATE_DISPOSITION_BASELINE_COUNT_DRIFT", (copy) => { copy.gates.pop(); });
  expect("BP_U01_GATE_DISPOSITION_ROW_INVALID:admin-boundaries", (copy) => { copy.gates[0].verifyDisposition = "UNKNOWN"; });
  expect("BP_U01_GATE_ADDITION_SET_DRIFT", (copy) => { copy.phaseOneAdditions.pop(); });
  expect("BP_U01_GATE_LATER_ADDITION_SET_DRIFT", (copy) => { copy.laterPerformanceAdditions.pop(); });
  const originalVerifySource = fs.readFileSync(path.join(root, "tools/verify-gates/verify.mjs"), "utf8");
  const removed = originalVerifySource.replace("scripts/check/openapi-contracts", "scripts/check/openapi-contracts-removed");
  try {
    exactSet(ledger.gates.filter((entry) => entry.verifyDisposition === "EXISTING_VERIFY").map((entry) => entry.gate).sort(), verifyCheckGateSet(removed), "BP_U01_GATE_VERIFY_WIRING_DRIFT");
    throw new Error("BP_U01_GATE_DISPOSITION_RED_NOT_DETECTED:verify");
  } catch (error) { if (!(error instanceof Error) || error.message !== "BP_U01_GATE_VERIFY_WIRING_DRIFT") throw error; }
  const hash = crypto.createHash("sha256").update(JSON.stringify(ledger)).digest("hex");
  process.stdout.write(`BP_U01_GATE_DISPOSITIONS=PASS\nBASELINE_GATES=${ledger.gates.length}\nCURRENT_EXECUTABLE_GATES=${executableChecks().length}\nVERIFY_CHECK_GATES=${verifyCheckGateSet().length}\nPHASE_ONE_ADDITIONS=${phaseOneAdditions.size}\nLATER_PERFORMANCE_ADDITIONS=${laterPerformanceAdditions.size}\nLEDGER_SHA256=${hash}\nRED_BASELINE_COUNT=PASS\nRED_ROW=PASS\nRED_ADDITION_SET=PASS\nRED_VERIFY_WIRING=PASS\n`);
}

try {
  if (process.argv.length === 3 && process.argv[2] === "--self-test") selfTest();
  else if (process.argv.length === 2) {
    const result = validate(readJson(ledgerPath, "BP_U01_GATE_DISPOSITION_MISSING"));
    process.stdout.write(`BP_U01_GATE_DISPOSITIONS=PASS\nBASELINE_GATES=${result.baseline}\nCURRENT_EXECUTABLE_GATES=${result.current}\nPHASE_ONE_ADDITIONS=${result.phaseOne}\nLATER_PERFORMANCE_ADDITIONS=${result.laterPerformance}\n`);
  } else throw new Error("BP_U01_GATE_DISPOSITION_ARGUMENT_INVALID");
} catch (error) {
  process.stderr.write(`BP_U01_GATE_DISPOSITIONS=FAIL\nREASON=${error instanceof Error ? error.message : String(error)}\n`);
  process.exitCode = 1;
}
