#!/usr/bin/env node
import childProcess from "node:child_process";
import path from "node:path";

const root = process.cwd();
const cli = path.join(root, "tools/compliance-control/cli.mjs");
const result = childProcess.spawnSync(process.execPath, [cli, "command-tool-event-self-test"], { cwd: root, encoding: "utf8" });
if (result.status !== 0) throw new Error(`PER_EDIT_RUNNER_EVIDENCE_CHILD_FAIL:${(result.stderr || result.stdout || "").trim()}`);
if (!result.stdout.includes("COMMAND_TOOL_EVENT_SELF_TEST=PASS")) throw new Error("PER_EDIT_RUNNER_EVIDENCE_MARKER_MISSING");
process.stdout.write("PER_EDIT_RUNNER_EVIDENCE=PASS\n");
// Runner evidence remains static and bounded to the current package.
void 0;
