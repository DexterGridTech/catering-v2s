#!/usr/bin/env node

import {createHash} from "node:crypto";
import {chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, renameSync, rmSync, writeFileSync} from "node:fs";
import os from "node:os";
import path from "node:path";
import {fileURLToPath, pathToFileURL} from "node:url";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
const SCHEMA_VERSION = 2;
const NON_VERIFICATION_PROVENANCE = "NON_VERIFICATION_PROVENANCE";
const REQUIRED_PHASES = Object.freeze(["EDGE_IN", "SESSION_RESOLVED", "AUTHORIZED", "SCOPE_RESOLVED", "OWNER_COMMAND_BEGIN", "OWNER_COMMAND_END", "READBACK_END", "EDGE_OUT"]);
const INPUTS = Object.freeze([
  {kind: "DATABASE_OPERATIONS", names: ["db-operations.jsonl"]},
  {kind: "STATEMENT_DICTIONARY", names: ["statement-dictionary.json"]},
  // These are the complete set emitted by the managed R5 runners.  A new
  // runner name is deliberately not accepted until this closed contract moves
  // with it.
  {kind: "REQUEST_EVENTS", names: ["request-events.jsonl", "seed-request-events.jsonl", "http-request-events.jsonl"]},
  {kind: "SEED_REPORT", names: ["seed-report.json"]},
  {kind: "RUN_MANIFEST", names: ["run-manifest.json"]},
]);
const INPUT_BY_KIND = new Map(INPUTS.map((input) => [input.kind, input]));

function ownerCommandBindingRows() {
  const bindings = readJson(path.join(ROOT, "contracts/registry/operation-handler-bindings.json"));
  if (!Array.isArray(bindings?.operations)) fail("BP_U01_OWNER_COMMAND_BINDING_INVALID");
  const malformed = bindings.operations.find((operation) => !operation || typeof operation.operationId !== "string"
    || !operation.operationId || typeof operation.mode !== "string" || typeof operation.commandBoundary !== "string");
  if (malformed) fail("BP_U01_OWNER_COMMAND_BINDING_INVALID", malformed?.operationId ?? "UNKNOWN");
  return bindings.operations.filter((operation) => operation.mode === "COMMAND" && operation.commandBoundary === "OWNER_COMMAND");
}

function fail(code, detail = "") {
  const error = new Error(`${code}${detail ? `:${detail}` : ""}`);
  error.code = code;
  throw error;
}

function sha256(bytes) {
  return createHash("sha256").update(bytes).digest("hex");
}

function readJson(file) {
  try { return JSON.parse(readFileSync(file, "utf8")); }
  catch (error) { fail("BP_U01_JSON_INVALID", `${file}:${error.message}`); }
}

function flatCandidates(runDir, names) {
  return names.flatMap((name) => [path.join(runDir, name), path.join(runDir, "evidence", name)]).filter(existsSync);
}

function locateClosedFlatInput(runDir, input) {
  const candidates = flatCandidates(runDir, input.names);
  if (candidates.length > 1) {
    fail("BP_U01_REQUEST_EVENTS_CARDINALITY_INVALID", `${runDir}:${candidates.map((candidate) => path.relative(runDir, candidate)).join(",")}`);
  }
  return candidates[0] ?? null;
}

function locateSingleFlatInput(runDir, input) {
  const candidates = flatCandidates(runDir, input.names);
  if (candidates.length > 1) {
    fail("BP_U01_SNAPSHOT_INPUT_CARDINALITY_INVALID", `${input.kind}:${runDir}:${candidates.map((candidate) => path.relative(runDir, candidate)).join(",")}`);
  }
  return candidates[0] ?? null;
}

function runScope(runManifestPath) {
  const manifest = readJson(runManifestPath);
  if (typeof manifest?.runId !== "string" || !manifest.runId.trim()) fail("BP_U01_SNAPSHOT_RUN_SCOPE_INVALID", runManifestPath);
  return manifest.runId;
}

function seedReportCandidates(runDir, expectedRunId) {
  const candidates = flatCandidates(runDir, ["seed-report.json"]);
  const seedRoot = path.join(runDir, "seed");
  if (existsSync(seedRoot)) candidates.push(...readdirSync(seedRoot, {withFileTypes: true})
    .filter((entry) => entry.isDirectory())
    .map((entry) => path.join(seedRoot, entry.name, "seed-report.json"))
    .filter(existsSync));
  return candidates.filter((candidate) => {
    const report = readJson(candidate);
    return report?.runId === expectedRunId || report?.managedDevRunId === expectedRunId;
  });
}

function locateSeedReport(runDir, expectedRunId) {
  const candidates = seedReportCandidates(runDir, expectedRunId);
  if (candidates.length !== 1) {
    fail("BP_U01_SEED_REPORT_CARDINALITY_INVALID", `${runDir}:expectedRunId=${expectedRunId}:matches=${candidates.map((candidate) => path.relative(runDir, candidate)).join(",")}`);
  }
  return candidates[0];
}

function locate(runDir, input, expectedRunId = null) {
  if (input.kind === "REQUEST_EVENTS") return locateClosedFlatInput(runDir, input);
  if (input.kind === "SEED_REPORT") return locateSeedReport(runDir, expectedRunId);
  return locateSingleFlatInput(runDir, input);
}

function jsonLinesFromText(text, sourceName) {
  return text.split(/\r?\n/).filter(Boolean).map((line, index) => {
    try { return JSON.parse(line); }
    catch (error) { fail("BP_U01_JSONL_INVALID", `${sourceName}:${index + 1}:${error.message}`); }
  });
}

function runIdForMeasuredRow(kind, row) {
  return kind === "REQUEST_EVENTS" ? row?.managedDevRunId ?? row?.runId : row?.runId;
}

function sliceJsonLinesForRun(sourcePath, kind, expectedRunId) {
  const selected = [];
  const sourceRunIds = new Set();
  readFileSync(sourcePath, "utf8").split(/\r?\n/).filter(Boolean).forEach((line, index) => {
    let row;
    try { row = JSON.parse(line); }
    catch (error) { fail("BP_U01_JSONL_INVALID", `${sourcePath}:${index + 1}:${error.message}`); }
    const rowRunId = runIdForMeasuredRow(kind, row);
    if (typeof rowRunId === "string" && rowRunId.trim()) sourceRunIds.add(rowRunId);
    if (rowRunId === expectedRunId) selected.push(line);
  });
  return {bytes: Buffer.from(selected.length ? `${selected.join("\n")}\n` : ""), sourceRunIds: [...sourceRunIds].sort(), selectedCount: selected.length};
}

function statementIdsForDatabaseOperations(bytes, sourceName) {
  return [...new Set(jsonLinesFromText(bytes.toString("utf8"), sourceName)
    .map((row) => row?.statementId)
    .filter((statementId) => typeof statementId === "string" && statementId.trim()))].sort();
}

function sliceStatementDictionary(sourcePath, statementIds) {
  const dictionary = readJson(sourcePath);
  if (!dictionary || Array.isArray(dictionary) || typeof dictionary !== "object") fail("BP_U01_STATEMENT_DICTIONARY_INVALID", sourcePath);
  const selected = {};
  for (const statementId of statementIds) {
    if (!(statementId in dictionary)) fail("BP_U01_STATEMENT_DICTIONARY_ENTRY_MISSING", statementId);
    selected[statementId] = dictionary[statementId];
  }
  return Buffer.from(`${JSON.stringify(selected)}\n`);
}

function ranges(rows) {
  const values = (field) => [...new Set(rows.map((row) => row?.[field]).filter((value) => value != null).map(String))].sort();
  return {runIds: values("runId"), requestIds: values("requestId"), correlationIds: values("correlationId")};
}

function requestTuple(row, sourceName) {
  const runId = row?.managedDevRunId ?? row?.runId;
  const correlationId = row?.correlationId;
  const requestId = row?.requestId;
  if (![runId, correlationId, requestId].every((value) => typeof value === "string" && value.trim())) {
    fail("BP_U01_REQUEST_TUPLE_INCOMPLETE", `${sourceName}:${JSON.stringify({runId, correlationId, requestId})}`);
  }
  return `${runId}\u0000${correlationId}\u0000${requestId}`;
}

function inputRecords(runDir) {
  const runManifestInput = INPUT_BY_KIND.get("RUN_MANIFEST");
  const runManifestPath = locate(runDir, runManifestInput);
  if (!runManifestPath) fail("BP_U01_SNAPSHOT_INPUT_MISSING", `${runDir}:${runManifestInput.names[0]}`);
  const expectedRunId = runScope(runManifestPath);
  const located = INPUTS.map((input) => {
    const sourcePath = input.kind === "RUN_MANIFEST" ? runManifestPath : locate(runDir, input, expectedRunId);
    if (!sourcePath) fail("BP_U01_SNAPSHOT_INPUT_MISSING", `${runDir}:${input.names[0]}`);
    return {input, sourcePath: path.resolve(sourcePath), sourceBytes: readFileSync(sourcePath)};
  });
  const byKind = new Map(located.map((record) => [record.input.kind, record]));
  const db = byKind.get("DATABASE_OPERATIONS");
  const events = byKind.get("REQUEST_EVENTS");
  const dictionary = byKind.get("STATEMENT_DICTIONARY");
  const dbSelection = sliceJsonLinesForRun(db.sourcePath, db.input.kind, expectedRunId);
  const eventSelection = sliceJsonLinesForRun(events.sourcePath, events.input.kind, expectedRunId);
  if (dbSelection.selectedCount === 0 && dbSelection.sourceRunIds.length > 0) {
    fail("BP_U01_SNAPSHOT_RUN_SCOPE_MISMATCH", `db-operations.jsonl:expected=${expectedRunId}:observed=${dbSelection.sourceRunIds.join(",")}`);
  }
  const dictionaryBytes = sliceStatementDictionary(dictionary.sourcePath, statementIdsForDatabaseOperations(dbSelection.bytes, db.sourcePath));
  const selectedBytes = new Map([
    ["DATABASE_OPERATIONS", dbSelection.bytes],
    ["REQUEST_EVENTS", eventSelection.bytes],
    ["STATEMENT_DICTIONARY", dictionaryBytes],
  ]);
  return located.map(({input, sourcePath, sourceBytes}) => {
    const bytes = selectedBytes.get(input.kind) ?? sourceBytes;
    return {
      kind: input.kind,
      name: path.basename(sourcePath),
      sourcePath,
      sourceSha256: sha256(sourceBytes),
      sourceByteSize: sourceBytes.length,
      bytes,
      sha256: sha256(bytes),
      byteSize: bytes.length,
    };
  });
}

function validateInputContract(records) {
  if (!Array.isArray(records) || records.length !== INPUTS.length) fail("BP_U01_SNAPSHOT_INPUT_CONTRACT_INVALID", "count");
  for (const input of INPUTS) {
    const matching = records.filter((record) => record?.kind === input.kind);
    if (matching.length !== 1 || !input.names.includes(matching[0]?.name)) {
      fail("BP_U01_SNAPSHOT_INPUT_CONTRACT_INVALID", input.kind);
    }
  }
  if (records.some((record) => !INPUT_BY_KIND.has(record?.kind))) fail("BP_U01_SNAPSHOT_INPUT_CONTRACT_INVALID", "unknown-kind");
}

function measuredRunScope(records) {
  const manifest = records.find((record) => record.kind === "RUN_MANIFEST");
  return runScope(manifest.sourcePath);
}

function ensureMeasuredRowsMatchRunScope(rows, kind, sourceName, expectedRunId) {
  const observed = [...new Set(rows.map((row) => runIdForMeasuredRow(kind, row)).filter((runId) => typeof runId === "string" && runId.trim()))].sort();
  if (observed.some((runId) => runId !== expectedRunId)) {
    fail("BP_U01_SNAPSHOT_RUN_SCOPE_MISMATCH", `${sourceName}:expected=${expectedRunId}:observed=${observed.join(",")}`);
  }
}

function buildMetadata(records) {
  const db = records.find((record) => record.kind === "DATABASE_OPERATIONS");
  const events = records.find((record) => record.kind === "REQUEST_EVENTS");
  const dictionary = records.find((record) => record.kind === "STATEMENT_DICTIONARY");
  const dbRows = db ? jsonLinesFromText(db.bytes.toString("utf8"), db.name) : [];
  const eventRows = events ? jsonLinesFromText(events.bytes.toString("utf8"), events.name) : [];
  const expectedRunId = measuredRunScope(records);
  ensureMeasuredRowsMatchRunScope(dbRows, "DATABASE_OPERATIONS", "db-operations.jsonl", expectedRunId);
  ensureMeasuredRowsMatchRunScope(eventRows, "REQUEST_EVENTS", events?.name ?? "request-events.jsonl", expectedRunId);
  const schemas = [...new Set([...dbRows, ...eventRows].map((row) => row?.measurementSchemaVersion).filter(Boolean).map(Number))].sort((a, b) => a - b);
  const bases = [...new Set([...dbRows, ...eventRows].map((row) => row?.measurementBasis).filter(Boolean))].sort();
  const all = [...dbRows, ...eventRows];
  const phaseCoverage = [...new Set(eventRows.flatMap((row) => Array.isArray(row?.phaseCheckpoints)
    ? row.phaseCheckpoints.map((checkpoint) => checkpoint?.phase).filter(Boolean)
    : []))].sort();
  const ownerCommandBindings = ownerCommandBindingRows();
  const ownerCommandOperations = new Set(ownerCommandBindings.map((operation) => operation.operationId));
  const observedOwnerCommandOperations = new Set();
  const ownerCommandPhaseMissingRequests = eventRows
    .filter((row) => ownerCommandOperations.has(row?.operationId))
    .map((row) => {
      observedOwnerCommandOperations.add(row.operationId);
      const phases = new Set(Array.isArray(row?.phaseCheckpoints) ? row.phaseCheckpoints.map((checkpoint) => checkpoint?.phase) : []);
      const missing = ["OWNER_COMMAND_BEGIN", "OWNER_COMMAND_END"].filter((phase) => !phases.has(phase));
      return missing.length ? {operationId: row.operationId, requestId: row.requestId, missing} : null;
    })
    .filter(Boolean);
  const unclassifiedOperations = dbRows.filter((row) => row?.section === "UNCLASSIFIED").length;
  const eventTuples = new Set(eventRows.map((row) => requestTuple(row, "request-events.jsonl")));
  const missingEventTuples = [...new Set(dbRows
    .map((row) => requestTuple(row, "db-operations.jsonl"))
    .filter((tuple) => !eventTuples.has(tuple)))];
  if (missingEventTuples.length) {
    fail("BP_U01_DB_EVENT_JOIN_MISSING", `${missingEventTuples.length}:${missingEventTuples.slice(0, 3).join(",")}`);
  }
  const unclassifiedRatio = dbRows.length === 0 ? 0 : unclassifiedOperations / dbRows.length;
  const missingPhases = REQUIRED_PHASES.filter((phase) => !phaseCoverage.includes(phase));
  return {
    selectedRunId: expectedRunId,
    measurementSchemaVersions: schemas,
    measurementBases: bases,
    ranges: ranges(all),
    counts: {databaseOperations: dbRows.length, requests: eventTuples.size, requestEvents: eventRows.length},
    phaseCoverage,
    missingPhases,
    unclassifiedOperations,
    unclassifiedRatio,
    ownerCommandOperationsApplicable: ownerCommandBindings.length,
    ownerCommandOperationsObserved: observedOwnerCommandOperations.size,
    ownerCommandPhaseMissingRequests,
    optimizationStatus: unclassifiedRatio > 0.15 || missingPhases.length || ownerCommandPhaseMissingRequests.length
      ? "UNMEASURED_BLOCKS_OPTIMIZATION" : "MEASURABLE",
    dictionaryDigest: dictionary ? sha256(dictionary.bytes) : null,
  };
}

function snapshotDigest(records, metadata) {
  // sourceRunDir and inputs[].sourcePath identify where an immutable copy came from. They
  // deliberately do not enter this content digest: relocating the same evidence must not
  // change its content address. Their non-verification status is explicit and validated.
  return sha256(JSON.stringify({
    inputs: records.map(({kind, name, sourceSha256, sourceByteSize, sha256: digest, byteSize}) => ({kind, name, sourceSha256, sourceByteSize, sha256: digest, byteSize})),
    metadata,
  }));
}

function makeSnapshot(runDir) {
  const absoluteRunDir = path.resolve(runDir);
  const records = inputRecords(absoluteRunDir);
  validateInputContract(records);
  const metadata = buildMetadata(records);
  if (!metadata.measurementSchemaVersions.length || !metadata.measurementBases.length) fail("BP_U01_MEASUREMENT_METADATA_MISSING");
  if (metadata.counts.databaseOperations < 1 || metadata.counts.requests < 1 || metadata.counts.requestEvents < 1) fail("BP_U01_NONEMPTY_EVIDENCE_REQUIRED", JSON.stringify(metadata.counts));
  if (!metadata.phaseCoverage.includes("EDGE_IN") || !metadata.phaseCoverage.includes("EDGE_OUT")) fail("BP_U01_PHASE_COVERAGE_REQUIRED", metadata.phaseCoverage.join(","));
  const metadataDigest = sha256(JSON.stringify(metadata));
  const contentDigest = snapshotDigest(records, metadata);
  const snapshotsRoot = path.join(absoluteRunDir, "snapshots");
  mkdirSync(snapshotsRoot, {recursive: true});
  const snapshotDir = path.join(snapshotsRoot, contentDigest);
  if (existsSync(path.join(snapshotDir, "snapshot-manifest.json"))) return {snapshotDir, manifest: readJson(path.join(snapshotDir, "snapshot-manifest.json"))};
  const stagingDir = mkdtempSync(path.join(snapshotsRoot, `.incomplete-${process.pid}-`));
  const inputs = records.map(({kind, name, sourcePath, sourceSha256, sourceByteSize, bytes, sha256: digest, byteSize}) => {
    const target = path.join(stagingDir, name);
    writeFileSync(target, bytes, {mode: 0o400});
    try { chmodSync(target, 0o400); } catch { /* Windows/non-POSIX */ }
    return {
      kind,
      name,
      sourcePath,
      sourcePathVerification: NON_VERIFICATION_PROVENANCE,
      sourceSha256,
      sourceByteSize,
      snapshotPath: name,
      sha256: digest,
      byteSize,
    };
  });
  const manifest = {
    schemaVersion: SCHEMA_VERSION,
    kind: "backend-performance-evidence-snapshot",
    status: "COMPLETE",
    contentDigest,
    metadataDigest,
    createdAt: new Date().toISOString(),
    sourceRunDir: absoluteRunDir,
    sourceRunDirVerification: NON_VERIFICATION_PROVENANCE,
    inputs,
    ...metadata,
  };
  const manifestPath = path.join(stagingDir, "snapshot-manifest.json");
  writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`, {mode: 0o400});
  try { chmodSync(manifestPath, 0o400); } catch { /* Windows/non-POSIX */ }
  // Publish by rename only after every immutable input and manifest is complete.
  // Coverage readers therefore observe either no snapshot or a complete snapshot,
  // never a partially copied directory.
  renameSync(stagingDir, snapshotDir);
  return {snapshotDir, manifest};
}

function validateSnapshot(snapshotDir) {
  if (!snapshotDir || snapshotDir.endsWith("db-operations.jsonl") || !existsSync(snapshotDir)) fail("BP_U01_SNAPSHOT_ONLY_INPUT_REQUIRED", snapshotDir);
  const manifestPath = path.join(snapshotDir, "snapshot-manifest.json");
  if (!existsSync(manifestPath)) fail("BP_U01_SNAPSHOT_MANIFEST_MISSING", snapshotDir);
  const manifest = readJson(manifestPath);
  if (manifest.schemaVersion !== SCHEMA_VERSION || manifest.kind !== "backend-performance-evidence-snapshot" || manifest.status !== "COMPLETE") fail("BP_U01_SNAPSHOT_MANIFEST_INVALID");
  if (path.basename(snapshotDir) !== manifest.contentDigest || !/^[a-f0-9]{64}$/.test(manifest.contentDigest)) fail("BP_U01_SNAPSHOT_DIGEST_INVALID");
  if (manifest.sourceRunDirVerification !== NON_VERIFICATION_PROVENANCE || typeof manifest.sourceRunDir !== "string" || !path.isAbsolute(manifest.sourceRunDir)) {
    fail("BP_U01_SNAPSHOT_PROVENANCE_INVALID", "sourceRunDir");
  }
  const records = [];
  for (const input of manifest.inputs ?? []) {
    if (input.sourcePathVerification !== NON_VERIFICATION_PROVENANCE || typeof input.sourcePath !== "string" || !path.isAbsolute(input.sourcePath)) {
      fail("BP_U01_SNAPSHOT_PROVENANCE_INVALID", input.name ?? "input");
    }
    if (!/^[a-f0-9]{64}$/.test(input.sourceSha256 ?? "") || !Number.isInteger(input.sourceByteSize) || input.sourceByteSize < 0) {
      fail("BP_U01_SNAPSHOT_SOURCE_DIGEST_INVALID", input.name ?? "input");
    }
    const file = path.join(snapshotDir, input.snapshotPath);
    if (!existsSync(file)) fail("BP_U01_SNAPSHOT_FILE_MISSING", input.name);
    const bytes = readFileSync(file);
    if (bytes.length !== input.byteSize || sha256(bytes) !== input.sha256) fail("BP_U01_SNAPSHOT_FILE_DRIFT", input.name);
    records.push({kind: input.kind, name: input.name, sourcePath: file, sourceSha256: input.sourceSha256, sourceByteSize: input.sourceByteSize, bytes, sha256: input.sha256, byteSize: input.byteSize});
  }
  validateInputContract(records);
  const derivedMetadata = buildMetadata(records);
  const derivedMetadataDigest = sha256(JSON.stringify(derivedMetadata));
  const declaredMetadata = {
    selectedRunId: manifest.selectedRunId,
    measurementSchemaVersions: manifest.measurementSchemaVersions,
    measurementBases: manifest.measurementBases,
    ranges: manifest.ranges,
    counts: manifest.counts,
    phaseCoverage: manifest.phaseCoverage,
    missingPhases: manifest.missingPhases,
    unclassifiedOperations: manifest.unclassifiedOperations,
    unclassifiedRatio: manifest.unclassifiedRatio,
    ownerCommandOperationsApplicable: manifest.ownerCommandOperationsApplicable,
    ownerCommandOperationsObserved: manifest.ownerCommandOperationsObserved,
    ownerCommandPhaseMissingRequests: manifest.ownerCommandPhaseMissingRequests,
    optimizationStatus: manifest.optimizationStatus,
    dictionaryDigest: manifest.dictionaryDigest,
  };
  if (manifest.metadataDigest !== derivedMetadataDigest || sha256(JSON.stringify(declaredMetadata)) !== manifest.metadataDigest) fail("BP_U01_SNAPSHOT_METADATA_DRIFT");
  if (snapshotDigest(records, derivedMetadata) !== manifest.contentDigest) fail("BP_U01_SNAPSHOT_DIGEST_DRIFT");
  if (!manifest.measurementSchemaVersions?.length || !manifest.measurementBases?.length) fail("BP_U01_SNAPSHOT_MEASUREMENT_METADATA_MISSING");
  if (!manifest.counts || manifest.counts.databaseOperations < 1 || manifest.counts.requests < 1 || manifest.counts.requestEvents < 1) fail("BP_U01_SNAPSHOT_NONEMPTY_GATE_FAILED");
  if (!manifest.phaseCoverage?.includes("EDGE_IN") || !manifest.phaseCoverage?.includes("EDGE_OUT")) fail("BP_U01_SNAPSHOT_PHASE_COVERAGE_REQUIRED");
  if (manifest.optimizationStatus !== derivedMetadata.optimizationStatus) fail("BP_U01_SNAPSHOT_OPTIMIZATION_STATUS_DRIFT");
  return manifest;
}

function selfTest() {
  const directory = fsTempDir();
  try {
    writeFileSync(path.join(directory, "db-operations.jsonl"), `${JSON.stringify({runId: "run-self", requestId: "req-self", correlationId: "corr-self", measurementSchemaVersion: 2, measurementBasis: "TEST", statementId: "stmt", paramsHash: "params", section: "OWNER_READ"})}\n`);
    writeFileSync(path.join(directory, "request-events.jsonl"), `${JSON.stringify({runId: "run-self", requestId: "req-self", correlationId: "corr-self", measurementSchemaVersion: 2, measurementBasis: "TEST", phaseCheckpoints: [{phase: "EDGE_IN"}, {phase: "EDGE_OUT"}]})}\n`);
    writeFileSync(path.join(directory, "statement-dictionary.json"), "{\"stmt\":\"SELECT ?\",\"unrelated\":\"SELECT ignored\"}\n");
    writeFileSync(path.join(directory, "seed-report.json"), "{\"runId\":\"run-self\"}\n");
    writeFileSync(path.join(directory, "run-manifest.json"), "{\"runId\":\"run-self\"}\n");
    const {snapshotDir} = makeSnapshot(directory);
    validateSnapshot(snapshotDir);
    if (Object.keys(readJson(path.join(snapshotDir, "statement-dictionary.json"))).join(",") !== "stmt") fail("BP_U01_STATEMENT_DICTIONARY_SLICE_INVALID");
    const manifestPath = path.join(snapshotDir, "snapshot-manifest.json");
    const originalManifest = readJson(manifestPath);
    chmodSync(manifestPath, 0o600);
    writeFileSync(manifestPath, `${JSON.stringify({...originalManifest, counts: {...originalManifest.counts, databaseOperations: 999}}, null, 2)}\n`);
    try { validateSnapshot(snapshotDir); fail("BP_U01_SNAPSHOT_RED_METADATA_NOT_DETECTED"); }
    catch (error) { if (error.code !== "BP_U01_SNAPSHOT_METADATA_DRIFT") throw error; }
    writeFileSync(manifestPath, `${JSON.stringify(originalManifest, null, 2)}\n`);
    try { chmodSync(manifestPath, 0o400); } catch { /* Windows/non-POSIX */ }
    chmodSync(manifestPath, 0o600);
    const missingProvenance = {...originalManifest, sourceRunDirVerification: "UNMARKED"};
    writeFileSync(manifestPath, `${JSON.stringify(missingProvenance, null, 2)}\n`);
    try { validateSnapshot(snapshotDir); fail("BP_U01_SNAPSHOT_RED_PROVENANCE_NOT_DETECTED"); }
    catch (error) { if (error.code !== "BP_U01_SNAPSHOT_PROVENANCE_INVALID") throw error; }
    writeFileSync(manifestPath, `${JSON.stringify(originalManifest, null, 2)}\n`);
    try { chmodSync(manifestPath, 0o400); } catch { /* Windows/non-POSIX */ }
    rmSync(path.join(snapshotDir, "db-operations.jsonl"));
    try { validateSnapshot(snapshotDir); fail("BP_U01_SNAPSHOT_RED_MUTATION_NOT_DETECTED"); }
    catch (error) { if (error.code !== "BP_U01_SNAPSHOT_FILE_MISSING") throw error; }
    // Managed seed and HTTP runners intentionally use distinct, closed event
    // filenames.  The snapshot keeps the selected physical filename rather
    // than relabelling it as the semantic REQUEST_EVENTS input.
    const aliases = fsTempDir();
    try {
      mkdirSync(path.join(aliases, "evidence"), {recursive: true});
      mkdirSync(path.join(aliases, "seed", "run-self"), {recursive: true});
      writeFileSync(path.join(aliases, "evidence", "db-operations.jsonl"), `${JSON.stringify({runId: "run-alias", requestId: "req-alias", correlationId: "corr-alias", measurementSchemaVersion: 2, measurementBasis: "TEST", section: "OWNER_READ"})}\n`);
      writeFileSync(path.join(aliases, "evidence", "seed-request-events.jsonl"), `${JSON.stringify({runId: "run-alias", requestId: "req-alias", correlationId: "corr-alias", measurementSchemaVersion: 2, measurementBasis: "TEST", phaseCheckpoints: [{phase: "EDGE_IN"}, {phase: "EDGE_OUT"}]})}\n`);
      writeFileSync(path.join(aliases, "evidence", "statement-dictionary.json"), "{}\n");
      writeFileSync(path.join(aliases, "seed", "run-self", "seed-report.json"), "{\"runId\":\"run-alias\"}\n");
      writeFileSync(path.join(aliases, "run-manifest.json"), "{\"runId\":\"run-alias\"}\n");
      const aliasSnapshot = makeSnapshot(aliases);
      const aliasEvents = aliasSnapshot.manifest.inputs.find((input) => input.kind === "REQUEST_EVENTS");
      const aliasReport = aliasSnapshot.manifest.inputs.find((input) => input.kind === "SEED_REPORT");
      if (aliasEvents?.name !== "seed-request-events.jsonl" || aliasReport?.name !== "seed-report.json") fail("BP_U01_SNAPSHOT_ALIAS_NAME_NOT_RECORDED");
      validateSnapshot(aliasSnapshot.snapshotDir);
    } finally { rmSync(aliases, {recursive: true, force: true}); }
    const eventAmbiguity = fsTempDir();
    try {
      writeFileSync(path.join(eventAmbiguity, "db-operations.jsonl"), "{}\n");
      writeFileSync(path.join(eventAmbiguity, "request-events.jsonl"), "{}\n");
      writeFileSync(path.join(eventAmbiguity, "seed-request-events.jsonl"), "{}\n");
      writeFileSync(path.join(eventAmbiguity, "statement-dictionary.json"), "{}\n");
      writeFileSync(path.join(eventAmbiguity, "seed-report.json"), "{\"runId\":\"run-event-ambiguity\"}\n");
      writeFileSync(path.join(eventAmbiguity, "run-manifest.json"), "{\"runId\":\"run-event-ambiguity\"}\n");
      try { makeSnapshot(eventAmbiguity); fail("BP_U01_SNAPSHOT_RED_EVENT_ALIAS_AMBIGUITY_NOT_DETECTED"); }
      catch (error) { if (error.code !== "BP_U01_REQUEST_EVENTS_CARDINALITY_INVALID") throw error; }
    } finally { rmSync(eventAmbiguity, {recursive: true, force: true}); }
    const standardInputAmbiguity = fsTempDir();
    try {
      mkdirSync(path.join(standardInputAmbiguity, "evidence"), {recursive: true});
      writeFileSync(path.join(standardInputAmbiguity, "db-operations.jsonl"), "{}\n");
      writeFileSync(path.join(standardInputAmbiguity, "evidence", "db-operations.jsonl"), "{}\n");
      writeFileSync(path.join(standardInputAmbiguity, "request-events.jsonl"), "{}\n");
      writeFileSync(path.join(standardInputAmbiguity, "statement-dictionary.json"), "{}\n");
      writeFileSync(path.join(standardInputAmbiguity, "seed-report.json"), "{\"runId\":\"run-input-ambiguity\"}\n");
      writeFileSync(path.join(standardInputAmbiguity, "run-manifest.json"), "{\"runId\":\"run-input-ambiguity\"}\n");
      try { makeSnapshot(standardInputAmbiguity); fail("BP_U01_SNAPSHOT_RED_STANDARD_INPUT_AMBIGUITY_NOT_DETECTED"); }
      catch (error) { if (error.code !== "BP_U01_SNAPSHOT_INPUT_CARDINALITY_INVALID") throw error; }
    } finally { rmSync(standardInputAmbiguity, {recursive: true, force: true}); }
    const missingDictionaryEntry = fsTempDir();
    try {
      writeFileSync(path.join(missingDictionaryEntry, "db-operations.jsonl"), `${JSON.stringify({runId: "run-dictionary", requestId: "req-dictionary", correlationId: "corr-dictionary", measurementSchemaVersion: 2, measurementBasis: "TEST", statementId: "missing-statement", section: "OWNER_READ"})}\n`);
      writeFileSync(path.join(missingDictionaryEntry, "request-events.jsonl"), `${JSON.stringify({runId: "run-dictionary", requestId: "req-dictionary", correlationId: "corr-dictionary", measurementSchemaVersion: 2, measurementBasis: "TEST", phaseCheckpoints: [{phase: "EDGE_IN"}, {phase: "EDGE_OUT"}]})}\n`);
      writeFileSync(path.join(missingDictionaryEntry, "statement-dictionary.json"), "{}\n");
      writeFileSync(path.join(missingDictionaryEntry, "seed-report.json"), "{\"runId\":\"run-dictionary\"}\n");
      writeFileSync(path.join(missingDictionaryEntry, "run-manifest.json"), "{\"runId\":\"run-dictionary\"}\n");
      try { makeSnapshot(missingDictionaryEntry); fail("BP_U01_SNAPSHOT_RED_DICTIONARY_ENTRY_NOT_DETECTED"); }
      catch (error) { if (error.code !== "BP_U01_STATEMENT_DICTIONARY_ENTRY_MISSING") throw error; }
    } finally { rmSync(missingDictionaryEntry, {recursive: true, force: true}); }
    const multipleSeedReports = fsTempDir();
    try {
      writeFileSync(path.join(multipleSeedReports, "db-operations.jsonl"), "{}\n");
      writeFileSync(path.join(multipleSeedReports, "seed-request-events.jsonl"), "{}\n");
      writeFileSync(path.join(multipleSeedReports, "statement-dictionary.json"), "{}\n");
      writeFileSync(path.join(multipleSeedReports, "run-manifest.json"), "{\"runId\":\"run-multiple\"}\n");
      for (const runId of ["run-a", "run-b"]) {
        const seedDirectory = path.join(multipleSeedReports, "seed", runId);
        mkdirSync(seedDirectory, {recursive: true});
        writeFileSync(path.join(seedDirectory, "seed-report.json"), "{\"runId\":\"run-multiple\"}\n");
      }
      try { makeSnapshot(multipleSeedReports); fail("BP_U01_SNAPSHOT_RED_SEED_REPORT_CARDINALITY_NOT_DETECTED"); }
      catch (error) { if (error.code !== "BP_U01_SEED_REPORT_CARDINALITY_INVALID") throw error; }
    } finally { rmSync(multipleSeedReports, {recursive: true, force: true}); }
    // Every measured DB/event row must be from the run recorded by the copied
    // manifest.  A historical aggregate is not evidence for the current run.
    const scopeMismatch = fsTempDir();
    try {
      writeFileSync(path.join(scopeMismatch, "db-operations.jsonl"), `${JSON.stringify({runId: "run-db", requestId: "req-db", correlationId: "corr-db", measurementSchemaVersion: 2, measurementBasis: "TEST", section: "OWNER_READ"})}\n`);
      writeFileSync(path.join(scopeMismatch, "request-events.jsonl"), `${JSON.stringify({runId: "run-event", requestId: "req-event", correlationId: "corr-event", measurementSchemaVersion: 2, measurementBasis: "TEST", phaseCheckpoints: [{phase: "EDGE_IN"}, {phase: "EDGE_OUT"}]})}\n`);
      writeFileSync(path.join(scopeMismatch, "statement-dictionary.json"), "{}\n");
      writeFileSync(path.join(scopeMismatch, "seed-report.json"), "{\"runId\":\"run-root\"}\n");
      writeFileSync(path.join(scopeMismatch, "run-manifest.json"), "{\"runId\":\"run-root\"}\n");
      try { makeSnapshot(scopeMismatch); fail("BP_U01_SNAPSHOT_RED_RUN_SCOPE_NOT_DETECTED"); }
      catch (error) { if (error.code !== "BP_U01_SNAPSHOT_RUN_SCOPE_MISMATCH") throw error; }
    } finally { rmSync(scopeMismatch, {recursive: true, force: true}); }
    // Join mismatch is rejected before a snapshot is published even when both
    // inputs have the right run scope.
    const mismatch = fsTempDir();
    try {
      writeFileSync(path.join(mismatch, "db-operations.jsonl"), `${JSON.stringify({runId: "run-join", requestId: "req-db", correlationId: "corr-db", measurementSchemaVersion: 2, measurementBasis: "TEST", section: "OWNER_READ"})}\n`);
      writeFileSync(path.join(mismatch, "request-events.jsonl"), `${JSON.stringify({runId: "run-join", requestId: "req-event", correlationId: "corr-event", measurementSchemaVersion: 2, measurementBasis: "TEST", phaseCheckpoints: [{phase: "EDGE_IN"}, {phase: "EDGE_OUT"}]})}\n`);
      writeFileSync(path.join(mismatch, "statement-dictionary.json"), "{}\n");
      writeFileSync(path.join(mismatch, "seed-report.json"), "{\"runId\":\"run-join\"}\n");
      writeFileSync(path.join(mismatch, "run-manifest.json"), "{\"runId\":\"run-join\"}\n");
      try { makeSnapshot(mismatch); fail("BP_U01_SNAPSHOT_RED_JOIN_NOT_DETECTED"); }
      catch (error) { if (error.code !== "BP_U01_DB_EVENT_JOIN_MISSING") throw error; }
    } finally { rmSync(mismatch, {recursive: true, force: true}); }
    const unclassified = fsTempDir();
    try {
      writeFileSync(path.join(unclassified, "db-operations.jsonl"), `${JSON.stringify({runId: "run-unclassified", requestId: "req-unclassified", correlationId: "corr-unclassified", measurementSchemaVersion: 2, measurementBasis: "TEST", section: "UNCLASSIFIED"})}\n`);
      writeFileSync(path.join(unclassified, "request-events.jsonl"), `${JSON.stringify({runId: "run-unclassified", requestId: "req-unclassified", correlationId: "corr-unclassified", measurementSchemaVersion: 2, measurementBasis: "TEST", phaseCheckpoints: [{phase: "EDGE_IN"}, {phase: "EDGE_OUT"}]})}\n`);
      writeFileSync(path.join(unclassified, "statement-dictionary.json"), "{}\n");
      writeFileSync(path.join(unclassified, "seed-report.json"), "{\"runId\":\"run-unclassified\"}\n");
      writeFileSync(path.join(unclassified, "run-manifest.json"), "{\"runId\":\"run-unclassified\"}\n");
      const result = makeSnapshot(unclassified);
      if (result.manifest.optimizationStatus !== "UNMEASURED_BLOCKS_OPTIMIZATION") fail("BP_U01_SNAPSHOT_UNCLASSIFIED_STATUS_MISSING");
      validateSnapshot(result.snapshotDir);
    } finally { rmSync(unclassified, {recursive: true, force: true}); }
    const missingOwnerCommandPhase = fsTempDir();
    try {
      writeFileSync(path.join(missingOwnerCommandPhase, "db-operations.jsonl"), `${JSON.stringify({runId: "run-owner-phase", requestId: "req-owner-phase", correlationId: "corr-owner-phase", measurementSchemaVersion: 2, measurementBasis: "TEST", section: "OWNER_WRITE"})}\n`);
      writeFileSync(path.join(missingOwnerCommandPhase, "request-events.jsonl"), `${JSON.stringify({runId: "run-owner-phase", requestId: "req-owner-phase", correlationId: "corr-owner-phase", operationId: "stagePlatformAsset", measurementSchemaVersion: 2, measurementBasis: "TEST", phaseCheckpoints: [{phase: "EDGE_IN"}, {phase: "EDGE_OUT"}]})}\n`);
      writeFileSync(path.join(missingOwnerCommandPhase, "statement-dictionary.json"), "{}\n");
      writeFileSync(path.join(missingOwnerCommandPhase, "seed-report.json"), "{\"runId\":\"run-owner-phase\"}\n");
      writeFileSync(path.join(missingOwnerCommandPhase, "run-manifest.json"), "{\"runId\":\"run-owner-phase\"}\n");
      const result = makeSnapshot(missingOwnerCommandPhase);
      if (result.manifest.optimizationStatus !== "UNMEASURED_BLOCKS_OPTIMIZATION" || result.manifest.ownerCommandPhaseMissingRequests.length !== 1) {
        fail("BP_U01_OWNER_COMMAND_PHASE_STATUS_MISSING");
      }
      validateSnapshot(result.snapshotDir);
    } finally { rmSync(missingOwnerCommandPhase, {recursive: true, force: true}); }
    // Platform credential and session protocols intentionally use the same
    // PLATFORM_COMMAND_CONTEXT as owner commands today.  Their exemption must
    // therefore come from the binding's explicit commandBoundary, never from
    // a context-kind suffix or a one-off operation set in this gate.
    const protocolBoundary = fsTempDir();
    try {
      writeFileSync(path.join(protocolBoundary, "db-operations.jsonl"), `${JSON.stringify({runId: "run-protocol-boundary", requestId: "req-protocol-boundary", correlationId: "corr-protocol-boundary", measurementSchemaVersion: 2, measurementBasis: "TEST", section: "SESSION"})}\n`);
      writeFileSync(path.join(protocolBoundary, "request-events.jsonl"), `${JSON.stringify({runId: "run-protocol-boundary", requestId: "req-protocol-boundary", correlationId: "corr-protocol-boundary", operationId: "platformLogout", measurementSchemaVersion: 2, measurementBasis: "TEST", phaseCheckpoints: [{phase: "EDGE_IN"}, {phase: "SESSION_RESOLVED"}, {phase: "AUTHORIZED"}, {phase: "SCOPE_RESOLVED"}, {phase: "READBACK_END"}, {phase: "EDGE_OUT"}]})}\n`);
      writeFileSync(path.join(protocolBoundary, "statement-dictionary.json"), "{}\n");
      writeFileSync(path.join(protocolBoundary, "seed-report.json"), "{\"runId\":\"run-protocol-boundary\"}\n");
      writeFileSync(path.join(protocolBoundary, "run-manifest.json"), "{\"runId\":\"run-protocol-boundary\"}\n");
      const result = makeSnapshot(protocolBoundary);
      if (result.manifest.ownerCommandPhaseMissingRequests.length !== 0 || result.manifest.ownerCommandOperationsObserved !== 0) {
        fail("BP_U01_PROTOCOL_COMMAND_BOUNDARY_IGNORED");
      }
      validateSnapshot(result.snapshotDir);
    } finally { rmSync(protocolBoundary, {recursive: true, force: true}); }
    process.stdout.write("BP_U01_EVIDENCE_SNAPSHOT_SELF_TEST=PASS\nRED=BP_U01_SNAPSHOT_FILE_MISSING,BP_U01_SNAPSHOT_DIGEST_DRIFT,BP_U01_SNAPSHOT_METADATA_DRIFT,BP_U01_SNAPSHOT_PROVENANCE_INVALID,BP_U01_DB_EVENT_JOIN_MISSING,BP_U01_SNAPSHOT_RUN_SCOPE_MISMATCH,BP_U01_STATEMENT_DICTIONARY_ENTRY_MISSING,BP_U01_SNAPSHOT_NONEMPTY_GATE_FAILED,BP_U01_SNAPSHOT_PHASE_COVERAGE_REQUIRED,BP_U01_SNAPSHOT_UNCLASSIFIED_STATUS_MISSING,BP_U01_OWNER_COMMAND_PHASE_STATUS_MISSING,BP_U01_REQUEST_EVENTS_CARDINALITY_INVALID,BP_U01_SNAPSHOT_INPUT_CARDINALITY_INVALID,BP_U01_SEED_REPORT_CARDINALITY_INVALID\n");
  } finally { rmSync(directory, {recursive: true, force: true}); }
}

function fsTempDir() { const directory = path.join(os.tmpdir(), `v2s-bp-u01-${process.pid}-${Date.now()}`); mkdirSync(directory, {recursive: true}); return directory; }

async function runCli() {
  const args = process.argv.slice(2);
  try {
    if (args.length === 1 && args[0] === "--self-test") selfTest();
    else if (args[0] === "--create" && args[1] === "--run-dir" && args[2]) { const result = makeSnapshot(args[2]); process.stdout.write(`BP_U01_EVIDENCE_SNAPSHOT=PASS\nSNAPSHOT=${result.snapshotDir}\nDIGEST=${result.manifest.contentDigest}\n`); }
    else if (args[0] === "--check" && args[1] && (args.length === 2 || (args.length === 3 && args[2] === "--final"))) {
      const manifest = validateSnapshot(path.resolve(args[1]));
      if (args[2] === "--final") {
        const finalAcceptance = await import(pathToFileURL(path.join(ROOT, "scripts/test/backend-performance-final-acceptance.mjs")).href);
        await finalAcceptance.validateFinalSnapshot(path.resolve(args[1]));
        process.stdout.write(`BP_U01_EVIDENCE_SNAPSHOT_CHECK=PASS\nFINAL_ADMISSION=PASS\nDIGEST=${manifest.contentDigest}\n`);
      } else process.stdout.write(`BP_U01_EVIDENCE_SNAPSHOT_CHECK=PASS\nDIGEST=${manifest.contentDigest}\n`);
    }
    else fail("BP_U01_EVIDENCE_SNAPSHOT_ARGUMENT_INVALID");
  } catch (error) { process.stderr.write(`${error.code || "BP_U01_EVIDENCE_SNAPSHOT_FAIL"}: ${error.message}\n`); process.exitCode = 1; }
}

const invokedPath = process.argv[1] ? pathToFileURL(path.resolve(process.argv[1])).href : null;
if (invokedPath === import.meta.url) runCli();

export {makeSnapshot, selfTest, validateSnapshot, runCli};
