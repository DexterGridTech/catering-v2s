#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
if [[ "${1:-}" == "--self-test" && $# -eq 1 ]]; then
  node "$repo_root/tools/verify-gates/cli.mjs" budget --self-test
  node "$repo_root/scripts/generate/backend-performance-operation-database-shape.mjs" --self-test
else
  node "$repo_root/tools/verify-gates/cli.mjs" budget "$@"
  node "$repo_root/scripts/generate/backend-performance-operation-database-shape.mjs" --check
fi
