#!/usr/bin/env node

import {createHash, createHmac, timingSafeEqual} from "node:crypto";
import {readFileSync, readdirSync, existsSync, statSync} from "node:fs";
import path from "node:path";
import {fileURLToPath} from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
const contractPath = "contracts/policy/backend-performance-request-fact-load-once.json";
const loaderPath = "contracts/registry/backend-performance-fact-loader-catalog.json";
const inventoryPath = "contracts/registry/backend-performance-operation-source-inventory.json";
const shapePath = "contracts/registry/backend-performance-operation-database-shape-matrix.json";
const diagnostics = " WHY=request-local fact attribution is not source-closed or its immutable snapshot is unverifiable; BACKGROUND=BPF-U03 separates static caller admission from runtime at-most-once evidence; PATTERN=unlisted caller, duplicate/unknown/missing loader or invalid HMAC must red";

const fail = (code, detail = "") => { throw new Error(`${code}${detail ? `:${detail}` : ""}${diagnostics}`); };
const read = (relative) => {
  try { return readFileSync(path.join(root, relative), "utf8"); }
  catch { fail("BP_U03_FACT_INPUT_MISSING", relative); }
};
const json = (relative) => {
  try { return JSON.parse(read(relative)); }
  catch { fail("BP_U03_FACT_INPUT_INVALID", relative); }
};
const sha256 = (value) => createHash("sha256").update(value).digest("hex");
const pretty = (value) => JSON.stringify(value, null, 2);
const exactSet = (actual, expected, code) => {
  const a = [...actual].sort();
  const e = [...expected].sort();
  if (a.length !== e.length || new Set(a).size !== a.length || a.some((value, index) => value !== e[index])) fail(code);
};

function javaFiles() {
  const roots = [
    path.join(root, "apps/backend/catering-business-server/src/main/java"),
    path.join(root, "apps/backend/catering-business-server/modules"),
  ];
  const result = [];
  const walk = (directory) => {
    if (!existsSync(directory)) return;
    for (const entry of readdirSync(directory, {withFileTypes: true})) {
      const absolute = path.join(directory, entry.name);
      if (entry.isDirectory()) walk(absolute);
      else if (entry.isFile() && entry.name.endsWith(".java") && !absolute.includes("/src/test/")) {
        result.push(path.relative(root, absolute).split(path.sep).join("/"));
      }
    }
  };
  roots.forEach(walk);
  return result.sort();
}

function splitAnchor(anchor) {
  if (typeof anchor !== "string" || !/^[^#]+#[A-Za-z_$][\w$]*$/.test(anchor)) fail("BP_U03_FACT_SOURCE_ANCHOR_INVALID", anchor);
  const separator = anchor.lastIndexOf("#");
  return {path: anchor.slice(0, separator), selector: anchor.slice(separator + 1)};
}

function sourcePathFromAnchor(anchor) { return splitAnchor(anchor).path; }

function sourceCallers(loader) {
  const sourcePath = sourcePathFromAnchor(loader.sourceAnchor);
  const files = javaFiles();
  return files.filter((relative) => {
    if (relative === sourcePath) return loader.loaderId === "SESSION_ENTRY_AUTHENTICATION_FACT" && read(relative).includes(loader.invocationPattern);
    return read(relative).includes(loader.invocationPattern);
  });
}

function validateContract(contract) {
  if (contract?.schemaVersion !== 1 || contract.kind !== "backend-performance-request-fact-load-once" || contract.status !== "ACTIVE_STATIC_RUNTIME_ADMISSION") fail("BP_U03_FACT_CONTRACT_INVALID");
  if (contract.denominator?.operations !== 196 || contract.denominator?.loaders !== 10 || contract.denominator?.m1Operations !== 68) fail("BP_U03_FACT_DENOMINATOR_INVALID");
  if (contract.staticAdmission?.runtimeClaim !== "STATIC_SOURCE_CLOSURE_ONLY") fail("BP_U03_FACT_STATIC_RUNTIME_CLAIM_INVALID");
  const required = ["runId", "correlationId", "requestId", "operationId", "loaderId", "callSitePrefix", "seq", "factLoadHmac"];
  exactSet(contract.runtimeSnapshot?.requiredFields ?? [], required, "BP_U03_FACT_RUNTIME_FIELD_SET_DRIFT");
  exactSet(contract.runtimeSnapshot?.duplicateTuple ?? [], ["runId", "correlationId", "requestId", "loaderId", "callSitePrefix"], "BP_U03_FACT_RUNTIME_TUPLE_DRIFT");
  exactSet(contract.runtimeSnapshot?.hmac?.canonicalTuple ?? [], required.filter((field) => field !== "factLoadHmac"), "BP_U03_FACT_RUNTIME_CANONICAL_DRIFT");
}

function loaderDigest(loader) { return sha256(pretty(loader)); }

function validateStatic({contract = json(contractPath), loaders = json(loaderPath), inventory = json(inventoryPath), shape = json(shapePath)} = {}) {
  validateContract(contract);
  if (loaders?.schemaVersion !== 1 || loaders.kind !== "backend-performance-fact-loader-catalog" || loaders.status !== "SOURCE_VERIFIED_STATIC" || !Array.isArray(loaders.rows) || loaders.rows.length !== 10 || loaders.denominator?.loaderCount !== 10 || loaders.denominator?.M1OperationCount !== 68) fail("BP_U03_FACT_LOADER_CATALOG_INVALID");
  if (inventory?.schemaVersion !== 1 || inventory.kind !== "backend-performance-operation-source-inventory" || inventory.status !== "SOURCE_VERIFIED_STATIC" || !Array.isArray(inventory.rows) || inventory.rows.length !== 196) fail("BP_U03_FACT_SOURCE_INVENTORY_INVALID");
  if (shape?.schemaVersion !== 1 || shape.kind !== "backend-performance-operation-database-shape-matrix" || !Array.isArray(shape.rows) || shape.rows.length !== 196) fail("BP_U03_FACT_SHAPE_MATRIX_INVALID");
  const loaderById = new Map();
  for (const loader of loaders.rows) {
    if (!loader || typeof loader.loaderId !== "string" || loaderById.has(loader.loaderId) || !Array.isArray(loader.allowedCallerPaths) || !Array.isArray(loader.declaredOperationIds)) fail("BP_U03_FACT_LOADER_ROW_INVALID", loader?.loaderId ?? "UNSET");
    const source = sourcePathFromAnchor(loader.sourceAnchor);
    const sourceText = read(source);
    if (!sourceText || !sourceText.includes(loader.invocationPattern) || loader.sourceSha256 !== sha256(sourceText)) fail("BP_U03_FACT_LOADER_SOURCE_HASH_DRIFT", loader.loaderId);
    const scannedCallers = sourceCallers(loader);
    const actualCallers = scannedCallers.length ? scannedCallers : [source];
    exactSet(loader.allowedCallerPaths, actualCallers, "BP_U03_FACT_CALLER_SET_DRIFT:" + loader.loaderId);
    if (!loader.allowedCallerPaths.every((relative) => typeof relative === "string" && relative.endsWith(".java"))) fail("BP_U03_FACT_CALLER_PATH_INVALID", loader.loaderId);
    if (!loader.callerAdmission || !["SOURCE_SCANNED_CALLERS", "M1_MATRIX_DECLARED_CALLERS"].includes(loader.callerAdmission)) fail("BP_U03_FACT_CALLER_ADMISSION_INVALID", loader.loaderId);
    loaderById.set(loader.loaderId, loader);
  }
  const operationById = new Map();
  for (const row of inventory.rows) {
    if (!row || typeof row.operationId !== "string" || operationById.has(row.operationId)) fail("BP_U03_FACT_OPERATION_DENOMINATOR_DRIFT", row?.operationId ?? "UNSET");
    if (!Array.isArray(row.factLoaderRefs) || new Set(row.factLoaderRefs.map((entry) => entry?.loaderId)).size !== row.factLoaderRefs.length) fail("BP_U03_FACT_LOADER_DUPLICATE_DECLARATION", row.operationId);
    for (const ref of row.factLoaderRefs) {
      const loader = loaderById.get(ref?.loaderId);
      if (!loader) fail("BP_U03_FACT_UNKNOWN_LOADER_ATTRIBUTION", `${row.operationId}:${ref?.loaderId ?? "UNSET"}`);
      if (ref.loaderDigest !== loaderDigest(loader)) fail("BP_U03_FACT_LOADER_DIGEST_DRIFT", `${row.operationId}:${ref.loaderId}`);
    }
    operationById.set(row.operationId, row);
  }
  exactSet(operationById.keys(), shape.rows.map((row) => row?.operationId), "BP_U03_FACT_SHAPE_OPERATION_SET_DRIFT");
  for (const loader of loaders.rows.filter((row) => row.callerAdmission === "M1_MATRIX_DECLARED_CALLERS")) {
    const derived = inventory.rows.filter((row) => row.factLoaderRefs.some((ref) => ref.loaderId === loader.loaderId)).map((row) => row.operationId);
    exactSet(loader.declaredOperationIds, derived, "BP_U03_FACT_M1_OPERATION_SET_DRIFT:" + loader.loaderId);
  }
  for (const loader of loaders.rows.filter((row) => row.callerAdmission === "SOURCE_SCANNED_CALLERS")) {
    const scannedCallers = sourceCallers(loader);
    exactSet(loader.declaredOperationIds, scannedCallers, "BP_U03_FACT_SOURCE_DECLARATION_DRIFT:" + loader.loaderId);
  }
  return {operations: operationById, loaders: loaderById};
}

function base64Key(key) {
  if (typeof key !== "string" || key.length === 0) fail("BP_U03_FACT_HMAC_KEY_REQUIRED");
  let decoded;
  try { decoded = Buffer.from(key, "base64url"); } catch { fail("BP_U03_FACT_HMAC_KEY_INVALID"); }
  if (decoded.length < 16) fail("BP_U03_FACT_HMAC_KEY_INVALID");
  return decoded;
}

function canonical(event) {
  return [event.runId, event.correlationId, event.requestId, event.operationId, event.loaderId, event.callSitePrefix, String(event.seq)].join("\u0000");
}

function hmacFor(event, key) { return createHmac("sha256", key).update(canonical(event)).digest("base64url"); }

function validateHmac(event, key) {
  if (typeof event.factLoadHmac !== "string" || !/^[A-Za-z0-9_-]{43}$/.test(event.factLoadHmac)) fail("BP_U03_FACT_HMAC_INVALID", event.loaderId);
  const actual = Buffer.from(event.factLoadHmac);
  const expected = Buffer.from(hmacFor(event, key));
  if (actual.length !== expected.length || !timingSafeEqual(actual, expected)) fail("BP_U03_FACT_HMAC_INVALID", event.loaderId);
}

export function validateFactLoadSnapshot({events, key, expectedRunId, expectedOperationId, staticState = validateStatic()} = {}) {
  const hmacKey = base64Key(key);
  if (!Array.isArray(events) || events.length === 0) fail("BP_U03_FACT_SNAPSHOT_EMPTY");
  if (typeof expectedRunId !== "string" || !expectedRunId || typeof expectedOperationId !== "string" || !expectedOperationId) fail("BP_U03_FACT_SNAPSHOT_SCOPE_INVALID");
  const operation = staticState.operations.get(expectedOperationId);
  if (!operation) fail("BP_U03_FACT_UNKNOWN_OPERATION", expectedOperationId);
  const expectedLoaderIds = operation.factLoaderRefs.map((ref) => ref.loaderId);
  const seen = new Set();
  for (const event of events) {
    if (!event || event.eventKind !== "FACT_LOADED" || ["runId", "correlationId", "requestId", "operationId", "loaderId", "callSitePrefix", "seq", "factLoadHmac"].some((field) => event[field] === undefined || event[field] === null || event[field] === "")) fail("BP_U03_FACT_EVENT_SHAPE_INVALID");
    if (event.runId !== expectedRunId || event.operationId !== expectedOperationId) fail("BP_U03_FACT_SNAPSHOT_SCOPE_INVALID");
    if (!staticState.loaders.has(event.loaderId)) fail("BP_U03_FACT_UNKNOWN_LOADER_ATTRIBUTION", event.loaderId);
    const loader = staticState.loaders.get(event.loaderId);
    if (loader.callSitePrefix !== event.callSitePrefix || !expectedLoaderIds.includes(event.loaderId)) fail("BP_U03_FACT_UNKNOWN_LOADER_ATTRIBUTION", event.loaderId);
    if (!Number.isInteger(event.seq) || event.seq < 1) fail("BP_U03_FACT_EVENT_SEQUENCE_INVALID", event.loaderId);
    const tuple = [event.runId, event.correlationId, event.requestId, event.loaderId, event.callSitePrefix].join("\u0000");
    if (seen.has(tuple)) fail("BP_U03_FACT_LOADER_DUPLICATE", event.loaderId);
    seen.add(tuple);
    validateHmac(event, hmacKey);
  }
  exactSet(seenLoaderIds(events), expectedLoaderIds, "BP_U03_FACT_MISSING_ATTRIBUTION");
  const requestTuples = new Set(events.map((event) => [event.runId, event.correlationId, event.requestId].join("\u0000")));
  if (requestTuples.size !== 1) fail("BP_U03_FACT_SNAPSHOT_REQUEST_TUPLE_DRIFT");
  return Object.freeze({runId: expectedRunId, operationId: expectedOperationId, requestId: events[0].requestId, loaders: Object.freeze([...seenLoaderIds(events)].sort()), eventCount: events.length});
}

function seenLoaderIds(events) { return [...new Set(events.map((event) => event.loaderId))]; }

function selfTest() {
  const expected = validateStatic();
  const first = [...expected.operations.values()].find((row) => row.factLoaderRefs.length >= 2);
  if (!first) fail("BP_U03_FACT_SELF_TEST_FIXTURE_MISSING");
  const key = Buffer.from("bpf-u03-self-test-key-20260811").toString("base64url");
  const events = first.factLoaderRefs.map((ref, index) => {
    const loader = expected.loaders.get(ref.loaderId);
    const event = {eventKind: "FACT_LOADED", runId: "bpf-u03-run", correlationId: "bpf-u03-correlation", requestId: "bpf-u03-request", operationId: first.operationId, loaderId: loader.loaderId, callSitePrefix: loader.callSitePrefix, seq: index + 1};
    return {...event, factLoadHmac: hmacFor(event, base64Key(key))};
  });
  validateFactLoadSnapshot({events, key, expectedRunId: "bpf-u03-run", expectedOperationId: first.operationId, staticState: expected});
  const expectRed = (mutation, code, label) => {
    const copy = structuredClone(events); mutation(copy);
    try { validateFactLoadSnapshot({events: copy, key, expectedRunId: "bpf-u03-run", expectedOperationId: first.operationId, staticState: expected}); fail("BP_U03_FACT_SELF_TEST_RED_NOT_DETECTED", label); }
    catch (error) { if (!String(error.message).startsWith(code)) throw error; }
  };
  expectRed((copy) => copy.push(copy[0]), "BP_U03_FACT_LOADER_DUPLICATE", "duplicate");
  expectRed((copy) => { copy[0].loaderId = "UNKNOWN"; }, "BP_U03_FACT_UNKNOWN_LOADER_ATTRIBUTION", "unknown");
  expectRed((copy) => { copy.pop(); }, "BP_U03_FACT_MISSING_ATTRIBUTION", "missing");
  expectRed((copy) => { copy[0].factLoadHmac = "A".repeat(43); }, "BP_U03_FACT_HMAC_INVALID", "hmac");
  const callerMutation = structuredClone(json(loaderPath));
  callerMutation.rows[0].allowedCallerPaths.push("apps/backend/catering-business-server/src/main/java/UnlistedFactLoaderCaller.java");
  try { validateStatic({loaders: callerMutation, inventory: json(inventoryPath), shape: json(shapePath)}); fail("BP_U03_FACT_SELF_TEST_RED_NOT_DETECTED", "caller"); }
  catch (error) { if (!String(error.message).startsWith("BP_U03_FACT_CALLER_SET_DRIFT")) throw error; }
  process.stdout.write("BP_U03_FACT_LOAD_ONCE_SELF_TEST=PASS\nSTATIC_OPERATIONS=196\nSTATIC_LOADERS=10\nRED_UNLISTED_CALLER=PASS\nRED_DUPLICATE_EVENT=PASS\nRED_UNKNOWN_ATTRIBUTION=PASS\nRED_MISSING_ATTRIBUTION=PASS\nRED_INVALID_HMAC=PASS\nRUNTIME_SNAPSHOT=SELF_TEST_ONLY\nCLEANUP=PASS\n");
}

function main() {
  const [argument, snapshotPath] = process.argv.slice(2);
  if (argument === "--self-test" && snapshotPath === undefined) return selfTest();
  if (argument === "--check" && snapshotPath === undefined) {
    const result = validateStatic();
    process.stdout.write(`BP_U03_FACT_LOAD_ONCE_STATIC_CHECK=PASS\nOPERATIONS=${result.operations.size}\nLOADERS=${result.loaders.size}\nRUNTIME_SNAPSHOT=NOT_RUN_STATIC_ONLY\n`);
    return;
  }
  if (argument === "--snapshot" && snapshotPath) {
    const payload = json(path.relative(root, path.resolve(snapshotPath)));
    const result = validateFactLoadSnapshot({events: Array.isArray(payload) ? payload : payload.events, key: process.env.V2S_DB_OPERATIONS_HMAC_KEY, expectedRunId: payload.expectedRunId, expectedOperationId: payload.expectedOperationId});
    process.stdout.write(`BP_U03_FACT_LOAD_ONCE_SNAPSHOT=PASS\nOPERATION=${result.operationId}\nLOADERS=${result.loaders.length}\nEVENTS=${result.eventCount}\n`);
    return;
  }
  fail("BP_U03_FACT_LOAD_ONCE_ARGUMENT_INVALID");
}

try { main(); }
catch (error) { process.stderr.write(`${error.message}\n`); process.exitCode = 1; }
