#!/usr/bin/env node

import assert from "node:assert/strict";
import childProcess from "node:child_process";
import crypto from "node:crypto";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

const phaseOrder = new Map([
  ["R2", 2],
  ["R3", 3],
  ["R4", 4],
  ["R5", 5],
  ["R6", 6],
]);

function sha256(value) {
  return crypto.createHash("sha256").update(value).digest("hex");
}

function fail(reason) {
  throw new Error(reason);
}

function parseStructuralRules(source) {
  const units = [];
  const numberedOrdinals = new Map();
  const bulletOrdinals = new Map();
  const tableOrdinals = new Map();
  let part = "";
  let section = "";
  let inTable = false;
  let tableRowIndex = 0;

  for (const line of source.split("\n")) {
    if (line.startsWith("## Part B.")) {
      part = "B";
      section = "";
    } else if (line.startsWith("## Part C.")) {
      part = "C";
      section = "C";
    } else if (line.startsWith("## Part D.")) {
      part = "D";
      section = "";
    } else if (line.startsWith("## Part ") && !/^## Part [BCD]\./.test(line)) {
      part = "";
      section = "";
    }

    const sectionMatch = line.match(/^### ([BD]\.\d+)\b/);
    if (sectionMatch) {
      section = sectionMatch[1];
    }

    if (line.startsWith("|") && (part === "C" || part === "D")) {
      if (!inTable) {
        inTable = true;
        tableRowIndex = 0;
      }
      tableRowIndex += 1;
      if (tableRowIndex <= 2) {
        continue;
      }
      const key = section || part;
      const ordinal = (tableOrdinals.get(key) || 0) + 1;
      tableOrdinals.set(key, ordinal);
      units.push({
        ruleId:
          part === "C"
            ? `C.T${String(ordinal).padStart(2, "0")}`
            : `${section}.T${String(ordinal).padStart(2, "0")}`,
        section: section || part,
        type: "TABLE",
        ordinal,
        textSha256: sha256(line),
      });
      continue;
    }
    inTable = false;

    if (part === "B" && /^(\d+)\.\s/.test(line)) {
      const ordinal = (numberedOrdinals.get(section) || 0) + 1;
      numberedOrdinals.set(section, ordinal);
      units.push({
        ruleId: `${section}.N${String(ordinal).padStart(2, "0")}`,
        section,
        type: "NUMBERED",
        ordinal,
        textSha256: sha256(line),
      });
    } else if (part === "D" && line.startsWith("- ")) {
      const ordinal = (bulletOrdinals.get(section) || 0) + 1;
      bulletOrdinals.set(section, ordinal);
      units.push({
        ruleId: `${section}.L${String(ordinal).padStart(2, "0")}`,
        section,
        type: "BULLET",
        ordinal,
        textSha256: sha256(line),
      });
    }
  }

  return {
    units,
    counts: {
      partBNumbered: units.filter((unit) => unit.type === "NUMBERED").length,
      partCTableRows: units.filter(
        (unit) => unit.section === "C" && unit.type === "TABLE",
      ).length,
      partDBullets: units.filter(
        (unit) => unit.section.startsWith("D.") && unit.type === "BULLET",
      ).length,
      partDTableRows: units.filter(
        (unit) => unit.section.startsWith("D.") && unit.type === "TABLE",
      ).length,
      total: units.length,
    },
  };
}

function readMatrix(root, matrixPath) {
  const absolutePath = path.join(root, matrixPath);
  if (!fs.existsSync(absolutePath)) {
    fail(`MATRIX_NOT_FOUND:${matrixPath}`);
  }
  try {
    return JSON.parse(fs.readFileSync(absolutePath, "utf8"));
  } catch {
    fail(`MATRIX_INVALID_JSON:${matrixPath}`);
  }
}

function validateMemoryRef(root, ruleId, memoryRef) {
  const [relativePath, assertionKey] = memoryRef.split("#");
  if (
    !relativePath ||
    !assertionKey ||
    relativePath === "project-memory/index.md" ||
    !/^project-memory\/(kernel|decisions|operations|pitfalls)\/[^/]+\.md$/.test(
      relativePath,
    )
  ) {
    fail(`MEMORY_REF_INVALID:${ruleId}:${memoryRef}`);
  }
  const absolutePath = path.join(root, relativePath);
  if (!fs.existsSync(absolutePath)) {
    fail(`MEMORY_REF_NOT_FOUND:${ruleId}:${relativePath}`);
  }
  if (!fs.readFileSync(absolutePath, "utf8").includes(assertionKey)) {
    fail(`MEMORY_ASSERTION_NOT_FOUND:${ruleId}:${memoryRef}`);
  }
}

function validateCoverage({
  root,
  matrixPath = "contracts/policy/standards-coverage-matrix.json",
  matrix,
  phase = "R2",
}) {
  const candidate = matrix || readMatrix(root, matrixPath);
  if (
    candidate.schemaVersion !== 1 ||
    candidate.kind !== "standards-coverage-matrix" ||
    candidate.programId !== "V2S_W0_W4_EXECUTION"
  ) {
    fail("MATRIX_IDENTITY_INVALID");
  }
  const phaseAliases = candidate.phaseAliases || {};
  if (typeof phaseAliases !== "object" || Array.isArray(phaseAliases)
    || Object.entries(phaseAliases).some(([alias, target]) => !alias || !phaseOrder.has(target))) {
    fail("PHASE_ALIAS_INVALID");
  }
  const effectivePhase = phaseAliases[phase] || phase;
  if (!phaseOrder.has(effectivePhase)) {
    fail(`UNKNOWN_PHASE:${phase}`);
  }
  const sourcePath = candidate.source?.path;
  const sourceAbsolutePath = sourcePath && path.join(root, sourcePath);
  if (!sourcePath || !fs.existsSync(sourceAbsolutePath)) {
    fail(`SOURCE_NOT_FOUND:${sourcePath || "UNSET"}`);
  }
  const source = fs.readFileSync(sourceAbsolutePath, "utf8");
  if (sha256(source) !== candidate.source.sha256) {
    fail("SOURCE_HASH_DRIFT");
  }
  if (candidate.source.parser !== "MARKDOWN_STRUCTURAL_RULES_V1") {
    fail("SOURCE_PARSER_INVALID");
  }

  const parsed = parseStructuralRules(source);
  if (
    JSON.stringify(parsed.counts) !==
    JSON.stringify(candidate.source.expectedCounts)
  ) {
    fail("SOURCE_COUNT_MISMATCH");
  }
  if (!Array.isArray(candidate.rules)) {
    fail("RULES_NOT_ARRAY");
  }
  const rulesById = new Map();
  for (const rule of candidate.rules) {
    if (!rule?.ruleId || rulesById.has(rule.ruleId)) {
      fail(`RULE_ID_INVALID_OR_DUPLICATE:${rule?.ruleId || "UNSET"}`);
    }
    rulesById.set(rule.ruleId, rule);
  }
  if (
    candidate.rules.length !== parsed.units.length ||
    parsed.units.some((unit) => !rulesById.has(unit.ruleId))
  ) {
    fail("SOURCE_DENOMINATOR_MISMATCH");
  }

  const checklistIds = new Set();
  for (const checklist of candidate.reviewChecklists || []) {
    if (
      !checklist?.id ||
      checklistIds.has(checklist.id) ||
      !checklist.owner ||
      !checklist.requiredEvidence
    ) {
      fail(`REVIEW_CHECKLIST_INVALID:${checklist?.id || "UNSET"}`);
    }
    checklistIds.add(checklist.id);
  }

  for (const unit of parsed.units) {
    const rule = rulesById.get(unit.ruleId);
    if (
      rule.source?.section !== unit.section ||
      rule.source?.type !== unit.type ||
      rule.source?.ordinal !== unit.ordinal ||
      rule.source?.textSha256 !== unit.textSha256
    ) {
      fail(`SOURCE_UNIT_DRIFT:${unit.ruleId}`);
    }
    if (!Array.isArray(rule.memoryRefs) || rule.memoryRefs.length === 0) {
      fail(`MEMORY_REF_MISSING:${unit.ruleId}`);
    }
    for (const memoryRef of rule.memoryRefs) {
      validateMemoryRef(root, unit.ruleId, memoryRef);
    }

    const enforcement = rule.enforcement;
    const allowedKinds = new Set([
      "GATE",
      "ARCHUNIT",
      "NEGATIVE_FIXTURE",
      "UNENFORCEABLE_BY_MACHINE",
    ]);
    if (!enforcement || !allowedKinds.has(enforcement.kind)) {
      fail(`ENFORCEMENT_KIND_INVALID:${unit.ruleId}`);
    }
    if (!phaseOrder.has(enforcement.enforcementPhase)) {
      fail(`ENFORCEMENT_PHASE_INVALID:${unit.ruleId}`);
    }
    if (enforcement.kind === "UNENFORCEABLE_BY_MACHINE") {
      if (
        enforcement.status !== "ACTIVE" ||
        !enforcement.reviewChecklistRef ||
        !checklistIds.has(enforcement.reviewChecklistRef)
      ) {
        fail(`REVIEW_CHECKLIST_REF_MISSING:${unit.ruleId}`);
      }
      continue;
    }
    if (!["ACTIVE", "PLANNED"].includes(enforcement.status)) {
      fail(`ENFORCEMENT_STATUS_INVALID:${unit.ruleId}`);
    }
    if (!enforcement.ref) {
      fail(`ENFORCEMENT_REF_MISSING:${unit.ruleId}`);
    }
    if (
      enforcement.status === "PLANNED" &&
      phaseOrder.get(enforcement.enforcementPhase) <= phaseOrder.get(effectivePhase)
    ) {
      fail(`PLANNED_ENFORCEMENT_OVERDUE:${unit.ruleId}`);
    }
    if (enforcement.status === "ACTIVE") {
      const refPath = enforcement.ref.split("#")[0];
      if (!fs.existsSync(path.join(root, refPath))) {
        fail(`ENFORCEMENT_REF_MISSING:${unit.ruleId}:${refPath}`);
      }
    }
  }
  return true;
}

function activeRefDenominator(matrix) {
  const refs = new Map();
  for (const rule of matrix.rules || []) {
    const enforcement = rule.enforcement;
    if (!enforcement || enforcement.status !== "ACTIVE" || enforcement.kind === "UNENFORCEABLE_BY_MACHINE") continue;
    const existing = refs.get(enforcement.ref) || {ref: enforcement.ref, kinds: new Set(), ruleIds: []};
    existing.kinds.add(enforcement.kind);
    existing.ruleIds.push(rule.ruleId);
    refs.set(enforcement.ref, existing);
  }
  return [...refs.values()].map((entry) => ({...entry, kinds: [...entry.kinds].sort(), ruleIds: entry.ruleIds.sort()})).sort((left, right) => left.ref.localeCompare(right.ref));
}

function readExecutionCatalog(root, catalogPath) {
  const absolute = path.join(root, catalogPath);
  if (!fs.existsSync(absolute)) fail(`ENFORCEMENT_CATALOG_MISSING:${catalogPath}`);
  try { return JSON.parse(fs.readFileSync(absolute, "utf8")); } catch { fail(`ENFORCEMENT_CATALOG_INVALID:${catalogPath}`); }
}

function expectedExecutionKind(entry) {
  if (entry.ref === "scripts/verify") return "VERIFY_ROOT";
  if (entry.kinds.includes("ARCHUNIT")) return "ARCHUNIT_SELECTOR";
  if (entry.kinds.includes("GATE")) return "VERIFY_CHILD";
  fail(`ENFORCEMENT_EXECUTION_KIND_UNRESOLVED:${entry.ref}`);
}

function dependencyDigests(root, entry) {
  const result = {};
  for (const dependency of entry.dependencies) result[dependency.path] = dependency.sha256;
  return result;
}

function validateExecutionCatalog({root, matrix, catalogPath = "contracts/policy/standards-enforcement-execution-catalog.json"}) {
  const catalog = readExecutionCatalog(root, catalogPath);
  if (catalog.schemaVersion !== 2 || catalog.kind !== "standards-enforcement-execution-catalog" || !Array.isArray(catalog.entries)) fail("ENFORCEMENT_CATALOG_INVALID");
  const expected = activeRefDenominator(matrix);
  const expectedByRef = new Map(expected.map((entry) => [entry.ref, entry]));
  const byRef = new Map();
  for (const entry of catalog.entries) {
    if (!entry || typeof entry.ref !== "string" || byRef.has(entry.ref)
      || !["VERIFY_ROOT", "VERIFY_CHILD", "ARCHUNIT_SELECTOR"].includes(entry.kind)
      || !Array.isArray(entry.dependencies) || entry.dependencies.length === 0) {
      fail(`ENFORCEMENT_CATALOG_ENTRY_INVALID:${entry?.ref || "UNSET"}`);
    }
    const expectedEntry = expectedByRef.get(entry.ref);
    if (!expectedEntry) fail("ENFORCEMENT_CATALOG_SET_MISMATCH");
    const expectedKind = expectedExecutionKind(expectedEntry);
    if (entry.kind !== expectedKind) fail(`ENFORCEMENT_CATALOG_KIND_MISMATCH:${entry.ref}`);
    const hasCommand = Object.prototype.hasOwnProperty.call(entry, "command");
    const hasMarkers = Object.prototype.hasOwnProperty.call(entry, "successMarkers");
    if (entry.kind === "VERIFY_ROOT") {
      if (hasCommand || hasMarkers) fail(`ENFORCEMENT_ROOT_COMMAND_FORBIDDEN:${entry.ref}`);
    } else if (!Array.isArray(entry.command) || entry.command.length === 0
      || entry.command.some((part) => typeof part !== "string" || part.length === 0)
      || !Array.isArray(entry.successMarkers) || entry.successMarkers.length === 0
      || entry.successMarkers.some((marker) => typeof marker !== "string" || marker.length === 0)) {
      fail(`ENFORCEMENT_CATALOG_ENTRY_INVALID:${entry.ref}`);
    }
    byRef.set(entry.ref, entry);
  }
  const expectedRefs = expected.map((entry) => entry.ref);
  const actualRefs = [...byRef.keys()];
  if (catalog.entries.length !== expectedRefs.length || byRef.size !== expectedRefs.length
    || expectedRefs.some((ref) => !byRef.has(ref)) || actualRefs.some((ref) => !expectedByRef.has(ref))) {
    fail("ENFORCEMENT_CATALOG_SET_MISMATCH");
  }
  for (const entry of byRef.values()) {
    const seen = new Set();
    for (const dependency of entry.dependencies) {
      if (!dependency || typeof dependency.path !== "string" || typeof dependency.sha256 !== "string" || seen.has(dependency.path)) fail(`ENFORCEMENT_DEPENDENCY_INVALID:${entry.ref}`);
      seen.add(dependency.path);
      const absolute = path.join(root, dependency.path);
      if (!fs.existsSync(absolute) || !fs.statSync(absolute).isFile() || sha256(fs.readFileSync(absolute)) !== dependency.sha256) fail(`ENFORCEMENT_DEPENDENCY_HASH_DRIFT:${entry.ref}:${dependency.path}`);
    }
  }
  return {entries: catalog.entries, expected};
}

function requestedEntries(entries, refs) {
  if (!Array.isArray(refs) || refs.length === 0) fail("ENFORCEMENT_REQUESTED_REF_SET_INVALID");
  const byRef = new Map(entries.map((entry) => [entry.ref, entry]));
  const selected = [];
  const seen = new Set();
  for (const ref of refs) {
    if (typeof ref !== "string" || ref.length === 0 || seen.has(ref)) fail("ENFORCEMENT_REQUESTED_REF_SET_INVALID");
    const entry = byRef.get(ref);
    if (!entry) fail(`ENFORCEMENT_REQUESTED_REF_UNKNOWN:${ref}`);
    if (entry.kind !== "VERIFY_CHILD") fail(`ENFORCEMENT_REQUESTED_REF_KIND_INVALID:${ref}`);
    seen.add(ref);
    selected.push(entry);
  }
  return selected;
}

function executeActive({root, matrix, catalogPath, refs}) {
  const {entries} = validateExecutionCatalog({root, matrix, catalogPath});
  const selected = refs === undefined
    ? entries.filter((entry) => entry.kind === "VERIFY_CHILD")
    : requestedEntries(entries, refs);
  for (const entry of selected) {
    const [command, ...args] = entry.command;
    const executable = command.includes("/") ? path.join(root, command) : command;
    const result = childProcess.spawnSync(executable, args, {cwd: root, encoding: "utf8", timeout: 120000});
    const output = `${result.stdout || ""}\n${result.stderr || ""}`;
    if (result.status !== 0) {
      process.stderr.write(output);
      fail(`ENFORCEMENT_EXIT_NONZERO:${entry.ref}`);
    }
    for (const marker of entry.successMarkers) if (!output.includes(marker)) fail(`ENFORCEMENT_MARKER_MISSING:${entry.ref}:${marker}`);
  }
  return selected.map((entry) => entry.ref);
}

function readReceipt(root, absolute, reason) {
  if (!fs.existsSync(absolute)) fail(reason);
  try { return JSON.parse(fs.readFileSync(absolute, "utf8")); } catch { fail(reason); }
}

function validateReceiptRecord({root, receipt, entry, expectedRootRunId, sequence}) {
  if (!receipt || receipt.schemaVersion !== 2 || receipt.rootRef !== "scripts/verify"
    || receipt.rootRunId !== expectedRootRunId || receipt.ref !== entry.ref
    || receipt.sequence !== sequence || receipt.exitStatus !== 0
    || typeof receipt.completedAt !== "string" || receipt.completedAt.length === 0
    || JSON.stringify(receipt.dependencyDigests) !== JSON.stringify(dependencyDigests(root, entry))) {
    fail(`ENFORCEMENT_RECEIPT_INVALID:${entry.ref}`);
  }
  const expectedMarkers = entry.successMarkers.map((marker) => ({marker, matched: true}));
  if (JSON.stringify(receipt.markerResults) !== JSON.stringify(expectedMarkers)) fail(`ENFORCEMENT_RECEIPT_MARKER_INVALID:${entry.ref}`);
}

function validateActiveReceipts({root, matrix, catalogPath, receiptPath, expectedRootRunId}) {
  if (typeof receiptPath !== "string" || receiptPath.length === 0 || typeof expectedRootRunId !== "string" || expectedRootRunId.length === 0) fail("ENFORCEMENT_RECEIPT_ARGUMENT_INVALID");
  const {entries} = validateExecutionCatalog({root, matrix, catalogPath});
  const rootEntry = entries.find((entry) => entry.kind === "VERIFY_ROOT");
  const selectorEntry = entries.find((entry) => entry.kind === "ARCHUNIT_SELECTOR");
  const childEntries = entries.filter((entry) => entry.kind === "VERIFY_CHILD");
  if (!rootEntry || !selectorEntry || childEntries.length !== 15) fail("ENFORCEMENT_KIND_PARTITION_INVALID");
  const canonicalRootPath = path.resolve(root, ".runtime/verification/test-health", expectedRootRunId, "root-receipt.json");
  const receivedRootPath = path.resolve(root, receiptPath);
  if (receivedRootPath !== canonicalRootPath) fail("ENFORCEMENT_RECEIPT_PATH_IDENTITY_MISMATCH");
  const rootReceipt = readReceipt(root, receivedRootPath, "ENFORCEMENT_ROOT_RECEIPT_MISSING");
  if (!rootReceipt || rootReceipt.schemaVersion !== 2 || rootReceipt.rootRef !== rootEntry.ref
    || rootReceipt.rootRunId !== expectedRootRunId || rootReceipt.ref !== rootEntry.ref
    || rootReceipt.exitStatus !== 0 || typeof rootReceipt.completedAt !== "string"
    || JSON.stringify(rootReceipt.dependencyDigests) !== JSON.stringify(dependencyDigests(root, rootEntry))
    || JSON.stringify(rootReceipt.markerResults) !== "[]" || !Array.isArray(rootReceipt.sequence)) {
    fail("ENFORCEMENT_ROOT_RECEIPT_INVALID");
  }
  const expectedChildRefs = childEntries.map((entry) => entry.ref);
  const actualChildRefs = rootReceipt.sequence.map((entry) => entry?.ref);
  if (rootReceipt.sequence.length !== childEntries.length
    || new Set(actualChildRefs).size !== actualChildRefs.length
    || JSON.stringify(actualChildRefs) !== JSON.stringify(expectedChildRefs)) {
    fail("ENFORCEMENT_CHILD_RECEIPT_SET_MISMATCH");
  }
  rootReceipt.sequence.forEach((receipt, index) => validateReceiptRecord({root, receipt, entry: childEntries[index], expectedRootRunId, sequence: index + 1}));
  const selectorReceipt = readReceipt(root, path.join(path.dirname(receivedRootPath), "selector-receipt.json"), "ENFORCEMENT_SELECTOR_RECEIPT_MISSING");
  validateReceiptRecord({root, receipt: selectorReceipt, entry: selectorEntry, expectedRootRunId, sequence: 1});
  return {successfulChildRefs: expectedChildRefs, selectorRef: selectorEntry.ref};
}
