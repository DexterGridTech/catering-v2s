function expectFailure(expectedReason, action) {
  assert.throws(action, (error) => error.message.includes(expectedReason));
}

function selfTest() {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "v2s-standards-coverage-"));
  try {
    const matrix = writeFixture(root);
    const matrixPath = "contracts/policy/standards-coverage-matrix.json";
    assert.equal(validateCoverage({ root, matrixPath, phase: "R2" }), true);

    const missingRule = structuredClone(matrix);
    missingRule.rules.pop();
    expectFailure("SOURCE_DENOMINATOR_MISMATCH", () =>
      validateCoverage({ root, matrix: missingRule, phase: "R2" }),
    );

    const missingMemory = structuredClone(matrix);
    missingMemory.rules[0].memoryRefs = [];
    expectFailure("MEMORY_REF_MISSING", () =>
      validateCoverage({ root, matrix: missingMemory, phase: "R2" }),
    );

    expectFailure("PLANNED_ENFORCEMENT_OVERDUE", () =>
      validateCoverage({ root, matrix, phase: "R4" }),
    );

    const missingGate = structuredClone(matrix);
    missingGate.rules[0].enforcement.ref = "scripts/check/missing-gate";
    expectFailure("ENFORCEMENT_REF_MISSING", () =>
      validateCoverage({ root, matrix: missingGate, phase: "R2" }),
    );

    const missingChecklist = structuredClone(matrix);
    delete missingChecklist.rules[1].enforcement.reviewChecklistRef;
    expectFailure("REVIEW_CHECKLIST_REF_MISSING", () =>
      validateCoverage({ root, matrix: missingChecklist, phase: "R2" }),
    );

    const gate = path.join(root, "scripts/check/existing-gate");
    fs.writeFileSync(gate, "#!/bin/sh\necho FIXTURE_GATE=PASS\n");
    fs.chmodSync(gate, 0o755);
    const catalog = {schemaVersion: 2, kind: "standards-enforcement-execution-catalog", entries: [{ref: "scripts/check/existing-gate", kind: "VERIFY_CHILD", command: ["scripts/check/existing-gate"], successMarkers: ["FIXTURE_GATE=PASS"], dependencies: [{path: "scripts/check/existing-gate", sha256: sha256(fs.readFileSync(gate))}]}]};
    const catalogPath = "contracts/policy/standards-enforcement-execution-catalog.json";
    fs.writeFileSync(path.join(root, catalogPath), `${JSON.stringify(catalog, null, 2)}\n`);
    assert.deepEqual(executeActive({root, matrix, catalogPath}), ["scripts/check/existing-gate"]);
    expectFailure("ENFORCEMENT_REQUESTED_REF_UNKNOWN:scripts/check/unknown-gate", () => executeActive({root, matrix, catalogPath, refs: ["scripts/check/unknown-gate"]}));
    fs.writeFileSync(gate, "#!/bin/sh\nexit 0\n");
    expectFailure("ENFORCEMENT_DEPENDENCY_HASH_DRIFT:scripts/check/existing-gate", () => executeActive({root, matrix, catalogPath}));
    catalog.entries[0].dependencies[0].sha256 = sha256(fs.readFileSync(gate));
    fs.writeFileSync(path.join(root, catalogPath), `${JSON.stringify(catalog, null, 2)}\n`);
    expectFailure("ENFORCEMENT_MARKER_MISSING:scripts/check/existing-gate:FIXTURE_GATE=PASS", () => executeActive({root, matrix, catalogPath}));
    fs.writeFileSync(gate, "#!/bin/sh\nexit 7\n");
    catalog.entries[0].dependencies[0].sha256 = sha256(fs.readFileSync(gate));
    fs.writeFileSync(path.join(root, catalogPath), `${JSON.stringify(catalog, null, 2)}\n`);
    expectFailure("ENFORCEMENT_EXIT_NONZERO:scripts/check/existing-gate", () => executeActive({root, matrix, catalogPath}));
  } finally {
    fs.rmSync(root, { recursive: true, force: true });
  }
}

function optionValue(name, fallback) {
  const index = process.argv.indexOf(name);
  if (index === -1) {
    return fallback;
  }
  if (!process.argv[index + 1]) {
    fail(`MISSING_OPTION_VALUE:${name}`);
  }
  return process.argv[index + 1];
}

function optionRefs(name) {
  const raw = optionValue(name, undefined);
  if (raw === undefined) return undefined;
  const refs = raw.split(",");
  if (refs.some((ref) => ref.length === 0)) fail("ENFORCEMENT_REQUESTED_REF_SET_INVALID");
  return refs;
}

const isMain = process.argv[1] && path.resolve(process.argv[1]) === path.resolve(fileURLToPath(import.meta.url));

if (isMain && process.argv.includes("--self-test")) {
  try {
    selfTest();
    console.log("STANDARDS_COVERAGE_SELF_TEST=PASS");
    console.log("MISSING_RULE_RED=PASS");
    console.log("MISSING_MEMORY_RED=PASS");
    console.log("PLANNED_OVERDUE_RED=PASS");
    console.log("MISSING_ENFORCEMENT_REF_RED=PASS");
    console.log("MISSING_REVIEW_CHECKLIST_RED=PASS");
    console.log("REFERENCED_EXIT_ZERO_RED=PASS");
    console.log("REFERENCED_EXIT_NONZERO_RED=PASS");
    console.log("ENFORCEMENT_DEPENDENCY_DRIFT_RED=PASS");
    console.log("REQUESTED_REF_UNKNOWN_RED=PASS");
  } catch (error) {
    console.error("STANDARDS_COVERAGE_SELF_TEST=FAIL");
    console.error(`REASON=${error.message}`);
    process.exit(1);
  }
} else if (isMain && process.argv.includes("--validate-active-receipts")) {
  try {
    const scriptDir = path.dirname(fileURLToPath(import.meta.url));
    const root = path.resolve(scriptDir, "../..");
    const matrixPath = optionValue("--matrix", "contracts/policy/standards-coverage-matrix.json");
    const phase = optionValue("--phase", "R5");
    const matrix = readMatrix(root, matrixPath);
    validateCoverage({root, matrixPath, matrix, phase});
    const result = validateActiveReceipts({
      root,
      matrix,
      catalogPath: optionValue("--execution-catalog", "contracts/policy/standards-enforcement-execution-catalog.json"),
      receiptPath: optionValue("--validate-active-receipts", undefined),
      expectedRootRunId: optionValue("--expected-root-run-id", undefined),
    });
    console.log("ACTIVE_RECEIPTS=PASS");
    console.log(`SUCCESSFUL_CHILD_REFS=${result.successfulChildRefs.join(",")}`);
    console.log(`ARCHUNIT_SELECTOR_REF=${result.selectorRef}`);
  } catch (error) {
    console.error("ACTIVE_RECEIPTS=FAIL");
    console.error(`REASON=${error.message}`);
    process.exit(1);
  }
} else if (isMain) {
  try {
    const scriptDir = path.dirname(fileURLToPath(import.meta.url));
    const root = path.resolve(scriptDir, "../..");
    const matrixPath = optionValue(
      "--matrix",
      "contracts/policy/standards-coverage-matrix.json",
    );
    const phase = optionValue("--phase", "R2");
    const matrix = readMatrix(root, matrixPath);
    validateCoverage({ root, matrixPath, matrix, phase });
    if (process.argv.includes("--execute-active")) {
      const executed = executeActive({root, matrix, catalogPath: optionValue("--execution-catalog", "contracts/policy/standards-enforcement-execution-catalog.json"), refs: optionRefs("--refs")});
      console.log("ENFORCEMENT_EXECUTION=PASS");
      console.log(`ENFORCEMENT_REFS=${executed.join(",")}`);
    }
    console.log("STANDARDS_COVERAGE=PASS");
    console.log(`PHASE=${matrix.phaseAliases?.[phase] || phase}`);
    if (matrix.phaseAliases?.[phase]) console.log(`PHASE_ALIAS=${phase}->${matrix.phaseAliases[phase]}`);
    console.log(`RULES=${matrix.rules.length}`);
  } catch (error) {
    console.error("STANDARDS_COVERAGE=FAIL");
    console.error(`REASON=${error.message}`);
    process.exit(1);
  }
}

