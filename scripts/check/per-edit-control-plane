#!/usr/bin/env node
import childProcess from "node:child_process";
import fs from "node:fs";
import path from "node:path";

const root = process.cwd();
const cli = path.join(root, "tools/compliance-control/cli.mjs");
const run = (name, args) => {
  const result = childProcess.spawnSync(process.execPath, [cli, ...args], { cwd: root, encoding: "utf8" });
  if (result.status !== 0) throw new Error(`PER_EDIT_CONTROL_PLANE_CHILD_FAIL:${name}:${(result.stderr || result.stdout || "").trim()}`);
  return result.stdout;
};
if (!fs.existsSync(cli)) throw new Error("PER_EDIT_CONTROL_PLANE_CLI_MISSING");
run("mandatory-gate", ["mandatory-per-edit-gate-self-test"]);
run("recovery", ["active-package-recovery-self-test"]);
run("bootstrap", ["per-edit-control-plane-self-test"]);
run("entry-ledger", ["per-edit-entry-ledger-self-test"]);
run("partition", ["archetype-profile-partition-self-test"]);
const disposition = JSON.parse(fs.readFileSync(path.join(root, "doc/evidence/platform/2026-08-12-v2s-per-edit-source-anchor-disposition.json"), "utf8"));
if (disposition.status !== "PASS" || !Array.isArray(disposition.entries) || disposition.entries.length !== 17) throw new Error("PER_EDIT_SOURCE_ANCHOR_DISPOSITION_DENOMINATOR_INVALID");
const validDispositions = new Set(["MIGRATE_DUAL_SOURCE", "MOVE_TO_BEHAVIOR_TEST", "RETAIN_SOURCE_DISCIPLINE"]);
const ids = new Set();
for (const entry of disposition.entries) {
  if (!entry.anchorId || ids.has(entry.anchorId) || !entry.gateFunction || !entry.sourcePath || !entry.sourceAnchor || !entry.protectedFact || !validDispositions.has(entry.disposition) || !entry.replacementOwner || !entry.redMutation || String(entry).includes("PENDING") || !fs.existsSync(path.join(root, entry.sourcePath))) throw new Error(`PER_EDIT_SOURCE_ANCHOR_DISPOSITION_INVALID:${entry.anchorId || "UNSET"}`);
  ids.add(entry.anchorId);
}
process.stdout.write("PER_EDIT_CONTROL_PLANE=PASS\nPER_EDIT_CONTROL_PLANE_CHILDREN=5\n");
