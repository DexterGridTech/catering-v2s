#!/usr/bin/env node

import crypto from "node:crypto";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import process from "node:process";
import { fileURLToPath } from "node:url";

const repoRoot = fs.realpathSync(path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../.."));
const requiredPath = path.join(repoRoot, "doc/heritage/required-inventory.json");
const registryPath = path.join(repoRoot, "doc/heritage/registry.json");
const ENTRY_KEYS = ["path", "expectedSha256", "owningAssertion"];

function assert(condition, code, details = "") {
  if (!condition) throw new Error(`${code}${details ? `: ${details}` : ""}`);
}

function sameKeys(value, keys) {
  return value && typeof value === "object" && !Array.isArray(value) &&
    JSON.stringify(Object.keys(value).sort()) === JSON.stringify([...keys].sort());
}

function repoInputPath(value, root = repoRoot) {
  assert(
    typeof value === "string" && value.length > 0 && !value.includes("\0") &&
      !path.isAbsolute(value) && !path.win32.isAbsolute(value),
    "HERITAGE_INPUT_PATH_INVALID",
    String(value),
  );
  const canonicalRoot = fs.realpathSync(root);
  const absolute = path.resolve(canonicalRoot, value);
  const relative = path.relative(canonicalRoot, absolute);
  assert(
    relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative),
    "HERITAGE_INPUT_PATH_OUTSIDE_ROOT",
    value,
  );

  let ancestor = canonicalRoot;
  for (const part of relative.split(path.sep).filter(Boolean)) {
    ancestor = path.join(ancestor, part);
    try {
      if (fs.lstatSync(ancestor).isSymbolicLink()) {
        assert(false, "HERITAGE_INPUT_PATH_OUTSIDE_ROOT", value);
      }
    } catch (error) {
      if (error?.code === "ENOENT") break;
      throw error;
    }
  }
  return absolute;
}

function readJson(filePath) {
  return JSON.parse(fs.readFileSync(filePath, "utf8"));
}

function sha256(filePath) {
  return crypto.createHash("sha256").update(fs.readFileSync(filePath)).digest("hex");
}

function clone(value) {
  return JSON.parse(JSON.stringify(value));
}

function validateInventory(required, root = repoRoot) {
  assert(
    sameKeys(required, ["schemaVersion", "kind", "entries"]),
    "HERITAGE_REQUIRED_SHAPE_INVALID",
  );
  assert(required.schemaVersion === 1, "HERITAGE_REQUIRED_VERSION_INVALID");
  assert(required.kind === "local-frozen-asset-inventory", "HERITAGE_REQUIRED_KIND_INVALID");
  assert(Array.isArray(required.entries), "HERITAGE_REQUIRED_ENTRIES_INVALID");
  assert(required.entries.length === 31, "HERITAGE_LOCAL_ASSET_COUNT_INVALID");

  const seenPaths = new Set();
  for (const entry of required.entries) {
    assert(sameKeys(entry, ENTRY_KEYS), "HERITAGE_ASSET_SHAPE_INVALID");
    assert(typeof entry.path === "string" && entry.path.length > 0, "HERITAGE_ASSET_PATH_INVALID");
    repoInputPath(entry.path, root);
    assert(!seenPaths.has(entry.path), "HERITAGE_ASSET_PATH_DUPLICATE", entry.path);
    assert(/^[a-f0-9]{64}$/.test(entry.expectedSha256), "HERITAGE_HASH_INVALID", entry.path);
    assert(typeof entry.owningAssertion === "string" && entry.owningAssertion.length > 0, "HERITAGE_ASSERTION_EMPTY");
    seenPaths.add(entry.path);
  }
}

function validateRegistry(required, registry, {verifyFiles = true, root = repoRoot} = {}) {
  validateInventory(required, root);
  assert(
    sameKeys(registry, ["schemaVersion", "kind", "status", "requiredInventory", "entries"]),
    "HERITAGE_REGISTRY_SHAPE_INVALID",
  );
  assert(registry.schemaVersion === 1, "HERITAGE_REGISTRY_VERSION_INVALID");
  assert(registry.kind === "local-frozen-asset-registry", "HERITAGE_REGISTRY_KIND_INVALID");
  assert(registry.status === "ACTIVE", "HERITAGE_REGISTRY_STATUS_INVALID");
  assert(registry.requiredInventory === "doc/heritage/required-inventory.json", "HERITAGE_REQUIRED_REF_INVALID");
  assert(JSON.stringify(registry.entries) === JSON.stringify(required.entries), "HERITAGE_REGISTRY_DENOMINATOR_MISMATCH");
  if (!verifyFiles) return;

  for (const entry of registry.entries) {
    const filePath = repoInputPath(entry.path, root);
    assert(fs.existsSync(filePath) && fs.statSync(filePath).isFile(), "HERITAGE_LOCAL_ASSET_MISSING", entry.path);
    assert(sha256(filePath) === entry.expectedSha256, "HERITAGE_LOCAL_HASH_MISMATCH", entry.path);
  }
}

function expectFail(name, required, registry, expectedCode, {verifyFiles = false, root = repoRoot} = {}) {
  try {
    validateRegistry(required, registry, {verifyFiles, root});
  } catch (error) {
    assert(error.message.startsWith(expectedCode), "HERITAGE_SELF_TEST_WRONG_FAILURE", `${name}: ${error.message}`);
    process.stdout.write(`FIXTURE=${name}; EXPECTED=FAIL; ACTUAL=FAIL; MARKER=${expectedCode}\n`);
    return;
  }
  throw new Error(`HERITAGE_SELF_TEST_FALSE_GREEN: ${name}`);
}

function selfTest(required, registry) {
  validateRegistry(required, registry);
  process.stdout.write("FIXTURE=repository-owned-frozen-assets; EXPECTED=PASS; ACTUAL=PASS; COUNT=31\n");

  const escapedRequired = clone(required);
  const escapedRegistry = clone(registry);
  escapedRequired.entries[0].path = "../outside-project/contracts/openapi/example.yaml";
  escapedRegistry.entries[0].path = "../outside-project/contracts/openapi/example.yaml";
  expectFail(
    "repository-root-escape-path",
    escapedRequired,
    escapedRegistry,
    "HERITAGE_INPUT_PATH_OUTSIDE_ROOT",
  );

  const outsideRoot = fs.mkdtempSync(path.join(os.tmpdir(), "v2s-heritage-outside-"));
  let testRoot;
  try {
    const absoluteRequired = clone(required);
    const absoluteRegistry = clone(registry);
    absoluteRequired.entries[0].path = path.join(outsideRoot, "external-asset.yaml");
    absoluteRegistry.entries[0].path = path.join(outsideRoot, "external-asset.yaml");
    expectFail(
      "absolute-external-path",
      absoluteRequired,
      absoluteRegistry,
      "HERITAGE_INPUT_PATH_INVALID",
    );

    testRoot = fs.mkdtempSync(path.join(os.tmpdir(), "v2s-heritage-root-"));
    fs.symlinkSync(outsideRoot, path.join(testRoot, "outside-project-link"), "dir");
    const symlinkRequired = clone(required);
    const symlinkRegistry = clone(registry);
    symlinkRequired.entries[0].path = "outside-project-link/external-asset.yaml";
    symlinkRegistry.entries[0].path = "outside-project-link/external-asset.yaml";
    expectFail(
      "symlink-mediated-escape",
      symlinkRequired,
      symlinkRegistry,
      "HERITAGE_INPUT_PATH_OUTSIDE_ROOT",
      {root: testRoot},
    );
  } finally {
    if (testRoot) fs.rmSync(testRoot, {recursive: true, force: true});
    fs.rmSync(outsideRoot, {recursive: true, force: true});
  }

  const hashDriftRequired = clone(required);
  const hashDriftRegistry = clone(registry);
  hashDriftRequired.entries[0].expectedSha256 = "0".repeat(64);
  hashDriftRegistry.entries[0].expectedSha256 = "0".repeat(64);
  expectFail(
    "local-asset-hash-drift",
    hashDriftRequired,
    hashDriftRegistry,
    "HERITAGE_LOCAL_HASH_MISMATCH",
    {verifyFiles: true},
  );
  process.stdout.write("HERITAGE_REGISTRY_SELF_TEST=PASS\n");
}

try {
  const required = readJson(requiredPath);
  const registry = readJson(registryPath);
  if (process.argv.includes("--self-test")) selfTest(required, registry);
  else validateRegistry(required, registry);
  process.stdout.write("HERITAGE_REGISTRY=PASS\n");
} catch (error) {
  process.stderr.write(`HERITAGE_REGISTRY=FAIL; ${error.message}\n`);
  process.exitCode = 1;
}
