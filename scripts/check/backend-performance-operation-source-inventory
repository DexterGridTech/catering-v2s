#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
argument="$1"
if [ "$argument" = "--self-test" ]; then
  exec node "$repo_root/scripts/generate/backend-performance-operation-source-inventory.mjs" --self-test
elif [ "$argument" = "--check" ] || [ -z "$argument" ]; then
  exec node "$repo_root/scripts/generate/backend-performance-operation-source-inventory.mjs" --check
else
  echo "BP_U01_SOURCE_INVENTORY_ARGUMENT_INVALID" >&2
  exit 1
fi

