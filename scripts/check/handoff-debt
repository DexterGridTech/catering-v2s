const APPROVED_IDS = new Set(APPROVED.map(({id}) => id));

function assert(condition, code, details = "") {
  if (!condition) throw new Error(`${code}${details ? `: ${details}` : ""}`);
}

function parseTable(markdown) {
  const lines = markdown.split(/\r?\n/);
  const headerIndexes = lines.flatMap((line, index) =>
    line.trim() === `| ${COLUMNS.join(" | ")} |` ? [index] : [],
  );
  const canonicalHeaderIndexes = headerIndexes.filter((index) => {
    for (const line of lines.slice(index + 2)) {
      if (!line.startsWith("|")) break;
      const firstSeparator = line.indexOf("|", 1);
      if (firstSeparator < 0) continue;
      if (APPROVED_IDS.has(line.slice(1, firstSeparator).trim())) return true;
    }
    return false;
  });
  assert(canonicalHeaderIndexes.length === 1, "HANDOFF_CANONICAL_TABLE_COUNT_INVALID");
  const [headerIndex] = canonicalHeaderIndexes;
  assert(/^\|(?:---\|){6}---\|$/.test(lines[headerIndex + 1].replaceAll(" ", "")), "HANDOFF_SEPARATOR_INVALID");
  const rows = [];
  for (const line of lines.slice(headerIndex + 2)) {
    if (!line.startsWith("|")) break;
    const cells = line.slice(1, -1).split("|").map((cell) => cell.trim());
    assert(cells.length === COLUMNS.length, "HANDOFF_COLUMN_COUNT_INVALID");
    const row = Object.fromEntries(COLUMNS.map((column, index) => [column, cells[index]]));
    try {
      row.decisionSource = JSON.parse(row.decisionSource);
    } catch {
      throw new Error(`HANDOFF_DECISION_SOURCE_JSON_INVALID: ${row.id}`);
    }
    rows.push(row);
  }
  return rows;
}

function validateDecisionSources(row, {verifySources = true} = {}) {
  assert(Array.isArray(row.decisionSource) && row.decisionSource.length > 0, "HANDOFF_DECISION_SOURCE_ARRAY_REQUIRED", row.id);
  for (const source of row.decisionSource) {
    assert(
      source && typeof source === "object" && !Array.isArray(source) &&
        JSON.stringify(Object.keys(source).sort()) === JSON.stringify(["anchor", "path"]),
      "HANDOFF_DECISION_SOURCE_SHAPE_INVALID",
      row.id,
    );
    assert(typeof source.path === "string" && !path.isAbsolute(source.path) && !source.path.includes(".."), "HANDOFF_DECISION_SOURCE_PATH_INVALID", row.id);
    assert(typeof source.anchor === "string" && /^#{1,6} /.test(source.anchor), "HANDOFF_DECISION_SOURCE_ANCHOR_INVALID", row.id);
    if (verifySources) {
      const sourcePath = path.resolve(repoRoot, source.path);
      assert(sourcePath.startsWith(`${repoRoot}${path.sep}`), "HANDOFF_DECISION_SOURCE_PATH_ESCAPE", row.id);
      assert(fs.existsSync(sourcePath), "HANDOFF_DECISION_SOURCE_PATH_MISSING", row.id);
      const sourceLines = fs.readFileSync(sourcePath, "utf8").split(/\r?\n/);
      assert(sourceLines.includes(source.anchor), "HANDOFF_DECISION_SOURCE_ANCHOR_MISSING", row.id);
    }
  }
}

function validateRows(rows, {verifySources = true, compareApproved = true} = {}) {
  assert(rows.length === 10, "HANDOFF_ROW_COUNT_INVALID");
  const ids = rows.map(({id}) => id);
  assert(new Set(ids).size === ids.length, "HANDOFF_ID_DUPLICATE");
  for (const row of rows) {
    assert(/^[A-Z][A-Z0-9_]*$/.test(row.activationTrigger), "HANDOFF_TRIGGER_GRAMMAR_INVALID", row.id);
    assert(!/(?:^|_)(?:AND|OR)(?:_|$)/.test(row.activationTrigger), "HANDOFF_TRIGGER_COMPOUND_FORBIDDEN", row.id);
    validateDecisionSources(row, {verifySources});
  }
  if (compareApproved) {
    assert(JSON.stringify(rows) === JSON.stringify(APPROVED), "HANDOFF_APPROVED_DENOMINATOR_MISMATCH");
  }
}

function clone(value) {
  return JSON.parse(JSON.stringify(value));
}

function expectFail(name, mutate, expectedCode, {verifySources = false} = {}) {
  const rows = clone(APPROVED);
  mutate(rows);
  try {
    validateRows(rows, {verifySources, compareApproved: true});
  } catch (error) {
    assert(error.message.startsWith(expectedCode), "HANDOFF_SELF_TEST_WRONG_FAILURE", `${name}: ${error.message}`);
    process.stdout.write(`FIXTURE=${name}; EXPECTED=FAIL; ACTUAL=FAIL; CODE=${expectedCode}\n`);
    return;
  }
  throw new Error(`HANDOFF_SELF_TEST_FALSE_GREEN: ${name}`);
}

function selfTest() {
  validateRows(clone(APPROVED), {verifySources: true, compareApproved: true});
  process.stdout.write("FIXTURE=ten-approved-rows; EXPECTED=PASS; ACTUAL=PASS\n");
  const renderTable = (rows) => [
    `| ${COLUMNS.join(" | ")} |`,
    `|${COLUMNS.map(() => "---").join("|")}|`,
    ...rows.map((row) => `| ${COLUMNS.map((column) =>
      column === "decisionSource" ? JSON.stringify(row[column]) : row[column],
    ).join(" | ")} |`),
  ].join("\n");
  const unrelatedSupplement = renderTable([{
    id: "TER_TOPOLOGY_PAIRING_TRUST",
    currentBoundary: "separate supplementary record",
    deferredReason: "separately maintained",
    risk: "not a canonical debt row",
    activationTrigger: "TOPOLOGY_AUTHENTICATION_AUTHORIZED",
    futureAcceptanceEvidence: "separate evidence",
    decisionSource: "free-text source reference",
  }]);
  const canonicalTable = renderTable(APPROVED);
  assert(
    JSON.stringify(parseTable(`${unrelatedSupplement}\n\n${canonicalTable}`)) === JSON.stringify(APPROVED),
    "HANDOFF_CANONICAL_TABLE_SELECTION_FAILED",
  );
  process.stdout.write("FIXTURE=preceding-supplementary-table; EXPECTED=PASS; ACTUAL=PASS\n");
  expectFail("vague-trigger", (rows) => { rows[0].activationTrigger = "WHEN_NEEDED"; }, "HANDOFF_APPROVED_DENOMINATOR_MISMATCH");
  expectFail("compound-trigger", (rows) => { rows[0].activationTrigger = "CI_PROVIDER_SELECTED_AND_ENABLED"; }, "HANDOFF_TRIGGER_COMPOUND_FORBIDDEN");
  expectFail("missing-threshold-trigger", (rows) => { rows[0].activationTrigger = "TEAM_GT_N"; }, "HANDOFF_APPROVED_DENOMINATOR_MISMATCH");
  expectFail("non-observable-trigger", (rows) => { rows[0].activationTrigger = "SCALE_GROWS"; }, "HANDOFF_APPROVED_DENOMINATOR_MISMATCH");
  expectFail("unknown-token", (rows) => { rows[0].activationTrigger = "UNKNOWN_FACT"; }, "HANDOFF_APPROVED_DENOMINATOR_MISMATCH");
  expectFail("alias-only-source", (rows) => { rows[0].decisionSource = ["manifest H.1"]; }, "HANDOFF_DECISION_SOURCE_SHAPE_INVALID");
  expectFail("missing-source-path", (rows) => { rows[0].decisionSource = [{"anchor": "### H.1 现在就做(仅三件 + 一个顺手项)"}]; }, "HANDOFF_DECISION_SOURCE_SHAPE_INVALID");
  expectFail("free-text-combined-source", (rows) => { rows[0].decisionSource = ["manifest H.1 + ADR 11"]; }, "HANDOFF_DECISION_SOURCE_SHAPE_INVALID");
  expectFail(
    "unresolved-anchor",
    (rows) => { rows[0].decisionSource[0].anchor = "### DOES NOT EXIST"; },
    "HANDOFF_DECISION_SOURCE_ANCHOR_MISSING",
    {verifySources: true},
  );
  process.stdout.write("HANDOFF_DEBT_SELF_TEST=PASS\n");
}

try {
  if (process.argv.includes("--self-test")) {
    selfTest();
  } else {
    const rows = parseTable(fs.readFileSync(handoffPath, "utf8"));
    validateRows(rows);
    process.stdout.write("HANDOFF_DEBT=PASS\n");
  }
} catch (error) {
  process.stderr.write(`HANDOFF_DEBT=FAIL; ${error.message}\n`);
  process.exitCode = 1;
}
