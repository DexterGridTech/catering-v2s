#!/usr/bin/env node
process.stdin.resume();
process.stdin.on("end", () => {
  process.stdout.write([
    "STATUS=PASS",
    "CONTEXT_MODE=DETERMINISTIC_ONLY",
    "ENTRY_1=AGENTS.md",
    "ENTRY_2=PLATFORM-BLUEPRINT.md",
    "ENTRY_3=project-memory/index.md",
    "ENTRY_4=scripts/README.md",
    ""
  ].join("\n"));
});
