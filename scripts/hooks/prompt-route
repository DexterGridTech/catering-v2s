#!/usr/bin/env node
let input = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => { input += chunk; });
process.stdin.on("end", () => {
  let rawPrompt = "";
  try {
    const parsed = JSON.parse(input || "{}");
    if (typeof parsed.prompt === "string") rawPrompt = parsed.prompt.trim();
  } catch {
    rawPrompt = "";
  }
  const prompt = rawPrompt.toLowerCase();
  // UserPromptSubmit is advisory only.  A prompt can be a decision, question, or implementation
  // direction; it is not evidence that a defect exists.  Problem-family discovery remains an
  // explicit engineering action when a concrete failure is actually identified.
  const routes = [
    { name: "cs-managed-runtime-execution", match: /\b(reset|seed|uat|l2|testcontainers|docker|tunnel|dev|start|restart|runtime|runner)\b|重置|清库|种子|启动|重启|运行环境|受管运行|隧道/ },
    { name: "cs-semantic-source-reconciliation", match: /\b(fixture|owner command|capability|terminal state|lifecycle|direct sql)\b|夹具|能力|权限|所有者命令|终态|生命周期|直连数据库/ },
    { name: "cs-failure-recall", match: /\b(fail|failure|error|exception|timeout|log|debug)\b|失败|报错|日志|排障/ },
    { name: "cs-memory-recall", match: /\b(memory|history|decision|heritage|roadmap)\b|记忆|历史|决策|路线图/ },
    { name: "cs-code-structure-recall", match: /\b(code|symbol|class|method|reference|where)\b|代码|符号|引用|在哪/ },
    { name: "cs-spec-to-plan", match: /\b(spec|plan|design|architecture|review|self-review|adversarial)\b|规格|计划|设计|架构|评审|审查|自审|对抗/ }
  ];
  const selected = prompt ? routes.find((route) => route.match.test(prompt)) : undefined;
  const lines = ["STATUS=PASS", `RECOMMENDED_SKILL=${selected?.name ?? "NONE"}`];
  if (selected) lines.push(`RECOMMENDED_SKILL_PATH=.agents/skills/${selected.name}/SKILL.md`);
  lines.push("CONTEXT_QUERY_PERFORMED=false", "");
  process.stdout.write(lines.join("\n"));
});
