{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/terminal-shared/**"]
    },
    "lint": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
