{
  "name": "catering-v2s-frontend-workspace",
  "private": true,
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/frontend/*",
    "libraries/frontend/*"
  ],
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.9.6"
  },
  "scripts": {
    "format:check": "prettier --check \"apps/frontend/**/*.{css,json,js,mjs,ts,tsx}\" \"libraries/frontend/**/*.{css,json,js,mjs,ts,tsx}\""
  }
}
