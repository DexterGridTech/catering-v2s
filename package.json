{
  "name": "catering-v2s-frontend-workspace",
  "private": true,
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/frontend/*",
    "libraries/frontend/*",
    "apps/terminal",
    "apps/terminal/kernel/base/*",
    "apps/terminal/kernel/feature/*",
    "apps/terminal/ui/base/*",
    "apps/terminal/ui/feature/*",
    "apps/terminal/ui/integration/*",
    "apps/terminal/adapter/android/*",
    "apps/terminal/assembly/base/*",
    "apps/terminal/assembly/android/*"
  ],
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "format:check": "prettier --check \"apps/frontend/**/*.{css,json,js,mjs,ts,tsx}\" \"libraries/frontend/**/*.{css,json,js,mjs,ts,tsx}\""
  }
}
